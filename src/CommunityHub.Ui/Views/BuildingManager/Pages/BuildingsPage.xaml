<Page x:Class="CommunityHub.Ui.Views.BuildingManager.Pages.BuildingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
      Title="Zgrade" Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Zaglavlje -->
        <Border Grid.Row="0" Background="White" Padding="16,14"
                BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="Zgrade" FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right"
                        Style="{StaticResource CircleButtonStyle}"
                        Width="32" Height="32" Click="HelpButton_Click">
                    <TextBlock Text="?" FontSize="14" FontWeight="SemiBold"/>
                </Button>
            </Grid>
        </Border>

        <!-- Sadrzaj: lista + FAB -->
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,12,16,80">

                    <!-- Prazan state -->
                    <TextBlock x:Name="EmptyText"
                               Text="Nemate registrovanih zgrada."
                               Foreground="#AAAAAA" FontSize="14"
                               HorizontalAlignment="Center"
                               Margin="0,40,0,0" Visibility="Collapsed"/>

                    <!-- Kartice zgrada -->
                    <ItemsControl x:Name="BuildingsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CardButtonStyle}"
                                        Margin="0,0,0,10"
                                        Tag="{Binding}"
                                        Click="BuildingCard_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Slika / fallback ikona -->
                                        <Grid Grid.Column="0" Width="72" Height="72"
                                              Margin="0,0,12,0">
                                            <Border Background="#F0F0F0" CornerRadius="8">
                                                <fa:IconBlock Icon="Building" FontSize="36"
                                                              Foreground="#CCCCCC"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                            </Border>
                                            <Border CornerRadius="8">
                                                <Border.Background>
                                                    <ImageBrush
                                                        ImageSource="{Binding FirstImagePath,
                                                            Converter={StaticResource ImagePathConverter}}"
                                                        Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                        </Grid>

                                        <!-- Tekst -->
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AddressDisplay}"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding Neighborhood}"
                                                       FontSize="13" Foreground="#888888"/>
                                            <TextBlock Text="{Binding City}"
                                                       FontSize="13" Foreground="#888888"/>
                                            <TextBlock FontSize="12" Foreground="#AAAAAA"
                                                       Margin="0,3,0,0">
                                                <Run Text="Broj spratova: "/>
                                                <Run Text="{Binding NumberOfFloors}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>

            <!-- Floating dugme za dodavanje zgrade -->
            <Button Style="{StaticResource FabButtonStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,20,20"
                    Click="AddBuilding_Click"
                    ToolTip="Registruj novu zgradu">
                <fa:IconBlock Icon="Plus" FontSize="22" Foreground="White"/>
            </Button>
        </Grid>

    </Grid>
</Page>
