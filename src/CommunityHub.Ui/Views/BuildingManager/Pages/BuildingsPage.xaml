<Page x:Class="CommunityHub.Ui.Views.BuildingManager.Pages.BuildingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
      Title="Zgrade" Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Zaglavlje -->
        <Border Grid.Row="0" Background="White" Padding="16,14"
                BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="Zgrade" FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right"
                        Style="{StaticResource CircleButtonStyle}"
                        Width="32" Height="32" Click="HelpButton_Click">
                    <TextBlock Text="?" FontSize="14" FontWeight="SemiBold"/>
                </Button>
            </Grid>
        </Border>

        <!-- Sadrzaj: lista + FAB -->
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,12,16,80">

                    <!-- Prazan state -->
                    <TextBlock x:Name="EmptyText"
                               Text="Nemate registrovanih zgrada."
                               Foreground="#AAAAAA" FontSize="14"
                               HorizontalAlignment="Center"
                               Margin="0,40,0,0" Visibility="Collapsed"/>

                    <!-- Kartice zgrada -->
                    <ItemsControl x:Name="BuildingsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CardButtonStyle}"
                                        Margin="0,0,0,10"
                                        Tag="{Binding}"
                                        Click="BuildingCard_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding AddressDisplay}"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Margin="0,0,0,4"/>
                                            <TextBlock FontSize="13" Foreground="#888888"
                                                       Margin="0,0,0,4">
                                                <Run Text="{Binding Neighborhood}"/>
                                                <Run Text=", "/>
                                                <Run Text="{Binding City}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="#AAAAAA">
                                                <Run Text="{Binding NumberOfFloors}"/>
                                                <Run Text=" spratova / "/>
                                                <Run Text="{Binding TotalApartments}"/>
                                                <Run Text=" stanova"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <fa:IconBlock Grid.Column="1"
                                                      Icon="AngleRight" FontSize="16"
                                                      Foreground="#CCCCCC"
                                                      VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>

            <!-- Floating dugme za dodavanje zgrade -->
            <Button Style="{StaticResource FabButtonStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,20,20"
                    Click="AddBuilding_Click"
                    ToolTip="Registruj novu zgradu">
                <fa:IconBlock Icon="Plus" FontSize="22" Foreground="White"/>
            </Button>
        </Grid>

    </Grid>
</Page>
