<Page x:Class="CommunityHub.Ui.Views.BuildingManager.Pages.GenerateReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
      Title="Generiši izveštaj" Background="#F5F5F5">

    <Page.Resources>
        <Style x:Key="GenerateBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Zaglavlje -->
        <Border Grid.Row="0" Background="White" Padding="12,12"
                BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
            <Grid>
                <Button HorizontalAlignment="Left"
                        Style="{StaticResource CircleButtonStyle}"
                        Width="32" Height="32" Click="BackButton_Click">
                    <fa:IconBlock Icon="ArrowLeft" FontSize="13"/>
                </Button>
                <TextBlock Text="Generiši izveštaj" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right"
                        Style="{StaticResource CircleButtonStyle}"
                        Width="32" Height="32" Click="HelpButton_Click">
                    <TextBlock Text="?" FontSize="14" FontWeight="SemiBold"/>
                </Button>
            </Grid>
        </Border>

        <!-- Forma -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,16,16,16">

                <!-- Info kartica -->
                <Border Background="White" BorderBrush="#DDDDDD" BorderThickness="1"
                        CornerRadius="10" Padding="16,14" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Generisanje izveštaja o svim zakazanim skupštinama sa spiskom prisustva za izabranu zgradu u određenom vremenskom periodu."
                                   FontSize="13" Foreground="#555555"
                                   TextWrapping="Wrap" LineHeight="20"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <fa:IconBlock Grid.Column="1" Icon="CircleInfo" FontSize="18"
                                      Foreground="#888888" VerticalAlignment="Top"/>
                    </Grid>
                </Border>

                <!-- Zgrada -->
                <TextBlock Text="Zgrada:" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="BuildingCombo"
                          ItemsSource="{Binding Buildings}"
                          SelectedItem="{Binding SelectedBuilding}"
                          DisplayMemberPath="AddressDisplay"
                          Padding="10,8" FontSize="13"
                          Margin="0,0,0,16"/>

                <!-- Početni datum -->
                <TextBlock Text="Početni datum:" Style="{StaticResource FieldLabel}"/>
                <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}"
                            FontSize="13"
                            Margin="0,0,0,16"/>

                <!-- Krajnji datum -->
                <TextBlock Text="Krajnji datum:" Style="{StaticResource FieldLabel}"/>
                <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}"
                            FontSize="13"
                            Margin="0,0,0,16"/>

                <!-- Greška -->
                <Border Background="#FFEBEE" CornerRadius="6" Padding="10,8" Margin="0,4,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828"
                               FontSize="13" TextWrapping="Wrap"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Generiši dugme na dnu -->
        <Border Grid.Row="2" Background="White" Padding="16,12"
                BorderBrush="#E8E8E8" BorderThickness="0,1,0,0">
            <Button Content="Generiši"
                    Style="{StaticResource GenerateBtnStyle}"
                    Click="Generate_Click"/>
        </Border>

    </Grid>
</Page>
