<Page x:Class="CommunityHub.Ui.Views.BuildingManager.Pages.AssembliesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
      Title="Skupštine" Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Zaglavlje -->
        <Border Grid.Row="0" Background="White" Padding="16,14"
                BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="Skupštine" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <!-- PDF dugme — vodi na stranicu za generisanje izveštaja -->
                    <Button Style="{StaticResource CircleButtonStyle}"
                            Width="32" Height="32" Margin="0,0,8,0"
                            Click="GenerateReport_Click">
                        <fa:IconBlock Icon="FilePdf" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource CircleButtonStyle}"
                            Width="32" Height="32" Click="HelpButton_Click">
                        <TextBlock Text="?" FontSize="14" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sadrzaj -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,16,16,80">

                <!-- Hero kartica — predstojeća skupština (klik vodi na detalje) -->
                <Button Visibility="{Binding HasNextAssembly, Converter={StaticResource BoolToVisibility}}"
                        Click="HeroCard_Click"
                        Background="White" BorderThickness="0" Padding="0"
                        Margin="0,0,0,20" Cursor="Hand"
                        HorizontalContentAlignment="Stretch">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="#1A1A1A" BorderThickness="1"
                                    CornerRadius="10" Padding="16,14">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel>
                        <TextBlock Text="Predstojeća skupština" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding NextBuildingLine}" FontSize="14"
                                   HorizontalAlignment="Center" Foreground="#555555" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding NextDateTimeLine}" FontSize="14"
                                   HorizontalAlignment="Center" Foreground="#555555"/>
                    </StackPanel>
                </Button>

                <!-- Lista skupstina -->
                <TextBlock Text="Skupštine:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <TextBlock Text="Nema zakazanih skupština."
                           Foreground="#AAAAAA" FontSize="14"
                           HorizontalAlignment="Center" Margin="0,20,0,0"
                           Visibility="{Binding HasNoAssemblies, Converter={StaticResource BoolToVisibility}}"/>

                <ItemsControl ItemsSource="{Binding Assemblies}"
                              Visibility="{Binding HasAssemblies, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Tag="{Binding}" Click="AssemblyCard_Click"
                                    Background="White" BorderThickness="0" Padding="0"
                                    Margin="0,0,0,10" Cursor="Hand"
                                    HorizontalContentAlignment="Stretch">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="#DDDDDD" BorderThickness="1"
                                                CornerRadius="8" Padding="14,12">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F5F5F5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel>
                                    <TextBlock Text="{Binding BuildingLine}"
                                               FontSize="14" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding DateTimeLine}"
                                               FontSize="13" Foreground="#555555" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding StatusLine}"
                                               FontSize="12" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#E65C00"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Confirmed">
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                        <Setter Property="Foreground" Value="#C62828"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding TopicCountLine}"
                                               FontSize="12" Foreground="#888888" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- FAB dugme za novu skupstinu -->
        <Button Grid.Row="1"
                Style="{StaticResource FabButtonStyle}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,16,16"
                Click="FabAdd_Click">
            <fa:IconBlock Icon="Plus" FontSize="22"/>
        </Button>

    </Grid>
</Page>
