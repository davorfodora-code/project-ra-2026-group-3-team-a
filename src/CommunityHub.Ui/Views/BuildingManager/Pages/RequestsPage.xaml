<Page x:Class="CommunityHub.Ui.Views.BuildingManager.Pages.RequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
      Title="Zahtevi" Background="#F5F5F5">

    <Page.Resources>
        <Style x:Key="SmallBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="ApproveStyle" TargetType="Button" BasedOn="{StaticResource SmallBtnStyle}">
            <Setter Property="BorderBrush" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
        </Style>
        <Style x:Key="RejectStyle" TargetType="Button" BasedOn="{StaticResource SmallBtnStyle}">
            <Setter Property="BorderBrush" Value="#C62828"/>
            <Setter Property="Foreground" Value="#C62828"/>
        </Style>
        <Style x:Key="TabBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Zaglavlje -->
        <Border Grid.Row="0" Background="White" Padding="16,14"
                BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="Zahtevi" FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right"
                        Style="{StaticResource CircleButtonStyle}"
                        Width="32" Height="32" Click="HelpButton_Click">
                    <TextBlock Text="?" FontSize="14" FontWeight="SemiBold"/>
                </Button>
            </Grid>
        </Border>

        <!-- Tab traka -->
        <Border Grid.Row="1" Background="White"
                BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnZaPristup" Style="{StaticResource TabBtnStyle}"
                        Content="Za pristup" Click="Tab_Click" Tag="0"/>
                <TextBlock Text="|" Foreground="#CCCCCC"
                           VerticalAlignment="Center" Margin="0,10"/>
                <Button x:Name="BtnZaIznajmljivanje" Style="{StaticResource TabBtnStyle}"
                        Content="Za iznajmljivanje" Click="Tab_Click" Tag="1"/>
            </StackPanel>
        </Border>

        <!-- Filter traka -->
        <Grid Grid.Row="2" Margin="16,10,16,6">
            <ComboBox x:Name="FilterCombo" Width="140" HorizontalAlignment="Left"
                      FontSize="13" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Svi" Tag="Svi" IsSelected="True"/>
                <ComboBoxItem Content="Ceka odobrenje" Tag="Pending"/>
                <ComboBoxItem Content="Prihvacen" Tag="Accepted"/>
                <ComboBoxItem Content="Odbijen" Tag="Rejected"/>
            </ComboBox>
            <Button HorizontalAlignment="Right" Background="Transparent"
                    BorderThickness="0" Cursor="Hand" Click="Sort_Click"
                    ToolTip="Promeni redosled">
                <TextBlock Text="&#x2191;&#x2193;" FontSize="18" Foreground="#555555"/>
            </Button>
        </Grid>

        <!-- Lista zahteva -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="RequestsPanel" Margin="16,4,16,16"/>
        </ScrollViewer>
    </Grid>
</Page>
