<Page x:Class="CommunityHub.Ui.Views.BuildingManager.Pages.RequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
      Title="Zahtevi" Background="#F5F5F5">

    <Page.Resources>
        <Style x:Key="SmallBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="ApproveStyle" TargetType="Button" BasedOn="{StaticResource SmallBtnStyle}">
            <Setter Property="BorderBrush" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
        </Style>
        <Style x:Key="RejectStyle" TargetType="Button" BasedOn="{StaticResource SmallBtnStyle}">
            <Setter Property="BorderBrush" Value="#C62828"/>
            <Setter Property="Foreground" Value="#C62828"/>
        </Style>
        <Style x:Key="TabBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status stil za zahteve za pristup -->
        <Style x:Key="StatusLineStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E65C00"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Accepted">
                    <Setter Property="Foreground" Value="#2E7D32"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Rejected">
                    <Setter Property="Foreground" Value="#C62828"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Status stil za zahteve za iznajmljivanje -->
        <Style x:Key="RentalStatusStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E65C00"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="ProposedCounter">
                    <Setter Property="Foreground" Value="#1565C0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Approved">
                    <Setter Property="Foreground" Value="#2E7D32"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Rejected">
                    <Setter Property="Foreground" Value="#C62828"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Zaglavlje -->
        <Border Grid.Row="0" Background="White" Padding="16,14"
                BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="Zahtevi" FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right"
                        Style="{StaticResource CircleButtonStyle}"
                        Width="32" Height="32" Click="HelpButton_Click">
                    <TextBlock Text="?" FontSize="14" FontWeight="SemiBold"/>
                </Button>
            </Grid>
        </Border>

        <!-- Tab traka -->
        <Border Grid.Row="1" Background="White"
                BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Za pristup" Click="Tab_Click" Tag="0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TabBtnStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAccessTabActive}" Value="True">
                                    <Setter Property="Foreground" Value="#1A1A1A"/>
                                    <Setter Property="BorderBrush" Value="#1A1A1A"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Grid.Column="1" Text="|" Foreground="#CCCCCC" VerticalAlignment="Center"/>

                <Button Grid.Column="2" Content="Za iznajmljivanje" Click="Tab_Click" Tag="1">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TabBtnStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRentalTabActive}" Value="True">
                                    <Setter Property="Foreground" Value="#1A1A1A"/>
                                    <Setter Property="BorderBrush" Value="#1A1A1A"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Filter traka — menja se po aktivnom tabu -->
        <Grid Grid.Row="2" Margin="16,10,16,6">

            <!-- Access filter bar -->
            <Grid Visibility="{Binding IsAccessTabActive, Converter={StaticResource BoolToVisibility}}">
                <ComboBox x:Name="FilterCombo" Width="140" HorizontalAlignment="Left"
                          FontSize="13" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Svi" Tag="Svi" IsSelected="True"/>
                    <ComboBoxItem Content="Ceka odobrenje" Tag="Pending"/>
                    <ComboBoxItem Content="Prihvacen" Tag="Accepted"/>
                    <ComboBoxItem Content="Odbijen" Tag="Rejected"/>
                </ComboBox>
                <Button HorizontalAlignment="Right" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" Click="Sort_Click"
                        ToolTip="Promeni redosled">
                    <TextBlock Text="&#x2191;&#x2193;" FontSize="18" Foreground="#555555"/>
                </Button>
            </Grid>

            <!-- Rental filter bar -->
            <Grid Visibility="{Binding IsRentalTabActive, Converter={StaticResource BoolToVisibility}}">
                <ComboBox x:Name="RentalFilterCombo" Width="160" HorizontalAlignment="Left"
                          FontSize="13" SelectionChanged="RentalFilter_Changed">
                    <ComboBoxItem Content="Svi" Tag="Svi" IsSelected="True"/>
                    <ComboBoxItem Content="Na cekanju" Tag="Pending"/>
                    <ComboBoxItem Content="Predlog poslat" Tag="ProposedCounter"/>
                    <ComboBoxItem Content="Odobreno" Tag="Approved"/>
                </ComboBox>
                <Button HorizontalAlignment="Right" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" Click="RentalSort_Click"
                        ToolTip="Promeni redosled">
                    <TextBlock Text="&#x2191;&#x2193;" FontSize="18" Foreground="#555555"/>
                </Button>
            </Grid>

        </Grid>

        <!-- Sadrzaj -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <Grid Margin="16,4,16,16">

                <!-- ===== Za pristup tab ===== -->
                <StackPanel Visibility="{Binding IsAccessTabActive, Converter={StaticResource BoolToVisibility}}">

                    <TextBlock Text="Nema zahteva za prikaz." FontSize="14"
                               Foreground="#AAAAAA"
                               HorizontalAlignment="Center" Margin="0,40,0,0"
                               Visibility="{Binding HasNoRequests, Converter={StaticResource BoolToVisibility}}"/>

                    <ItemsControl ItemsSource="{Binding FilteredRequests}"
                                  Visibility="{Binding HasRequests, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#DDDDDD"
                                        BorderThickness="1" CornerRadius="8"
                                        Margin="0,0,0,10" Padding="14,12">
                                    <StackPanel>
                                        <!-- Ime stanara -->
                                        <TextBlock Text="{Binding TenantFullName}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Margin="0,0,0,4"/>

                                        <!-- Lokacija + stan -->
                                        <TextBlock Text="{Binding LocationLine}"
                                                   FontSize="12" Foreground="#555555"
                                                   Margin="0,0,0,2" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ApartmentLine}"
                                                   FontSize="12" Foreground="#555555"
                                                   Margin="0,0,0,2"/>

                                        <!-- Datum + status + dugmad -->
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding DateLine}"
                                                           FontSize="12" Foreground="#555555"
                                                           Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding StatusLine}"
                                                           Style="{StaticResource StatusLineStyle}"/>
                                            </StackPanel>

                                            <!-- Dugmad Odobri/Odbij — samo ako je Pending i panel zatvoren -->
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Top"
                                                        Margin="8,0,0,0"
                                                        Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}">
                                                <Button Content="Odobri"
                                                        Style="{StaticResource ApproveStyle}"
                                                        Margin="0,0,0,4"
                                                        Click="Approve_Click"/>
                                                <Button Content="Odbij"
                                                        Click="RejectOpen_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource RejectStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRejectPanelOpen}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Panel za obrazlozenje (vidljiv kad IsRejectPanelOpen) -->
                                        <StackPanel Margin="0,8,0,0"
                                                    Visibility="{Binding IsRejectPanelOpen, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Obrazlozenje za odbijanje:"
                                                       FontSize="12" Foreground="#555555"
                                                       Margin="0,0,0,4"/>
                                            <TextBox Height="60" FontSize="12"
                                                     TextWrapping="Wrap" AcceptsReturn="True"
                                                     Padding="6"
                                                     Text="{Binding RejectReason, UpdateSourceTrigger=PropertyChanged}"/>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,6,0,0">
                                                <Button Content="Potvrdi"
                                                        Style="{StaticResource SmallBtnStyle}"
                                                        Margin="0,0,6,0"
                                                        Click="RejectConfirm_Click"/>
                                                <Button Content="Otkazi"
                                                        Style="{StaticResource SmallBtnStyle}"
                                                        Click="RejectCancel_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ===== Za iznajmljivanje tab ===== -->
                <StackPanel Visibility="{Binding IsRentalTabActive, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel DataContext="{Binding Rental}">

                    <TextBlock Text="Nema zahteva za prikaz." FontSize="14"
                               Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,40,0,0"
                               Visibility="{Binding HasNoRequests, Converter={StaticResource BoolToVisibility}}"/>

                    <ItemsControl ItemsSource="{Binding FilteredRequests}"
                                  Visibility="{Binding HasRequests, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#DDDDDD"
                                        BorderThickness="1" CornerRadius="8"
                                        Margin="0,0,0,10" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TenantFullName}"
                                                   FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding BuildingLine}"
                                                   FontSize="12" Foreground="#555555" Margin="0,0,0,2" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding RoomLine}"
                                                   FontSize="12" Foreground="#555555" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding DateLine}"
                                                   FontSize="12" Foreground="#555555" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding RentalTypeLine}"
                                                   FontSize="12" Foreground="#555555" Margin="0,0,0,2"/>

                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding StatusLine}"
                                                       Style="{StaticResource RentalStatusStyle}"
                                                       VerticalAlignment="Center"/>

                                            <Button Grid.Column="1" Content="Izaberi dan"
                                                    Style="{StaticResource SmallBtnStyle}"
                                                    Margin="8,0,0,0"
                                                    Click="ChooseDate_Click"
                                                    Visibility="{Binding CanPropose, Converter={StaticResource BoolToVisibility}}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                  </StackPanel>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
