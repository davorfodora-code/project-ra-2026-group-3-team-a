<Page x:Class="CommunityHub.Ui.Views.BuildingManager.Pages.RoomCalendarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
      Title="Kalendar prostorije" Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Zaglavlje -->
        <Border Grid.Row="0" Background="White" Padding="12,12"
                BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
            <Grid>
                <Button HorizontalAlignment="Left"
                        Style="{StaticResource CircleButtonStyle}"
                        Width="32" Height="32" Click="BackButton_Click">
                    <fa:IconBlock Icon="ArrowLeft" FontSize="13"/>
                </Button>
                <TextBlock Text="{Binding RoomName}" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right"
                        Style="{StaticResource CircleButtonStyle}"
                        Width="32" Height="32" Click="HelpButton_Click">
                    <TextBlock Text="?" FontSize="14" FontWeight="SemiBold"/>
                </Button>
            </Grid>
        </Border>

        <!-- Sadrzaj -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,16,16,24">

                <!-- Info-box o zahtevu -->
                <Border Background="White" BorderBrush="#DDDDDD"
                        BorderThickness="1" CornerRadius="8"
                        Padding="14,12" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="{Binding BuildingLine}" FontSize="13" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding TenantLine}"   FontSize="13" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding PeriodLine}"   FontSize="13" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding TypeLine}"     FontSize="13"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Izaberite slobodan datum:"
                           FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <!-- Kalendar — BlackoutDates se popunjavaju u code-behind-u -->
                <!-- SelectionMode=MultipleRange omogućava programsko označavanje celog perioda -->
                <!-- LayoutTransform skalira celu kontrolu jer Calendar ima fiksne interne dimenzije -->
                <Calendar x:Name="RoomCalendar"
                          HorizontalAlignment="Center"
                          SelectionMode="MultipleRange"
                          SelectedDatesChanged="RoomCalendar_SelectedDatesChanged">
                    <Calendar.LayoutTransform>
                        <ScaleTransform ScaleX="1.4" ScaleY="1.4"/>
                    </Calendar.LayoutTransform>
                </Calendar>

                <TextBlock Text="Zauzeti datumi su onemogućeni za odabir."
                           FontSize="12" Foreground="#888888"
                           Margin="0,10,0,20"/>

                <!-- Potvrdi dugme -->
                <Button HorizontalAlignment="Right"
                        Padding="20,10" FontSize="14" FontWeight="SemiBold"
                        Click="Confirm_Click"
                        IsEnabled="{Binding CanConfirm}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#1A1A1A"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#CCCCCC"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#333333"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    Potvrdi
                </Button>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
