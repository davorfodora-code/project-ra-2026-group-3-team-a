<Page x:Class="CommunityHub.Ui.Views.BuildingManager.Pages.BuildingDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
      Title="Detalji zgrade" Background="#F5F5F5">

    <Page.Resources>
        <!-- Tab dugme — neaktivno stanje, aktivno se setuje preko DataTrigger-a u-line ispod -->
        <Style x:Key="TabBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kartica za clana / prostoriju -->
        <Style x:Key="DetailCardStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Zaglavlje sa dugmetom nazad -->
        <Border Grid.Row="0" Background="White" Padding="12,12"
                BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
            <Grid>
                <Button HorizontalAlignment="Left"
                        Style="{StaticResource CircleButtonStyle}"
                        Width="32" Height="32" Click="BackButton_Click">
                    <fa:IconBlock Icon="ArrowLeft" FontSize="13"/>
                </Button>
                <TextBlock Text="Detalji zgrade" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Adresa zgrade -->
        <Border Grid.Row="1" Background="White" Padding="16,12,16,14"
                BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="{Binding AddressText}" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="{Binding LocationHeaderText}" FontSize="14"
                           Foreground="#888888" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Tab traka -->
        <Border Grid.Row="2" Background="White"
                BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Info" Click="Tab_Click" Tag="0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TabBtnStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInfoTabActive}" Value="True">
                                    <Setter Property="Foreground" Value="#1A1A1A"/>
                                    <Setter Property="BorderBrush" Value="#1A1A1A"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Grid.Column="1" Text="|" Foreground="#CCCCCC" VerticalAlignment="Center"/>

                <Button Grid.Column="2" Content="Clanovi" Click="Tab_Click" Tag="1">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TabBtnStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMembersTabActive}" Value="True">
                                    <Setter Property="Foreground" Value="#1A1A1A"/>
                                    <Setter Property="BorderBrush" Value="#1A1A1A"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Grid.Column="3" Text="|" Foreground="#CCCCCC" VerticalAlignment="Center"/>

                <Button Grid.Column="4" Content="Prostorije" Click="Tab_Click" Tag="2">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TabBtnStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRoomsTabActive}" Value="True">
                                    <Setter Property="Foreground" Value="#1A1A1A"/>
                                    <Setter Property="BorderBrush" Value="#1A1A1A"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Grid.Column="5" Text="|" Foreground="#CCCCCC" VerticalAlignment="Center"/>

                <Button Grid.Column="6" Content="Problemi" Click="Tab_Click" Tag="3">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TabBtnStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProblemsTabActive}" Value="True">
                                    <Setter Property="Foreground" Value="#1A1A1A"/>
                                    <Setter Property="BorderBrush" Value="#1A1A1A"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Sadrzaj tabova -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <Grid Margin="16,16,16,16">

                <!-- ===== Info tab ===== -->
                <StackPanel Visibility="{Binding IsInfoTabActive, Converter={StaticResource BoolToVisibility}}">

                    <TextBlock FontSize="14" Margin="0,0,0,6" TextWrapping="Wrap">
                        <Run Text="Adresa: " Foreground="#888888"/>
                        <Run Text="{Binding AddressText}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock FontSize="14" Margin="0,0,0,6" TextWrapping="Wrap">
                        <Run Text="Naselje: " Foreground="#888888"/>
                        <Run Text="{Binding Building.Neighborhood}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock FontSize="14" Margin="0,0,0,6" TextWrapping="Wrap">
                        <Run Text="Lokacija: " Foreground="#888888"/>
                        <Run Text="{Binding LocationFullText}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock FontSize="14" Margin="0,0,0,6" TextWrapping="Wrap">
                        <Run Text="Broj spratova: " Foreground="#888888"/>
                        <Run Text="{Binding NumberOfFloorsText}" FontWeight="SemiBold"/>
                    </TextBlock>

                    <!-- Stanovi po spratovima -->
                    <StackPanel Visibility="{Binding HasFloors, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Stanovi:" FontSize="14" FontWeight="SemiBold"
                                   Margin="0,10,0,6"/>
                        <ItemsControl ItemsSource="{Binding Building.Floors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="13" Margin="0,0,0,2" TextWrapping="Wrap">
                                        <Run Text="  - "/>
                                        <Run Text="{Binding Display, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Slike — karusel -->
                    <StackPanel Visibility="{Binding HasImages, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Slike:" FontSize="14" FontWeight="SemiBold"
                                   Margin="0,10,0,6"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Click="PrevImage_Click"
                                    Visibility="{Binding HasMultipleImages, Converter={StaticResource BoolToVisibility}}"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Padding="6,0">
                                <fa:IconBlock Icon="AngleLeft" FontSize="22" Foreground="#888888"/>
                            </Button>

                            <Border Grid.Column="1" Height="180" CornerRadius="8"
                                    Background="#EEEEEE" ClipToBounds="True">
                                <Grid>
                                    <fa:IconBlock Icon="Building" FontSize="60"
                                                  Foreground="#CCCCCC"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    <Image Stretch="UniformToFill"
                                           Source="{Binding CurrentImagePath, Converter={StaticResource ImagePathConverter}}"/>
                                </Grid>
                            </Border>

                            <Button Grid.Column="2" Click="NextImage_Click"
                                    Visibility="{Binding HasMultipleImages, Converter={StaticResource BoolToVisibility}}"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Padding="6,0">
                                <fa:IconBlock Icon="AngleRight" FontSize="22" Foreground="#888888"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                </StackPanel>

                <!-- ===== Clanovi tab ===== -->
                <StackPanel Visibility="{Binding IsMembersTabActive, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Nema registrovanih stanara." FontSize="14"
                               Foreground="#AAAAAA"
                               HorizontalAlignment="Center" Margin="0,40,0,0"
                               Visibility="{Binding HasNoMembers, Converter={StaticResource BoolToVisibility}}"/>
                    <ItemsControl ItemsSource="{Binding Members}"
                                  Visibility="{Binding HasMembers, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DetailCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TenantFullName}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding FloorApartmentDisplay}"
                                                   FontSize="13" Foreground="#555555"/>
                                        <TextBlock Text="{Binding JoinedDisplay}"
                                                   FontSize="13" Foreground="#555555"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ===== Prostorije tab ===== -->
                <StackPanel Visibility="{Binding IsRoomsTabActive, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Nema unetih zajednickih prostorija." FontSize="14"
                               Foreground="#AAAAAA"
                               HorizontalAlignment="Center" Margin="0,40,0,0"
                               Visibility="{Binding HasNoRooms, Converter={StaticResource BoolToVisibility}}"/>
                    <ItemsControl ItemsSource="{Binding Rooms}"
                                  Visibility="{Binding HasRooms, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DetailCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding FloorDisplay}"
                                                   FontSize="13" Foreground="#555555"
                                                   Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="12" Foreground="#888888"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="Vise-dnevno iznajmljivanje"
                                                   FontSize="12" Foreground="#1A73E8"
                                                   Margin="0,4,0,0"
                                                   Visibility="{Binding IsMultiDay, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ===== Problemi tab ===== -->
                <StackPanel Visibility="{Binding IsProblemsTabActive, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Lista problema dolazi uskoro." FontSize="14"
                               Foreground="#AAAAAA"
                               HorizontalAlignment="Center" Margin="0,40,0,0"/>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- FAB dugme za dodavanje prostorije (vidljivo samo na Prostorije tabu) -->
        <Button Grid.Row="3"
                Style="{StaticResource FabButtonStyle}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,16,16"
                Visibility="{Binding IsFabVisible, Converter={StaticResource BoolToVisibility}}"
                Click="FabAdd_Click">
            <fa:IconBlock Icon="Plus" FontSize="22"/>
        </Button>

    </Grid>
</Page>
