<Page x:Class="CommunityHub.Ui.Views.BuildingManager.Pages.AssemblyDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
      Title="Skupština" Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Zaglavlje -->
        <Border Grid.Row="0" Background="White" Padding="12,12"
                BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
            <Grid>
                <Button HorizontalAlignment="Left"
                        Style="{StaticResource CircleButtonStyle}"
                        Width="32" Height="32" Click="BackButton_Click">
                    <fa:IconBlock Icon="ArrowLeft" FontSize="13"/>
                </Button>
                <TextBlock Text="Skupština" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right"
                        Style="{StaticResource CircleButtonStyle}"
                        Width="32" Height="32" Click="HelpButton_Click">
                    <TextBlock Text="?" FontSize="14" FontWeight="SemiBold"/>
                </Button>
            </Grid>
        </Border>

        <!-- Sadrzaj -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,16,16,24">

                <!-- Osnovne informacije -->
                <TextBlock Text="{Binding BuildingLine}" FontSize="14" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding DateLine}"     FontSize="14" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding TimeLine}"     FontSize="14" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding StatusLine}"   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16"/>

                <!-- Teme -->
                <TextBlock Text="Teme:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Topics}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="• " FontSize="13"/>
                                <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap"/>
                                <TextBlock Text=" (dodatna)" FontSize="13" Foreground="#1A73E8"
                                           Visibility="{Binding IsAdditional, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Prisustvo po stanovima -->
                <TextBlock Text="Prisustvo po stanovima:" FontSize="14" FontWeight="SemiBold"
                           Margin="0,20,0,8"/>
                <TextBlock Text="Nema stanova u zgradi." FontSize="13" Foreground="#AAAAAA"
                           Visibility="{Binding HasNoAttendances, Converter={StaticResource BoolToVisibility}}"/>
                <ItemsControl ItemsSource="{Binding Attendances}"
                              Visibility="{Binding HasAttendances, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" FontSize="13" Margin="0,0,0,3">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#888888"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConfirmed}" Value="True">
                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
