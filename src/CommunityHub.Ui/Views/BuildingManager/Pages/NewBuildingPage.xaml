<Page x:Class="CommunityHub.Ui.Views.BuildingManager.Pages.NewBuildingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
      Title="Nova zgrada" Background="#F5F5F5">

    <Page.Resources>
        <Style x:Key="ChipRemoveStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#CC0000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubmitStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Zaglavlje -->
        <Border Grid.Row="0" Background="White" Padding="12,12"
                BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
            <Grid>
                <Button HorizontalAlignment="Left"
                        Style="{StaticResource CircleButtonStyle}"
                        Width="32" Height="32" Click="BackButton_Click">
                    <fa:IconBlock Icon="ArrowLeft" FontSize="13"/>
                </Button>
                <TextBlock Text="Nova zgrada" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Forma -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,16,16,24">

                <!-- Adresa -->
                <TextBlock Text="Adresa:" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,4"/>
                <Grid Margin="0,0,0,3">
                    <TextBox x:Name="AddressBox" FontSize="14" Padding="12,10"
                             Background="White" BorderBrush="#DDDDDD" BorderThickness="1"
                             Text="{Binding AddressInput, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="npr. Bulevar kralja Aleksandra 75"
                               Foreground="#999999" FontSize="14"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=AddressBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <TextBlock Text="(ulica + broj, npr. Jevrejska 22)"
                           FontSize="11" Foreground="#999999" Margin="2,0,0,12"/>

                <!-- Naselje -->
                <TextBlock Text="Naselje:" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,4"/>
                <TextBox FontSize="14" Padding="12,10"
                         Background="White" BorderBrush="#DDDDDD" BorderThickness="1"
                         Text="{Binding Neighborhood, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,3"/>
                <TextBlock Text="(deo grada, npr. Detelinara)"
                           FontSize="11" Foreground="#999999" Margin="2,0,0,12"/>

                <!-- Grad -->
                <TextBlock Text="Grad" FontSize="12" Foreground="#888888" Margin="2,0,0,4"/>
                <TextBox FontSize="14" Padding="12,10"
                         Background="White" BorderBrush="#DDDDDD" BorderThickness="1"
                         Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"/>

                <!-- Drzava -->
                <TextBlock Text="Drzava" FontSize="12" Foreground="#888888" Margin="2,0,0,4"/>
                <TextBox FontSize="14" Padding="12,10"
                         Background="White" BorderBrush="#DDDDDD" BorderThickness="1"
                         Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16"/>

                <!-- Broj spratova -->
                <TextBlock Text="Broj spratova" FontSize="12" Foreground="#888888" Margin="2,0,0,4"/>
                <TextBox FontSize="14" Padding="12,10"
                         Background="White" BorderBrush="#DDDDDD" BorderThickness="1"
                         Text="{Binding FloorsText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16"/>

                <!-- Dinamicki spratovi sa stanovima -->
                <ItemsControl ItemsSource="{Binding Floors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="{Binding Label}" FontSize="13"
                                           FontWeight="SemiBold" Foreground="#444444"
                                           Margin="0,0,0,6"/>

                                <!-- Cipovi stanova + inline input + "+ Stan" dugme, sve u jednom WrapPanel-u -->
                                <WrapPanel Margin="0,0,0,6">
                                    <ItemsControl ItemsSource="{Binding Apartments}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F0F0F0" CornerRadius="10"
                                                        Padding="10,4,6,4" Margin="0,0,6,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding}" FontSize="13"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,4,0"/>
                                                        <Button Content="×"
                                                                Style="{StaticResource ChipRemoveStyle}"
                                                                Click="RemoveApartment_Click"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Inline TextBox za unos broja stana -->
                                    <TextBox FontSize="13" Padding="6,2"
                                             Width="60" Height="28"
                                             BorderBrush="#CCCCCC" BorderThickness="1"
                                             VerticalContentAlignment="Center"
                                             Margin="0,0,6,6"
                                             Text="{Binding NewApartmentText, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsAddingApartment, Converter={StaticResource BoolToVisibility}}"
                                             KeyDown="ApartmentInput_KeyDown"
                                             LostFocus="ApartmentInput_LostFocus"
                                             Loaded="ApartmentInput_Loaded"/>

                                    <!-- Dugme + Stan -->
                                    <Button Click="AddApartment_Click" Margin="0,0,0,6"
                                            VerticalAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource AddChipStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAddingApartment}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <fa:IconBlock Icon="Plus" FontSize="11" Margin="0,0,4,0"/>
                                            <TextBlock Text="Stan"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Slike -->
                <TextBlock Text="Slike zgrade" FontSize="12" Foreground="#888888"
                           Margin="2,4,0,8"/>
                <ItemsControl ItemsSource="{Binding ImagePaths}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="70" Height="70" CornerRadius="8"
                                    Background="#EEEEEE" Margin="0,0,8,8" ClipToBounds="True">
                                <Grid>
                                    <Image Stretch="UniformToFill"
                                           Source="{Binding Converter={StaticResource ImagePathConverter}}"/>
                                    <Button Content="×" Width="20" Height="20"
                                            FontSize="12" Foreground="White"
                                            Background="#CC000000" BorderThickness="0"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Cursor="Hand"
                                            Click="RemoveImage_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource AddChipStyle}" HorizontalAlignment="Left"
                        Click="AddImages_Click">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Plus" FontSize="11" Margin="0,0,4,0"/>
                        <TextBlock Text="Dodaj slike"/>
                    </StackPanel>
                </Button>

                <!-- Greska -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#CC0000" FontSize="13"
                           TextWrapping="Wrap" Margin="0,12,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>

                <!-- Submit -->
                <Button Style="{StaticResource SubmitStyle}"
                        HorizontalAlignment="Stretch" Margin="0,16,0,0"
                        Click="Submit_Click">
                    Registruj zgradu
                </Button>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
