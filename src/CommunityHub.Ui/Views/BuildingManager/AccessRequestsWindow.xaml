<Window x:Class="CommunityHub.Ui.Views.BuildingManager.AccessRequestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zahtevi za pristup zgradi" Height="600" Width="950"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Naslov -->
        <TextBlock Grid.Row="0" Text="Zahtevi za pristup zgradi"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Filter i sortiranje -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Filter po statusu:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="StatusFilterComboBox" Width="180"
                      SelectionChanged="StatusFilterComboBox_SelectionChanged">
                <ComboBoxItem Content="Svi" IsSelected="True"/>
                <ComboBoxItem Content="Pending"/>
                <ComboBoxItem Content="Accepted"/>
                <ComboBoxItem Content="Rejected"/>
            </ComboBox>

            <TextBlock Text="Sortiranje:" VerticalAlignment="Center" Margin="20,0,8,0"/>
            <ComboBox x:Name="SortComboBox" Width="180"
                      SelectionChanged="SortComboBox_SelectionChanged">
                <ComboBoxItem Content="Najnoviji prvo" IsSelected="True"/>
                <ComboBoxItem Content="Najstariji prvo"/>
            </ComboBox>
        </StackPanel>

        <!-- Tabela zahteva -->
        <DataGrid Grid.Row="2" x:Name="RequestsDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F9F9F9"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Stanar" Binding="{Binding TenantFullName}" Width="150"/>
                <DataGridTextColumn Header="Adresa" Binding="{Binding BuildingAddress}" Width="160"/>
                <DataGridTextColumn Header="Naselje" Binding="{Binding Neighborhood}" Width="120"/>
                <DataGridTextColumn Header="Lokacija" Binding="{Binding Location}" Width="130"/>
                <DataGridTextColumn Header="Stan" Binding="{Binding ApartmentNumber}" Width="50"/>
                <DataGridTextColumn Header="Datum" Binding="{Binding CreatedAtFormatted}" Width="120"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
