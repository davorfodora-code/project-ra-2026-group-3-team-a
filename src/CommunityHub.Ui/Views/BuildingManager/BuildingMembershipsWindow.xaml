<Window x:Class="CommunityHub.Ui.Views.BuildingManager.BuildingMembershipsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Članstva u zgradama" Height="500" Width="750"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Naslov -->
        <TextBlock Grid.Row="0" Text="Članstva u zgradama"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Izbor zgrade -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Zgrada:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="BuildingComboBox" Width="350"
                      DisplayMemberPath="DisplayText"
                      SelectionChanged="BuildingComboBox_SelectionChanged"/>
        </StackPanel>

        <!-- Tabela članstava -->
        <DataGrid Grid.Row="2" x:Name="MembershipsDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F9F9F9"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Stanar" Binding="{Binding TenantFullName}" Width="200"/>
                <DataGridTextColumn Header="Sprat" Binding="{Binding FloorNumber}" Width="80"/>
                <DataGridTextColumn Header="Stan" Binding="{Binding ApartmentNumber}" Width="80"/>
                <DataGridTextColumn Header="Datum učlanjenja" Binding="{Binding JoinedAtFormatted}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
