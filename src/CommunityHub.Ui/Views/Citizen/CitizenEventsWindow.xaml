<Page x:Class="CommunityHub.Ui.Views.Citizen.CitizenEventsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource Win11WindowBackgroundBrush}">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CitizenTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Događaji kvarta"
                           Style="{StaticResource Win11HeadingTextStyle}"
                           FontSize="28"/>
                <TextBlock Text="Organizacija događaja, volontiranje i evidencija prisustva."
                           Foreground="{StaticResource Win11TextMutedBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="Ctrl+3 Događaji | Ctrl+N Novi događaj"
                       Foreground="{StaticResource Win11TextMutedBrush}"
                       VerticalAlignment="Bottom"/>
        </Grid>

        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Win11CardStyle}">
            <WrapPanel>
            <Button Content="Novi dogadjaj" Click="CreateEventButton_Click"
                    Style="{StaticResource Win11PrimaryButtonStyle}"
                    Padding="14,9" Margin="0,0,8,0"/>
            <Button Content="Prijava kao volonter" Click="VolunteerSignupButton_Click"
                    Style="{StaticResource Win11SecondaryButtonStyle}"
                    Padding="14,9" Margin="0,0,8,0"/>
            <Button Content="Evidencija prisustva" Click="AttendanceButton_Click"
                    Style="{StaticResource Win11SecondaryButtonStyle}"
                    Padding="14,9" Margin="0,0,8,0"/>
            <Button Content="Osvezi"
                    Click="RefreshButton_Click"
                    Style="{StaticResource Win11SecondaryButtonStyle}"
                    Padding="14,9"/>
            </WrapPanel>
        </Border>

        <DataGrid Grid.Row="4" Grid.Column="0" x:Name="EventsDataGrid"
                  Style="{StaticResource Win11DataGridStyle}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Naziv" Binding="{Binding Name}" Width="170"/>
                <DataGridTextColumn Header="Opis" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Datum" Binding="{Binding EventDateDisplay}" Width="110"/>
                <DataGridTextColumn Header="Pocetak" Binding="{Binding StartTimeDisplay}" Width="80"/>
                <DataGridTextColumn Header="Trajanje" Binding="{Binding DurationDisplay}" Width="90"/>
                <DataGridTextColumn Header="Min volontera" Binding="{Binding MinVolunteers}" Width="90"/>
                <DataGridTextColumn Header="Prijavljeno" Binding="{Binding CurrentVolunteers}" Width="80"/>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="95"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="0"
                Grid.RowSpan="5"
                Grid.Column="1"
                Margin="12,0,0,0"
                Style="{StaticResource Win11CardStyle}">
            <StackPanel>
                <TextBlock Text="Navigacija"
                           Style="{StaticResource Win11HeadingTextStyle}"
                           FontSize="18"
                           Margin="0,0,0,10"/>
                <TextBlock Text="OSNOVNO" Style="{StaticResource CitizenNavGroupTitleStyle}" Margin="0,0,0,6"/>
                <Button Content="🏠  Početna"
                        Style="{StaticResource CitizenNavButtonStyle}"
                        Click="HomeNavButton_Click"/>
                <Button Content="📍  Moj kvart"
                        Style="{StaticResource CitizenNavButtonStyle}"
                        Click="MyDistrictNavButton_Click"/>
                <TextBlock Text="AKTIVNOSTI U KVARTU" Style="{StaticResource CitizenNavGroupTitleStyle}"/>
                <Button Content="🗓  Događaji"
                        Style="{StaticResource CitizenNavButtonStyle}"
                        IsEnabled="False"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
