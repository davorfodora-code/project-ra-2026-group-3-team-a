<Window x:Class="CommunityHub.Ui.Views.Citizen.CitizenEventsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dogadjaji kvarta" Height="640" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="← Nazad" Click="BackButton_Click"
                    Padding="10,5" Margin="0,0,15,0" VerticalAlignment="Center"/>
            <TextBlock Text="Dogadjaji mog kvarta"
                       FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Novi dogadjaj" Click="CreateEventButton_Click"
                    Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="Prijava kao volonter" Click="VolunteerSignupButton_Click"
                    Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="Evidencija prisustva" Click="AttendanceButton_Click"
                    Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="Osvezi" Click="RefreshButton_Click" Padding="12,6"/>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="EventsDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  BorderBrush="#CCCCCC">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Naziv" Binding="{Binding Name}" Width="170"/>
                <DataGridTextColumn Header="Opis" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Datum" Binding="{Binding EventDateDisplay}" Width="110"/>
                <DataGridTextColumn Header="Pocetak" Binding="{Binding StartTimeDisplay}" Width="80"/>
                <DataGridTextColumn Header="Trajanje" Binding="{Binding DurationDisplay}" Width="90"/>
                <DataGridTextColumn Header="Min volontera" Binding="{Binding MinVolunteers}" Width="90"/>
                <DataGridTextColumn Header="Prijavljeno" Binding="{Binding CurrentVolunteers}" Width="80"/>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="95"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
