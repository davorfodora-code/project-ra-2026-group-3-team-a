<Window x:Class="CommunityHub.Ui.Views.Citizen.EventAttendanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Evidencija prisustva volontera" Height="500" Width="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Oznaci prisustvo za prijavljene volontere."
                   Foreground="Gray" Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1" x:Name="AttendanceDataGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Volonter" Binding="{Binding VolunteerName}" Width="*"/>
                <DataGridCheckBoxColumn Header="Prisustvovao" Binding="{Binding Attended}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Sacuvaj" Click="SaveButton_Click" Padding="14,8" Margin="0,0,8,0"/>
            <Button Content="Otkazi" Click="CancelButton_Click" Padding="14,8"/>
        </StackPanel>
    </Grid>
</Window>
