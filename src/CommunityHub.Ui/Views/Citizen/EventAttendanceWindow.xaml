<Window x:Class="CommunityHub.Ui.Views.Citizen.EventAttendanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Evidencija prisustva volontera"
        Height="540"
        Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Win11WindowBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CitizenTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Oznaci prisustvo za prijavljene volontere."
                   Foreground="{StaticResource Win11TextMutedBrush}"
                   Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1" x:Name="AttendanceDataGrid"
                  Style="{StaticResource Win11DataGridStyle}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Volonter" Binding="{Binding VolunteerName}" Width="*"/>
                <DataGridCheckBoxColumn Header="Prisustvovao" Binding="{Binding Attended}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Sačuvaj"
                    Click="SaveButton_Click"
                    Padding="15,9"
                    Margin="0,0,8,0"
                    Style="{StaticResource Win11PrimaryButtonStyle}"/>
            <Button Content="Otkaži"
                    Click="CancelButton_Click"
                    Padding="15,9"
                    Style="{StaticResource Win11SecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
