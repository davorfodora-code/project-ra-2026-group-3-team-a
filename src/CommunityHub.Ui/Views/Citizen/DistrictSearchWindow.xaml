<Window x:Class="CommunityHub.Ui.Views.Citizen.DistrictSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pretraga kvartova" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Naslov i nazad dugme -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="← Nazad"
                    Padding="10,5"
                    Margin="0,0,15,0"
                    VerticalAlignment="Center"
                    IsEnabled="False"/>
            <TextBlock Text="Pretraga kvartova"
                       FontSize="20"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Filteri za pretragu -->
        <Border Grid.Row="1"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="5"
                Padding="15"
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Naziv:" Margin="0,0,0,5"/>
                    <TextBox x:Name="NameTextBox" Padding="5"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Adresa:" Margin="0,0,0,5"/>
                    <TextBox x:Name="AddressTextBox" Padding="5"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Grad:" Margin="0,0,0,5"/>
                    <TextBox x:Name="CityTextBox" Padding="5"/>
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <TextBlock Text="Država:" Margin="0,0,0,5"/>
                    <TextBox x:Name="CountryTextBox" Padding="5"/>
                </StackPanel>

                <StackPanel Grid.Column="8" VerticalAlignment="Bottom">
                    <Button Content="Pretraži"
                            Padding="20,7"
                            FontSize="14"
                            IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Rezultati pretrage -->
        <DataGrid Grid.Row="2"
                  x:Name="DistrictsDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  BorderBrush="#CCCCCC">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Naziv" Binding="{Binding Name}" Width="180"/>
                <DataGridTextColumn Header="Opis" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Lokacija" Binding="{Binding LocationDisplay}" Width="150"/>
                <DataGridTextColumn Header="Ulice" Binding="{Binding StreetsDisplay}" Width="260"/>
                <DataGridTextColumn Header="Broj slika" Binding="{Binding ImageCount}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Slike selektovanog kvarta -->
        <Border Grid.Row="3"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="5"
                Padding="10"
                Margin="0,10,0,0"
                x:Name="ImagesBorder"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Slike kvarta:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ListBox x:Name="ImagesListBox"
                         Height="110"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding}"
                                   Height="100"
                                   Margin="5,0"
                                   Stretch="Uniform"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="NoImagesText"
                           Text="Nema slika za ovaj kvart."
                           Visibility="Collapsed"
                           Foreground="Gray"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

