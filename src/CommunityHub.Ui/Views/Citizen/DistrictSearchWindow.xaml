<Page x:Class="CommunityHub.Ui.Views.Citizen.DistrictSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource Win11WindowBackgroundBrush}">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CitizenTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="255"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="Nazad"
                    x:Name="BackButton"
                    Padding="14,8"
                    Style="{StaticResource Win11SecondaryButtonStyle}"
                    Click="BackButton_Click"/>
            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <TextBlock Text="Pretraga kvartova"
                           Style="{StaticResource Win11HeadingTextStyle}"
                           FontSize="28"/>
                <TextBlock Text="Pretražite kvartove po nazivu, adresi, gradu i državi."
                           Foreground="{StaticResource Win11TextMutedBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="2"
                       Text="Ctrl+2 | Enter Pretraži"
                       Foreground="{StaticResource Win11TextMutedBrush}"
                       VerticalAlignment="Bottom"/>
        </Grid>

        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Win11CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Naziv kvarta" Margin="0,0,0,5" Style="{StaticResource Win11HeadingTextStyle}"/>
                    <TextBox x:Name="NameTextBox" Style="{StaticResource Win11InputTextBoxStyle}" TextChanged="FilterTextBox_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Adresa" Margin="0,0,0,5" Style="{StaticResource Win11HeadingTextStyle}"/>
                    <TextBox x:Name="AddressTextBox" Style="{StaticResource Win11InputTextBoxStyle}" TextChanged="FilterTextBox_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Grad" Margin="0,0,0,5" Style="{StaticResource Win11HeadingTextStyle}"/>
                    <TextBox x:Name="CityTextBox" Style="{StaticResource Win11InputTextBoxStyle}" TextChanged="FilterTextBox_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <TextBlock Text="Država" Margin="0,0,0,5" Style="{StaticResource Win11HeadingTextStyle}"/>
                    <TextBox x:Name="CountryTextBox" Style="{StaticResource Win11InputTextBoxStyle}" TextChanged="FilterTextBox_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="8" VerticalAlignment="Bottom">
                    <Button Content="Pretraži"
                            x:Name="SearchButton"
                            Padding="20,9"
                            Style="{StaticResource Win11PrimaryButtonStyle}"
                            Click="SearchButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="4" Grid.Column="0"
                  x:Name="DistrictsDataGrid"
                  Style="{StaticResource Win11DataGridStyle}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  SelectionChanged="DistrictsDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Naziv" Binding="{Binding Name}" Width="180"/>
                <DataGridTextColumn Header="Opis" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Lokacija" Binding="{Binding LocationDisplay}" Width="150"/>
                <DataGridTextColumn Header="Ulice" Binding="{Binding StreetsDisplay}" Width="260"/>
                <DataGridTextColumn Header="Broj slika" Binding="{Binding ImageCount}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="4" Grid.Column="0"
                x:Name="AccessDistrictButton"
                Content="Zatraži pristup kvartu"
                Style="{StaticResource Win11PrimaryButtonStyle}"
                Click="AccessDistrictButton_Click"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,5,5"
                Padding="15,9"
                IsEnabled="False"/>

        <Border Grid.Row="6" Grid.Column="0"
                Style="{StaticResource Win11CardStyle}"
                x:Name="ImagesBorder"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Slike kvarta"
                           Style="{StaticResource Win11HeadingTextStyle}"
                           FontSize="16"
                           Margin="0,0,0,8"/>
                <ListBox x:Name="ImagesListBox"
                         Height="110"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding}"
                                   Height="100"
                                   Margin="5,0"
                                   Stretch="Uniform"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="NoImagesText"
                           Text="Nema slika za ovaj kvart."
                           Visibility="Collapsed"
                           Foreground="{StaticResource Win11TextMutedBrush}"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="0"
                Grid.RowSpan="7"
                Grid.Column="1"
                Margin="12,0,0,0"
                Style="{StaticResource Win11CardStyle}">
            <StackPanel>
                <TextBlock Text="Navigacija"
                           Style="{StaticResource Win11HeadingTextStyle}"
                           FontSize="18"
                           Margin="0,0,0,10"/>
                <Button Content="🏠  Početna"
                        Style="{StaticResource CitizenNavButtonStyle}"
                        Click="HomeNavButton_Click"/>
                <Button Content="🔎  Pretraga kvartova"
                        Style="{StaticResource CitizenNavButtonStyle}"
                        IsEnabled="False"/>
                <Button Content="📄  Moji zahtevi"
                        Style="{StaticResource CitizenNavButtonStyle}"
                        Click="RequestsNavButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>

