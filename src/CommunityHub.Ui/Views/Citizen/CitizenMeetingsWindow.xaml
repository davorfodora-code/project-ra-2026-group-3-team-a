<Window x:Class="CommunityHub.Ui.Views.Citizen.CitizenMeetingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sastanci" Height="720" Width="900"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="← Nazad" Padding="10,5" Margin="0,0,15,0" Click="BackButton_Click"/>
            <TextBlock Text="Glasanje za termin sastanka"
                       FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="Ovde vidite sve sastanke za svoj kvart. Za sastanke u pripremi možete označiti datum koji vam najviše odgovara."
                   TextWrapping="Wrap" Foreground="#555555" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <TextBlock x:Name="EmptyMeetingsTextBlock"
                      Text="Trenutno nema zakazanih sastanaka za vaš kvart."
                      Foreground="#777777" FontStyle="Italic" Margin="4"
                      Visibility="Collapsed"/>
            <ItemsControl x:Name="MeetingsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6"
                                Padding="14" Margin="0,0,0,12" Background="#FAFAFA">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TitleDisplay}"
                                               FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StatusDisplay}"
                                               FontWeight="SemiBold" Foreground="#2C3E50"/>
                                </Grid>

                                <TextBlock Text="{Binding TimeLine}" Margin="0,6,0,0" Foreground="#555555"/>
                                <TextBlock Margin="0,8,0,0">
                                    <Run Text="Tema: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding TopicDisplay}"/>
                                </TextBlock>

                                <StackPanel Margin="0,10,0,0"
                                            Visibility="{Binding ShowVotingSection, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Vaš trenutni glas:" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding MyVoteDisplay}" Margin="0,2,0,8" Foreground="#333333"/>

                                    <TextBlock Text="Odaberite termin:"
                                               Visibility="{Binding CanVote, Converter={StaticResource BoolToVisibility}}"
                                               Margin="0,0,0,6"/>

                                    <ComboBox ItemsSource="{Binding DateOptions}"
                                              SelectedItem="{Binding SelectedDate, Mode=TwoWay}"
                                              Width="160" HorizontalAlignment="Left"
                                              Visibility="{Binding CanVote, Converter={StaticResource BoolToVisibility}}"/>

                                    <Button Content="Sačuvaj glas"
                                            Tag="{Binding}"
                                            Click="SaveVoteButton_Click"
                                            Padding="12,6" Margin="0,10,0,0" HorizontalAlignment="Left"
                                            Visibility="{Binding CanVote, Converter={StaticResource BoolToVisibility}}"/>

                                    <TextBlock Text="Glasanje je zatvoreno (24h pre početka opsega)."
                                               Foreground="#A94442" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding ShowVotingClosedNote, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
