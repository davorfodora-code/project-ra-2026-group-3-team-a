<Page x:Class="CommunityHub.Ui.Views.Citizen.CitizenMeetingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource Win11WindowBackgroundBrush}">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CitizenTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </Page.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Text="Glasanje za termin sastanka"
                           FontSize="28"
                           Style="{StaticResource Win11HeadingTextStyle}"/>
                <TextBlock Text="Pregled i glasanje za termine sastanaka u pripremi."
                           Foreground="{StaticResource Win11TextMutedBrush}"
                           Margin="0,4,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="Ovde vidite sve sastanke za svoj kvart. Za sastanke u pripremi možete označiti datum koji vam najviše odgovara."
                   TextWrapping="Wrap"
                   Foreground="{StaticResource Win11TextMutedBrush}"/>

        <ScrollViewer Grid.Row="4" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <TextBlock x:Name="EmptyMeetingsTextBlock"
                      Text="Trenutno nema zakazanih sastanaka za vaš kvart."
                      Foreground="{StaticResource Win11TextMutedBrush}" FontStyle="Italic" Margin="4"
                      Visibility="Collapsed"/>
            <ItemsControl x:Name="MeetingsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Win11CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TitleDisplay}"
                                               FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StatusDisplay}"
                                               FontWeight="SemiBold" Foreground="#2C3E50"/>
                                </Grid>

                                <TextBlock Text="{Binding TimeLine}" Margin="0,6,0,0" Foreground="#555555"/>
                                <TextBlock Margin="0,8,0,0">
                                    <Run Text="Tema: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding TopicDisplay}"/>
                                </TextBlock>

                                <StackPanel Margin="0,10,0,0"
                                            Visibility="{Binding ShowVotingSection, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Vaš trenutni glas:" Style="{StaticResource Win11HeadingTextStyle}"/>
                                    <TextBlock Text="{Binding MyVoteDisplay}" Margin="0,2,0,8" Foreground="#333333"/>

                                    <TextBlock Text="Odaberite termin:"
                                               Visibility="{Binding CanVote, Converter={StaticResource BoolToVisibility}}"
                                               Margin="0,0,0,6"/>

                                    <ComboBox ItemsSource="{Binding DateOptions}"
                                              SelectedItem="{Binding SelectedDate, Mode=TwoWay}"
                                              Width="160" HorizontalAlignment="Left"
                                              Style="{StaticResource Win11InputComboBoxStyle}"
                                              Visibility="{Binding CanVote, Converter={StaticResource BoolToVisibility}}"/>

                                    <Button Content="Sačuvaj glas"
                                            Tag="{Binding}"
                                            Click="SaveVoteButton_Click"
                                            Padding="14,8" Margin="0,10,0,0" HorizontalAlignment="Left"
                                            Style="{StaticResource Win11PrimaryButtonStyle}"
                                            Visibility="{Binding CanVote, Converter={StaticResource BoolToVisibility}}"/>

                                    <TextBlock Text="Glasanje je zatvoreno (24h pre početka opsega)."
                                               Foreground="#A94442" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding ShowVotingClosedNote, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="0"
                Grid.RowSpan="5"
                Grid.Column="1"
                Margin="12,0,0,0"
                Style="{StaticResource Win11CardStyle}">
            <StackPanel>
                <TextBlock Text="Navigacija"
                           Style="{StaticResource Win11HeadingTextStyle}"
                           FontSize="18"
                           Margin="0,0,0,10"/>
                <TextBlock Text="OSNOVNO" Style="{StaticResource CitizenNavGroupTitleStyle}" Margin="0,0,0,6"/>
                <Button Content="🏠  Početna"
                        Style="{StaticResource CitizenNavButtonStyle}"
                        Click="HomeNavButton_Click"/>
                <Button Content="📍  Moj kvart"
                        Style="{StaticResource CitizenNavButtonStyle}"
                        Click="MyDistrictNavButton_Click"/>
                <TextBlock Text="AKTIVNOSTI U KVARTU" Style="{StaticResource CitizenNavGroupTitleStyle}"/>
                <Button Content="🗓  Događaji"
                        Style="{StaticResource CitizenNavButtonStyle}"
                        Click="EventsNavButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
