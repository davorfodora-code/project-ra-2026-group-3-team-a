<Page x:Class="CommunityHub.Ui.Views.Citizen.CitizenCityFacilitiesWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource Win11WindowBackgroundBrush}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CitizenTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Gradski objekti"
                               Style="{StaticResource CitizenPageTitleStyle}"/>

                    <TextBlock Text="Pregledajte objekte u svom kvartu, glasajte za posetu i pratite statistiku obilazaka."
                               Style="{StaticResource CitizenPageSubtitleStyle}"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="Ctrl+6 Gradski objekti"
                           Foreground="{StaticResource Win11TextMutedBrush}"
                           VerticalAlignment="Bottom"/>
            </Grid>

        <Border Style="{StaticResource Win11CardStyle}" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Objekti u mom kvartu"
                               Style="{StaticResource CitizenSectionTitleStyle}"/>

                    <WrapPanel Grid.Column="1">
                        <Button Content="Glasaj za izabrani objekat"
                                Style="{StaticResource Win11PrimaryButtonStyle}"
                                Padding="14,9"
                                Margin="0,0,8,0"
                                Click="VoteButton_Click"/>

                        <Button Content="Osveži"
                                Style="{StaticResource Win11SecondaryButtonStyle}"
                                Padding="14,9"
                                Click="RefreshButton_Click"/>
                    </WrapPanel>
                </Grid>

                <DataGrid x:Name="FacilitiesDataGrid"
                          Grid.Row="2"
                          Style="{StaticResource Win11DataGridStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionChanged="FacilitiesDataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Naziv" Binding="{Binding Name}" Width="180"/>
                        <DataGridTextColumn Header="Adresa" Binding="{Binding Address}" Width="220"/>
                        <DataGridTextColumn Header="Opis" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Glasovi" Binding="{Binding VoteCount}" Width="80"/>
                        <DataGridCheckBoxColumn Header="Moj glas" Binding="{Binding HasMyVote}" Width="80"/>
                        <DataGridTextColumn Header="Poslednji obilazak" Binding="{Binding LastReservationDisplay}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Win11CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                        <TextBlock Text="Statistika rezervacija"
                                   Style="{StaticResource CitizenSectionTitleStyle}"/>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                            <TextBlock Text="Godina:"
                                       Foreground="{StaticResource Win11TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBox x:Name="YearTextBox"
                                     Width="82"
                                     Style="{StaticResource Win11InputTextBoxStyle}"
                                     Margin="0,0,14,0"/>

                            <TextBlock Text="Mesec:"
                                       Foreground="{StaticResource Win11TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <ComboBox x:Name="MonthComboBox"
                                      Width="150"
                                      Style="{StaticResource Win11InputComboBoxStyle}"
                                      Margin="0,0,10,0">
                                <ComboBoxItem Content="Cela godina" Tag=""/>
                                <ComboBoxItem Content="Januar" Tag="1"/>
                                <ComboBoxItem Content="Februar" Tag="2"/>
                                <ComboBoxItem Content="Mart" Tag="3"/>
                                <ComboBoxItem Content="April" Tag="4"/>
                                <ComboBoxItem Content="Maj" Tag="5"/>
                                <ComboBoxItem Content="Jun" Tag="6"/>
                                <ComboBoxItem Content="Jul" Tag="7"/>
                                <ComboBoxItem Content="Avgust" Tag="8"/>
                                <ComboBoxItem Content="Septembar" Tag="9"/>
                                <ComboBoxItem Content="Oktobar" Tag="10"/>
                                <ComboBoxItem Content="Novembar" Tag="11"/>
                                <ComboBoxItem Content="Decembar" Tag="12"/>
                            </ComboBox>

                            <Button Content="Prikaži"
                                    Style="{StaticResource Win11PrimaryButtonStyle}"
                                    Padding="14,9"
                                    Click="StatisticsButton_Click"/>
                        </WrapPanel>

                        <Border Grid.Row="2"
                                Background="{StaticResource Win11AccentSoftBrush}"
                                CornerRadius="10"
                                Padding="12,8"
                                Margin="0,0,0,10">
                            <TextBlock x:Name="TotalReservationsTextBlock"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Win11TextPrimaryBrush}"/>
                        </Border>

                        <DataGrid x:Name="StatisticsDataGrid"
                                  Grid.Row="3"
                                  Style="{StaticResource Win11DataGridStyle}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Objekat" Binding="{Binding FacilityName}" Width="*"/>
                                <DataGridTextColumn Header="Broj poseta" Binding="{Binding VisitCount}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Win11CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Istorija izabranog objekta"
                               Style="{StaticResource CitizenSectionTitleStyle}"/>

                    <TextBlock x:Name="SelectedFacilityTextBlock"
                               Grid.Row="1"
                               Text="Izaberite objekat iz tabele da biste videli istoriju obilazaka."
                               Foreground="{StaticResource Win11TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>

                    <DataGrid x:Name="HistoryDataGrid"
                              Grid.Row="2"
                              Style="{StaticResource Win11DataGridStyle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Termin" Binding="{Binding ReservedAtDisplay}" Width="150"/>
                            <DataGridTextColumn Header="Opis" Binding="{Binding Note}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>