<Window x:Class="CommunityHub.Ui.Views.Citizen.CreateDistrictEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novi događaj"
        Height="600"
        Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Win11WindowBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CitizenTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="Organizuj novi događaj"
                   Style="{StaticResource Win11HeadingTextStyle}"
                   FontSize="26"
                   Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Naziv:" VerticalAlignment="Center" Margin="0,8" Style="{StaticResource Win11HeadingTextStyle}"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="NameTextBox" Margin="0,8" Style="{StaticResource Win11InputTextBoxStyle}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Opis:" VerticalAlignment="Top" Margin="0,8" Style="{StaticResource Win11HeadingTextStyle}"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="DescriptionTextBox"
                 Height="70" Margin="0,8" TextWrapping="Wrap" AcceptsReturn="True" Style="{StaticResource Win11InputTextBoxStyle}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Datum:" VerticalAlignment="Center" Margin="0,8" Style="{StaticResource Win11HeadingTextStyle}"/>
        <DatePicker Grid.Row="3" Grid.Column="1" x:Name="EventDatePicker" Margin="0,8"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Vreme početka (HH:mm):" VerticalAlignment="Center" Margin="0,8" Style="{StaticResource Win11HeadingTextStyle}"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="StartTimeTextBox" Margin="0,8" Text="09:00" Style="{StaticResource Win11InputTextBoxStyle}"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Trajanje (min):" VerticalAlignment="Center" Margin="0,8" Style="{StaticResource Win11HeadingTextStyle}"/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="DurationTextBox" Margin="0,8" Text="120" Style="{StaticResource Win11InputTextBoxStyle}"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Min volontera:" VerticalAlignment="Center" Margin="0,8" Style="{StaticResource Win11HeadingTextStyle}"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="MinVolunteersTextBox" Margin="0,8" Text="2" Style="{StaticResource Win11InputTextBoxStyle}"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Potrebne stvari:" VerticalAlignment="Top" Margin="0,8" Style="{StaticResource Win11HeadingTextStyle}"/>
        <TextBlock Grid.Row="7" Grid.Column="1" Text="Unesite po jednu stvar u svaki red."
                   Foreground="{StaticResource Win11TextMutedBrush}" Margin="0,8"/>

        <TextBox Grid.Row="8" Grid.Column="1" x:Name="RequiredItemsTextBox"
                 Margin="0,8" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 Style="{StaticResource Win11InputTextBoxStyle}"/>

        <TextBlock Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" x:Name="ErrorTextBlock"
                   Foreground="Red" Margin="0,6,0,10" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Sačuvaj"
                    Click="SaveButton_Click"
                    Padding="15,9"
                    Margin="0,0,8,0"
                    Style="{StaticResource Win11PrimaryButtonStyle}"/>
            <Button Content="Otkaži"
                    Click="CancelButton_Click"
                    Padding="15,9"
                    Style="{StaticResource Win11SecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
