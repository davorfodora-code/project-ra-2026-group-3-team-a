<Page x:Class="CommunityHub.Ui.Views.Citizen.MyDistrictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource Win11WindowBackgroundBrush}">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CitizenTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Row="0"
                      Grid.RowSpan="7"
                      Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <StackPanel Margin="0,0,0,12">
                    <TextBlock x:Name="DistrictNameTextBlock"
                               Style="{StaticResource CitizenPageTitleStyle}"/>
                    <TextBlock x:Name="DistrictDescriptionTextBlock"
                               Style="{StaticResource CitizenPageSubtitleStyle}"/>
                </StackPanel>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Win11CardStyle}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Osnovne informacije"
                                       Style="{StaticResource CitizenSectionTitleStyle}"/>
                            <TextBlock Text="Lokacija:"
                                       Style="{StaticResource Win11HeadingTextStyle}"/>
                            <TextBlock x:Name="DistrictLocationTextBlock" Margin="0,0,0,8"/>
                            <TextBlock Text="Datum vašeg učlanjenja:"
                                       Style="{StaticResource Win11HeadingTextStyle}"/>
                            <TextBlock x:Name="MyJoinDateTextBlock"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Win11CardStyle}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Ulice i opsezi brojeva"
                                       Style="{StaticResource CitizenSectionTitleStyle}"
                                       Margin="0,0,0,8"/>
                            <ListBox x:Name="StreetsListBox" Height="110"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Win11CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Slike kvarta"
                                   Style="{StaticResource CitizenSectionTitleStyle}"
                                   Margin="0,0,0,8"/>
                        <ListBox x:Name="DistrictImagesListBox"
                                 Height="132"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="200"
                                            Height="120"
                                            Background="#EEF4FC"
                                            BorderBrush="{StaticResource Win11CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            ClipToBounds="True">
                                        <Image Source="{Binding Converter={StaticResource ImagePathConverter}}"
                                               MaxWidth="196"
                                               MaxHeight="116"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="NoDistrictImagesTextBlock"
                                   Text="Nema dostupnih slika."
                                   Foreground="{StaticResource Win11TextMutedBrush}"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Win11CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Evidencija poverenja građana u kvartu"
                                   Style="{StaticResource CitizenSectionTitleStyle}"
                                   Margin="0,0,0,8"/>
                        <DataGrid x:Name="TrustRecordsDataGrid"
                                  Style="{StaticResource Win11DataGridStyle}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Građanin" Binding="{Binding CitizenFullName}" Width="2*"/>
                                <DataGridTextColumn Header="Datum učlanjenja" Binding="{Binding JoinDate}" Width="*"/>
                                <DataGridTextColumn Header="Organizovani događaji" Binding="{Binding OrganizedCompletedEventsCount}" Width="*"/>
                                <DataGridTextColumn Header="Potvrđena volontiranja" Binding="{Binding ConfirmedVolunteerEventsCount}" Width="*"/>
                                <DataGridTextColumn Header="Nivo" Binding="{Binding TrustLevel}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="0"
                Grid.RowSpan="7"
                Grid.Column="1"
                Margin="12,0,0,0"
                Style="{StaticResource Win11CardStyle}">
            <StackPanel>
                <TextBlock Text="Navigacija"
                           Style="{StaticResource Win11HeadingTextStyle}"
                           FontSize="18"
                           Margin="0,0,0,10"/>
                <TextBlock Text="OSNOVNO" Style="{StaticResource CitizenNavGroupTitleStyle}" Margin="0,0,0,6"/>
                <Button Content="🏠  Početna"
                        Style="{StaticResource CitizenNavButtonStyle}"
                        Click="HomeNavButton_Click"/>
                <Button Content="📍  Moj kvart"
                        Style="{StaticResource CitizenNavButtonStyle}"
                        IsEnabled="False"/>
                <TextBlock Text="AKTIVNOSTI U KVARTU" Style="{StaticResource CitizenNavGroupTitleStyle}"/>
                <Button Content="🗓  Događaji"
                        Style="{StaticResource CitizenNavButtonStyle}"
                        Click="EventsNavButton_Click"/>
                <Button Content="🤝  Sastanci"
                        Style="{StaticResource CitizenNavButtonStyle}"
                        Click="MeetingsNavButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
