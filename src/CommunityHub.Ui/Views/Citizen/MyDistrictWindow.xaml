<Window x:Class="CommunityHub.Ui.Views.Citizen.MyDistrictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moj kvart" Height="760" Width="980"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="DistrictNameTextBlock" FontSize="24" FontWeight="Bold"/>
                <TextBlock x:Name="DistrictDescriptionTextBlock" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Nazad" Padding="12,6" Click="BackButton_Click" VerticalAlignment="Top"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Osnovne informacije" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                    <TextBlock Text="Lokacija:" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DistrictLocationTextBlock" Margin="0,0,0,8"/>
                    <TextBlock Text="Datum vašeg učlanjenja:" FontWeight="SemiBold"/>
                    <TextBlock x:Name="MyJoinDateTextBlock"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6" Padding="12" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Ulice i opsezi brojeva" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                    <ListBox x:Name="StreetsListBox" Height="110"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Slike kvarta" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                <ListBox x:Name="DistrictImagesListBox" Height="90"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6" Padding="12">
            <StackPanel>
                <TextBlock Text="Evidencija poverenja građana u kvartu" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                <DataGrid x:Name="TrustRecordsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Građanin" Binding="{Binding CitizenFullName}" Width="2*"/>
                        <DataGridTextColumn Header="Datum učlanjenja" Binding="{Binding JoinDate}" Width="*"/>
                        <DataGridTextColumn Header="Organizovani događaji" Binding="{Binding OrganizedCompletedEventsCount}" Width="*"/>
                        <DataGridTextColumn Header="Potvrđena volontiranja" Binding="{Binding ConfirmedVolunteerEventsCount}" Width="*"/>
                        <DataGridTextColumn Header="Nivo" Binding="{Binding TrustLevel}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
