<Window x:Class="CommunityHub.Ui.Views.Citizen.CitizenHomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Građanin — Početna" Height="460" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Početna (Građanin)"
                   FontSize="22"
                   FontWeight="Bold"/>

        <Border Grid.Row="2" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6" Padding="16">
            <StackPanel>
                <TextBlock Text="Funkcionalnosti" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>

                <Button Content="Kvartovi — prikaz i pretraga"
                        Padding="14,10"
                        FontSize="14"
                        Click="DistrictSearchButton_Click"
                        Margin="0,0,0,10"/>

                <Button Content="Moji zahtevi za pristup kvartu"
                        Padding="14,10"
                        FontSize="14"
                        Click="MyDistrictRequestsButton_Click"
                        Margin="0,0,0,10"/>

                <Button Content="Dogadjaji kvarta"
                        Padding="14,10"
                        FontSize="14"
                        Click="DistrictEventsButton_Click"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Profil" Padding="14,8" Margin="0,0,10,0" Click="ProfileButton_Click"/>
            <Button Content="Odjavi se" Padding="14,8" Click="LogoutButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

