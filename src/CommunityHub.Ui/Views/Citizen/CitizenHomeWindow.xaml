<Page x:Class="CommunityHub.Ui.Views.Citizen.CitizenHomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource Win11WindowBackgroundBrush}">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CitizenTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Početna"
                           Style="{StaticResource Win11HeadingTextStyle}"
                           FontSize="30"/>
                <TextBlock Text="Dobrodošli u SIMS Građanin aplikaciju"
                           Foreground="{StaticResource Win11TextMutedBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="Ctrl+1 Početna | Ctrl+2 Pretraga kvartova | Ctrl+3 Moji zahtevi"
                       Foreground="{StaticResource Win11TextMutedBrush}"
                       VerticalAlignment="Bottom"/>
        </Grid>

        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Win11CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Status članstva"
                               Style="{StaticResource Win11HeadingTextStyle}"
                               FontSize="18"/>
                    <TextBlock x:Name="MembershipStatusTextBlock"
                               Foreground="{StaticResource Win11TextMutedBrush}"
                               Margin="0,6,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        x:Name="MembershipActionButton"
                        Content="Moj kvart"
                        Style="{StaticResource Win11SecondaryButtonStyle}"
                        Padding="18,9"
                        Margin="16,0,0,0"
                        Click="MembershipActionButton_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Win11CardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Dobrodošli"
                               Style="{StaticResource Win11HeadingTextStyle}"
                               FontSize="18"/>
                    <TextBlock x:Name="WelcomeDescriptionTextBlock"
                               Foreground="{StaticResource Win11TextMutedBrush}"
                               Margin="0,4,0,14"/>

                    <Button x:Name="FindDistrictButton"
                            Content="Pronađi kvart"
                            Style="{StaticResource Win11PrimaryButtonStyle}"
                            Padding="14,10"
                            Click="DistrictSearchButton_Click"
                            Margin="0,0,0,8"/>
                    <Button x:Name="OpenRequestsButton"
                            Content="Otvori moje zahteve"
                            Style="{StaticResource Win11SecondaryButtonStyle}"
                            Padding="14,10"
                            Click="MyDistrictRequestsButton_Click"
                            Margin="0,0,0,8"/>
                    <Button x:Name="DistrictEventsButton"
                            Content="Događaji kvarta"
                            Style="{StaticResource Win11SecondaryButtonStyle}"
                            Padding="14,10"
                            Click="DistrictEventsButton_Click"
                            Margin="0,0,0,8"/>
                    <Button x:Name="MeetingsButton"
                            Content="Sastanci"
                            Style="{StaticResource Win11SecondaryButtonStyle}"
                            Padding="14,10"
                            Click="MeetingsButton_Click"
                            Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Win11CardStyle}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Brzi pregled zahteva"
                               Style="{StaticResource Win11HeadingTextStyle}"
                               FontSize="18"/>
                    <TextBlock x:Name="QuickRequestTitleTextBlock"
                               Foreground="{StaticResource Win11TextPrimaryBrush}"
                               Margin="0,4,0,6"/>
                    <TextBlock x:Name="QuickRequestDescriptionTextBlock"
                               Foreground="{StaticResource Win11TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14"/>
                    <TextBlock x:Name="StateHintTextBlock"
                               Foreground="{StaticResource Win11TextPrimaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Visibility="Collapsed">
            <Button Content="Profil"
                    Style="{StaticResource Win11SecondaryButtonStyle}"
                    Padding="16,9"
                    Margin="0,0,10,0"
                    Click="ProfileButton_Click"/>
            <Button Content="Odjavi se"
                    Style="{StaticResource Win11PrimaryButtonStyle}"
                    Padding="16,9"
                    Click="LogoutButton_Click"/>
        </StackPanel>

        <Border Grid.Row="0"
                Grid.RowSpan="6"
                Grid.Column="1"
                Margin="12,0,0,0"
                Style="{StaticResource Win11CardStyle}">
            <StackPanel>
                <TextBlock Text="Navigacija"
                           Style="{StaticResource Win11HeadingTextStyle}"
                           FontSize="18"
                           Margin="0,0,0,10"/>

                <StackPanel x:Name="NonMemberNavPanel">
                    <Button Content="🏠  Početna"
                            Style="{StaticResource CitizenNavButtonStyle}"/>
                    <Button Content="🔎  Pretraga kvartova"
                            Style="{StaticResource CitizenNavButtonStyle}"
                            Click="DistrictSearchButton_Click"/>
                    <Button Content="📄  Moji zahtevi"
                            Style="{StaticResource CitizenNavButtonStyle}"
                            Click="MyDistrictRequestsButton_Click"/>
                </StackPanel>

                <StackPanel x:Name="MemberNavPanel" Visibility="Collapsed">
                    <TextBlock Text="OSNOVNO" Style="{StaticResource CitizenNavGroupTitleStyle}" Margin="0,0,0,6"/>
                    <Button Content="🏠  Početna"
                            Style="{StaticResource CitizenNavButtonStyle}"/>
                    <Button Content="📍  Moj kvart"
                            Style="{StaticResource CitizenNavButtonStyle}"
                            Click="MyDistrictButton_Click"/>

                    <TextBlock Text="AKTIVNOSTI U KVARTU" Style="{StaticResource CitizenNavGroupTitleStyle}"/>
                    <Button Content="🗓  Događaji"
                            Style="{StaticResource CitizenNavButtonStyle}"
                            Click="DistrictEventsButton_Click"/>
                    <Button Content="📊  Izveštaji"
                            Style="{StaticResource CitizenNavButtonStyle}"
                            Click="ReportsNotImplementedButton_Click"/>
                    <Button Content="🤝  Sastanci"
                            Style="{StaticResource CitizenNavButtonStyle}"
                            Click="MeetingsButton_Click"/>
                    <Button Content="🏛  Gradski objekti"
                            Style="{StaticResource CitizenNavButtonStyle}"
                            Click="ObjectsNotImplementedButton_Click"/>
                    <Button Content="⭐  Recenzije"
                            Style="{StaticResource CitizenNavButtonStyle}"
                            Click="ReviewsNotImplementedButton_Click"/>
                    <Button Content="💙  Donacije"
                            Style="{StaticResource CitizenNavButtonStyle}"
                            Click="DonationsNotImplementedButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
