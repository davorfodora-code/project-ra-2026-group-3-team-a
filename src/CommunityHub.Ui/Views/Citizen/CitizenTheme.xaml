<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Win11WindowBackgroundBrush" Color="#F4F8FF"/>
    <SolidColorBrush x:Key="Win11CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Win11CardBorderBrush" Color="#D6E5FF"/>
    <SolidColorBrush x:Key="Win11AccentBrush" Color="#2C6BE2"/>
    <SolidColorBrush x:Key="Win11AccentHoverBrush" Color="#2157BC"/>
    <SolidColorBrush x:Key="Win11AccentSoftBrush" Color="#EAF2FF"/>
    <SolidColorBrush x:Key="Win11TextPrimaryBrush" Color="#1E2B3C"/>
    <SolidColorBrush x:Key="Win11TextMutedBrush" Color="#5D6D85"/>

    <Style x:Key="Win11HeadingTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Win11TextPrimaryBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Win11CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Win11CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Win11CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <Style x:Key="Win11PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Win11AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource Win11AccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Win11SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Win11CardBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource Win11TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Win11CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#DDEBFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Win11InputTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Win11CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Foreground" Value="{StaticResource Win11TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="Win11InputComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Win11CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Foreground" Value="{StaticResource Win11TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="Win11DataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Win11CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="White"/>
        <Setter Property="AlternatingRowBackground" Value="#F7FAFF"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#E8EFFC"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#EAF2FF"/>
                    <Setter Property="Foreground" Value="{StaticResource Win11TextPrimaryBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="BorderBrush" Value="#DCE9FF"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="Padding" Value="8,7"/>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CitizenNavGroupTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Win11TextMutedBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,12,0,6"/>
    </Style>

    <Style x:Key="CitizenNavButtonStyle" TargetType="Button" BasedOn="{StaticResource Win11SecondaryButtonStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="CitizenBackButtonStyle" TargetType="Button" BasedOn="{StaticResource Win11SecondaryButtonStyle}">
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style x:Key="CitizenPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource Win11HeadingTextStyle}">
        <Setter Property="FontSize" Value="28"/>
    </Style>

    <Style x:Key="CitizenPageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Win11TextMutedBrush}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="CitizenSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource Win11HeadingTextStyle}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
</ResourceDictionary>
