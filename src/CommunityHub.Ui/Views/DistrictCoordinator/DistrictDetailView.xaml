<UserControl x:Class="CommunityHub.Ui.Views.DistrictCoordinator.DistrictDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/DistrictCoordinator/DistrictCoordinatorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <Style x:Key="LabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource DC.Text.Caption}"/>
                <Setter Property="Margin"     Value="0,0,0,4"/>
            </Style>
            <Style x:Key="ValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize"     Value="14"/>
                <Setter Property="Foreground"   Value="{StaticResource DC.Text.Primary}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#AA000000">
        <Border Background="{StaticResource DC.Bg.Card}" CornerRadius="10"
                Width="940" MaxHeight="700"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                BorderBrush="{StaticResource DC.Border}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── Header ── -->
                <Border Grid.Row="0" Background="{StaticResource DC.Primary}" CornerRadius="10,10,0,0">
                <Grid Height="64">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="28,0,0,0">
                        <TextBlock Text="{Binding Name, Mode=OneWay}"
                                   FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding Location, Mode=OneWay}"
                                   FontSize="13" Foreground="{StaticResource DC.Text.Caption}"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" Command="{Binding CloseCommand}"
                            Width="40" Height="40" Background="Transparent" BorderThickness="0"
                            FontSize="16" Foreground="{StaticResource DC.Text.OnDark}" Cursor="Hand" Margin="0,0,12,0"/>
                </Grid>
                </Border>

                <!-- ── Content ── -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="560">
                    <StackPanel Margin="28,24,28,16">

                        <!-- Slike carousel -->
                        <StackPanel Visibility="{Binding HasImages, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,24">
                            <TextBlock Text="SLIKE KVARTA" Style="{StaticResource LabelStyle}"/>

                            <!-- Image + arrow buttons -->
                            <Grid Height="230">
                                <!-- Main image -->
                                <Border CornerRadius="8" ClipToBounds="True">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding CurrentImagePath, Converter={StaticResource ImagePathConverter}}"
                                                    Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>

                                <!-- Left arrow -->
                                <Button HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="10,0" Width="36" Height="36"
                                        Command="{Binding PrevCommand}"
                                        Visibility="{Binding HasMultipleImages, Converter={StaticResource BoolToVis}}"
                                        Cursor="Hand" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Width="36" Height="36" CornerRadius="18"
                                                    Background="#88000000">
                                                <TextBlock Text="←" FontSize="16" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#BB000000"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.3"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Right arrow -->
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="10,0" Width="36" Height="36"
                                        Command="{Binding NextCommand}"
                                        Visibility="{Binding HasMultipleImages, Converter={StaticResource BoolToVis}}"
                                        Cursor="Hand" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Width="36" Height="36" CornerRadius="18"
                                                    Background="#88000000">
                                                <TextBlock Text="→" FontSize="16" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#BB000000"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.3"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Image counter (top right) -->
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,10,10,0" Background="#88000000" CornerRadius="10"
                                        Padding="8,3"
                                        Visibility="{Binding HasMultipleImages, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ImageCounterDisplay, Mode=OneWay}"
                                               FontSize="11" Foreground="White"/>
                                </Border>
                            </Grid>

                            <!-- Dots -->
                            <ItemsControl ItemsSource="{Binding Dots}"
                                          HorizontalAlignment="Center" Margin="0,10,0,0"
                                          Visibility="{Binding HasMultipleImages, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="7" CornerRadius="4" Margin="3,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Width"      Value="7"/>
                                                    <Setter Property="Background" Value="{StaticResource DC.Border.Strong}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Width"      Value="20"/>
                                                            <Setter Property="Background" Value="{StaticResource DC.Accent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Separator -->
                        <Border Height="1" Background="{StaticResource DC.Border}" Margin="0,0,0,24"
                                Visibility="{Binding HasImages, Converter={StaticResource BoolToVis}}"/>

                        <!-- Dvije kolone: info + ulice -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Lijeva kolona: opis, lokacija, budžet -->
                            <StackPanel Grid.Column="0">

                                <TextBlock Text="OPIS" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding Description, Mode=OneWay}"
                                           Style="{StaticResource ValueStyle}"
                                           LineHeight="22" Margin="0,0,0,20"/>

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="LOKACIJA" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock Text="{Binding Location, Mode=OneWay}"
                                                   Style="{StaticResource ValueStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="BUDŽET" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock Text="{Binding Budget, Mode=OneWay}"
                                                   FontSize="16" FontWeight="Bold" Foreground="{StaticResource DC.Success}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Vertikalni separator -->
                            <Border Grid.Column="1" Width="1" Background="{StaticResource DC.Border}"
                                    VerticalAlignment="Stretch"/>

                            <!-- Desna kolona: ulice -->
                            <StackPanel Grid.Column="2" Margin="28,0,0,0">
                                <TextBlock Text="ULICE KVARTA" Style="{StaticResource LabelStyle}"/>

                                <!-- Nema ulica -->
                                <TextBlock Text="Nema registrovanih ulica."
                                           FontSize="13" Foreground="{StaticResource DC.Text.Caption}" FontStyle="Italic">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasStreets}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Lista ulica -->
                                <Border Visibility="{Binding HasStreets, Converter={StaticResource BoolToVis}}"
                                        BorderBrush="{StaticResource DC.Border}" BorderThickness="1" CornerRadius="6">
                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Streets}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource DC.Border}" BorderThickness="0,0,0,1"
                                                            Padding="12,8" Background="{StaticResource DC.Bg.Card}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource DC.Bg.Subtle}"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="13" Foreground="{StaticResource DC.Text.Primary}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>

                <!-- ── Footer ── -->
                <Border Grid.Row="2" BorderBrush="{StaticResource DC.Border}" BorderThickness="0,1,0,0"
                        Background="{StaticResource DC.Bg.Subtle}" Padding="28,16"
                        CornerRadius="0,0,10,10">
                    <Button Content="Zatvori" Command="{Binding CloseCommand}"
                            Style="{StaticResource DC.Btn.Primary}"
                            HorizontalAlignment="Right"
                            Padding="28,10" FontSize="13"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
