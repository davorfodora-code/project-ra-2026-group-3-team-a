<UserControl x:Class="CommunityHub.Ui.Views.DistrictCoordinator.ForumView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CommunityHub.Ui.ViewModels.DistrictCoordinator">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <!-- LIST VIEW -->
        <Grid Visibility="{Binding IsListView, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar: Back + New forum -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Vrati se na finansije kvarta"
                        Background="Transparent" BorderBrush="#BDC3C7" BorderThickness="1"
                        Padding="12,6" FontSize="12" Foreground="#2C3E50" Cursor="Hand"/>
                <Button DockPanel.Dock="Right" Content="+ Novi forum"
                        Command="{Binding OpenCreateForumCommand}"
                        Background="Transparent" BorderBrush="#2C3E50" BorderThickness="1"
                        Padding="14,8" FontSize="13" Foreground="#2C3E50" Cursor="Hand"
                        FontWeight="SemiBold"/>
            </DockPanel>

            <!-- Search bar -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="32" Height="32" Background="#F0F0F0"
                        CornerRadius="16" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="Q" FontSize="14" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#2C3E50"/>
                </Border>

                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Height="36" FontSize="13" Padding="10,6"
                         BorderBrush="#E0E0E0" BorderThickness="1"
                         VerticalContentAlignment="Center"/>

                <Button Grid.Column="2" Content="Pretrazi"
                        Command="{Binding SearchCommand}"
                        Background="#2C3E50" Foreground="White" BorderThickness="0"
                        Padding="16,8" FontSize="13" Cursor="Hand" Margin="8,0,0,0"/>
            </Grid>

            <!-- Search result text -->
            <TextBlock Grid.Row="2" FontSize="12" Foreground="#666" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text">
                            <Setter.Value>
                                <Binding Path="Forums.Count" StringFormat="Prikazano {0} foruma"/>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Forum list -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Forums}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.OpenForumCommand,
                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Cursor="Hand" HorizontalContentAlignment="Stretch">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="White" BorderBrush="#E0E0E0"
                                                BorderThickness="1" Padding="14" Margin="0,0,0,6"
                                                CornerRadius="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F8F9FA"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="#2C3E50"/>
                                                        <Border Background="#E65C00" CornerRadius="3"
                                                                Padding="6,2" Margin="8,0,0,0"
                                                                Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Vaš forum" FontSize="10"
                                                                       Foreground="White" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <TextBlock Text="zaključan" FontSize="10" Foreground="#888"
                                                                   Margin="8,2,0,0" FontStyle="Italic"
                                                                   Visibility="{Binding IsClosed, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ContentPreview}"
                                                               FontSize="12" Foreground="#555"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,4,0,4"/>
                                                    <TextBlock FontSize="11" Foreground="#888">
                                                        <Run Text="{Binding AuthorFullName, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                           FontSize="12" Foreground="#888">
                                                    <Run Text="{Binding CommentCount, Mode=OneWay}"/>
                                                    <Run Text=" komentar"/>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- DETAIL VIEW -->
        <Grid Visibility="{Binding IsDetailView, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Back button -->
            <Button Grid.Row="0" Content="Vrati se na forume"
                    Command="{Binding BackToListCommand}"
                    HorizontalAlignment="Left" Margin="0,0,0,12"
                    Background="Transparent" BorderBrush="#BDC3C7" BorderThickness="1"
                    Padding="12,6" FontSize="12" Foreground="#2C3E50" Cursor="Hand"/>

            <!-- Closed banner -->
            <Border Grid.Row="1" Background="#FFF3CD" BorderBrush="#FFEEBA" BorderThickness="1"
                    CornerRadius="4" Padding="12,8" Margin="0,0,0,10"
                    Visibility="{Binding IsForumClosed, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="i" FontWeight="Bold" Foreground="#856404"
                               FontSize="14" Margin="0,0,8,0"/>
                    <TextBlock Text="Ovaj forum je zaključan" FontSize="13"
                               Foreground="#856404"/>
                </StackPanel>
            </Border>

            <!-- Forum title + close button -->
            <DockPanel Grid.Row="2" Margin="0,0,0,10" LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Zatvori forum"
                        Command="{Binding CloseForumCommand}"
                        Visibility="{Binding CanClose, Converter={StaticResource BoolToVis}}"
                        Background="Transparent" BorderBrush="#BDC3C7" BorderThickness="1"
                        Padding="14,8" FontSize="12" Foreground="#2C3E50" Cursor="Hand"
                        Margin="10,0,0,0"/>
                <StackPanel>
                    <TextBlock Text="{Binding SelectedForum.Title}"
                               FontSize="18" FontWeight="Bold" Foreground="#2C3E50"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>

            <!-- Forum content -->
            <Border Grid.Row="3" Background="#F8F9FA" CornerRadius="4"
                    Padding="16" Margin="0,0,0,16"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <TextBlock Text="{Binding SelectedForum.Content}"
                           FontSize="13" Foreground="#333" TextWrapping="Wrap"
                           LineHeight="22"/>
            </Border>

            <!-- Comments header -->
            <TextBlock Grid.Row="4" FontSize="14" FontWeight="SemiBold"
                       Foreground="#2C3E50" Margin="0,0,0,8"
                       VerticalAlignment="Top">
                <Run Text="Komentari("/>
                <Run Text="{Binding Comments.Count, Mode=OneWay}"/>
                <Run Text=")"/>
                <Run Text=" - zaključani" FontStyle="Italic" Foreground="#888">
                    <Run.Style>
                        <Style TargetType="Run">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsForumClosed}" Value="False">
                                    <Setter Property="Text" Value=""/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Run.Style>
                </Run>
            </TextBlock>

            <!-- Comments list + input -->
            <Grid Grid.Row="4" Margin="0,30,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Comments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#E0E0E0"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar circle -->
                                        <Border Grid.Column="0" Width="36" Height="36"
                                                Background="#2C3E50" CornerRadius="18"
                                                Margin="0,0,10,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding AuthorInitials}"
                                                       Foreground="White" FontWeight="Bold"
                                                       FontSize="12" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Content -->
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding AuthorDistrictInfo}"
                                                           FontSize="12" Foreground="#555"/>
                                                <Border Background="#27AE60" CornerRadius="3"
                                                        Padding="6,2" Margin="8,0,0,0"
                                                        Visibility="{Binding IsForumAuthor, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Vi ste autor" FontSize="9"
                                                               Foreground="White" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Content}"
                                                       FontSize="13" Foreground="#333"
                                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- Reactions -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LikeCount}"
                                                       FontSize="14" FontWeight="Bold"
                                                       Foreground="#E74C3C" VerticalAlignment="Center"
                                                       Margin="0,0,4,0"/>
                                            <Button Content="&#x25B2;"
                                                    Command="{Binding DataContext.LikeCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    FontSize="14" Foreground="#555"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" Padding="4,2" Margin="0,0,10,0"/>

                                            <TextBlock Text="{Binding DislikeCount}"
                                                       FontSize="14" FontWeight="Bold"
                                                       Foreground="#E74C3C" VerticalAlignment="Center"
                                                       Margin="0,0,4,0"/>
                                            <Button Content="&#x25BC;"
                                                    Command="{Binding DataContext.DislikeCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    FontSize="14" Foreground="#555"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" Padding="4,2"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Add comment (hidden when closed) -->
                <Border Grid.Row="1" Margin="0,10,0,0"
                        Visibility="{Binding CanComment, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Dodajte komentar" FontSize="13"
                                   FontWeight="SemiBold" Foreground="#2C3E50"
                                   Margin="0,0,0,6"/>
                        <TextBox Text="{Binding NewCommentText, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 Height="80" Padding="10,8" FontSize="13"
                                 BorderBrush="#E0E0E0" BorderThickness="1"/>
                        <Button Content="Objavi komentar"
                                Command="{Binding PostCommentCommand}"
                                HorizontalAlignment="Right" Margin="0,8,0,0"
                                Background="#2C3E50" Foreground="White" BorderThickness="0"
                                Padding="16,8" FontSize="13" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- Closed message -->
                <TextBlock Grid.Row="1" Margin="0,10,0,0"
                           FontSize="12" Foreground="#888" FontStyle="Italic"
                           Visibility="{Binding IsForumClosed, Converter={StaticResource BoolToVis}}">
                    Komentarisanje je onemogućeno za dati forum
                </TextBlock>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
