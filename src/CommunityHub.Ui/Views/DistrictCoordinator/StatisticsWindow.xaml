<Window x:Class="CommunityHub.Ui.Views.DistrictCoordinator.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CommunityHub.Ui.Converters"
        Title="Statistika i Sastanci"
        Width="820" Height="620"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:ActiveFilterToBackgroundConverter x:Key="FilterBg"/>
        <conv:ActiveFilterToForegroundConverter x:Key="FilterFg"/>

        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="Margin"          Value="0,0,8,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="16,12">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Text="Statistika i Sastanci"
                           Foreground="White" FontSize="17" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right"
                        Content="Zakaži sastanak"
                        Command="{Binding ScheduleMeetingCommand}"
                        Padding="16,8" FontSize="13"
                        Background="White" Foreground="#2C3E50"
                        FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Kvart:" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding Districts}"
                          SelectedItem="{Binding SelectedDistrict, Mode=TwoWay}"
                          Height="32" FontSize="13"
                          DisplayMemberPath="DistrictName"/>
            </DockPanel>

            <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="#E0E0E0"
                    BorderThickness="1" CornerRadius="6" Padding="16,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding NovCount}" FontSize="22"
                                   FontWeight="Bold" HorizontalAlignment="Center" Foreground="#1565C0"/>
                        <TextBlock Text="Novi" FontSize="11"
                                   HorizontalAlignment="Center" Foreground="#555"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding NeaktivanCount}" FontSize="22"
                                   FontWeight="Bold" HorizontalAlignment="Center" Foreground="#E65C00"/>
                        <TextBlock Text="Neaktivni" FontSize="11"
                                   HorizontalAlignment="Center" Foreground="#555"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding AktivanCount}" FontSize="22"
                                   FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2E7D32"/>
                        <TextBlock Text="Aktivni" FontSize="11"
                                   HorizontalAlignment="Center" Foreground="#555"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding IstaknutiCount}" FontSize="22"
                                   FontWeight="Bold" HorizontalAlignment="Center" Foreground="#6A1B9A"/>
                        <TextBlock Text="Istaknuti" FontSize="11"
                                   HorizontalAlignment="Center" Foreground="#555"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding OdPoverenjaCount}" FontSize="22"
                                   FontWeight="Bold" HorizontalAlignment="Center" Foreground="#F9A825"/>
                        <TextBlock Text="Od poverenja" FontSize="11"
                                   HorizontalAlignment="Center" Foreground="#555"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="#EEF6FF" BorderBrush="#B3D1F5"
                    BorderThickness="1" CornerRadius="6" Padding="14,8" Margin="0,0,0,14">
                <TextBlock Text="{Binding RecommendationText}"
                           FontSize="13" Foreground="#1A3A5C" TextWrapping="Wrap"/>
            </Border>

            <!-- Filter dugmad: boja se računa iz ActiveFilter bindinga. -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Style="{StaticResource FilterButtonStyle}" Content="Prikaži sve sastanke"
                        Command="{Binding SetFilterCommand}" CommandParameter="all"
                        Background="{Binding ActiveFilter, Converter={StaticResource FilterBg}, ConverterParameter=all}"
                        Foreground="{Binding ActiveFilter, Converter={StaticResource FilterFg}, ConverterParameter=all}"/>
                <Button Style="{StaticResource FilterButtonStyle}" Content="Prikaži zakazane"
                        Command="{Binding SetFilterCommand}" CommandParameter="scheduled"
                        Background="{Binding ActiveFilter, Converter={StaticResource FilterBg}, ConverterParameter=scheduled}"
                        Foreground="{Binding ActiveFilter, Converter={StaticResource FilterFg}, ConverterParameter=scheduled}"/>
                <Button Style="{StaticResource FilterButtonStyle}" Content="Prikaži u pripremi"
                        Command="{Binding SetFilterCommand}" CommandParameter="inprogress"
                        Background="{Binding ActiveFilter, Converter={StaticResource FilterBg}, ConverterParameter=inprogress}"
                        Foreground="{Binding ActiveFilter, Converter={StaticResource FilterFg}, ConverterParameter=inprogress}"/>
            </StackPanel>

            <DataGrid Grid.Row="4" ItemsSource="{Binding FilteredMeetings}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column"
                      CanUserResizeRows="False"
                      GridLinesVisibility="Horizontal"
                      BorderBrush="#DDDDDD" BorderThickness="1"
                      RowBackground="White" AlternatingRowBackground="#FAFAFA">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tema"           Binding="{Binding MeetingTypeDisplay}" Width="120"/>
                    <DataGridTextColumn Header="Datum i vreme"  Binding="{Binding DateTimeDisplay}"    Width="*"/>
                    <DataGridTextColumn Header="Status"         Binding="{Binding StatusDisplay}"      Width="110"/>
                    <DataGridTextColumn Header="Broj glasova"   Binding="{Binding VoteCount}"          Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
