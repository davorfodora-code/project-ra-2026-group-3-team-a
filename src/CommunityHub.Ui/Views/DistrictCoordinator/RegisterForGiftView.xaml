<UserControl x:Class="CommunityHub.Ui.Views.DistrictCoordinator.RegisterForGiftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/DistrictCoordinator/DistrictCoordinatorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#CC000000">
        <Border Background="{StaticResource DC.Bg.Card}" CornerRadius="10" MaxWidth="480"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                BorderBrush="{StaticResource DC.Border}" BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Background="{StaticResource DC.Bg.Subtle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="22,16,0,16">
                        <TextBlock Text="Prijava za poklon grada"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource DC.Text.Primary}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" Command="{Binding CloseCommand}"
                            Width="34" Height="34" Background="Transparent" BorderThickness="0"
                            FontSize="14" Foreground="{StaticResource DC.Text.Caption}" Cursor="Hand" Margin="0,8,14,8"/>
                </Grid>

                <Border Grid.Row="0" BorderBrush="{StaticResource DC.Border}" BorderThickness="0,0,0,1"
                        VerticalAlignment="Bottom"/>

                <!-- Content -->
                <StackPanel Grid.Row="1" Margin="22,20,22,8">

                    <!-- Info box: gift name -->
                    <Border Background="{StaticResource DC.Accent.Light}" CornerRadius="6" Padding="14,12" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="24" Height="24" CornerRadius="12"
                                    Background="{StaticResource DC.Accent}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="i" FontSize="12" FontStyle="Italic" FontWeight="Bold"
                                           Foreground="{StaticResource DC.Text.OnDark}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="12" Foreground="{StaticResource DC.Text.Primary}" TextWrapping="Wrap">
                                    <Run Text="Prijavljujete se na "/>
                                    <Run Text="{Binding GiftName, Mode=OneWay}" FontWeight="Bold"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- District label -->
                    <TextBlock Text="Odaberite kvart" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource DC.Text.Secondary}" Margin="0,0,0,8"/>

                    <!-- ComboBox -->
                    <ComboBox ItemsSource="{Binding Districts}"
                              SelectedItem="{Binding SelectedDistrict}"
                              DisplayMemberPath="DisplayText"
                              Style="{StaticResource DC.ComboBox}"
                              Margin="0,0,0,4"/>

                    <!-- Hint when multiple districts -->
                    <TextBlock FontSize="11" Foreground="{StaticResource DC.Text.Caption}" Margin="2,3,0,0"
                               Visibility="{Binding HasMultipleDistricts, Converter={StaticResource BoolToVis}}">
                        Moguće je prijaviti samo jedan kvart po poklonu.
                    </TextBlock>

                    <!-- Error -->
                    <Border Margin="0,12,0,0" Background="{StaticResource DC.Danger.Light}" CornerRadius="6" Padding="12,9"
                            BorderBrush="{StaticResource DC.Danger}" BorderThickness="1"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ErrorText, Mode=OneWay}"
                                   FontSize="12" Foreground="{StaticResource DC.Danger}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <!-- Footer -->
                <Border Grid.Row="2" BorderBrush="{StaticResource DC.Border}" BorderThickness="0,1,0,0"
                        Background="{StaticResource DC.Bg.Subtle}" Padding="22,14">
                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="Otkaži" Command="{Binding CancelCommand}"
                                Style="{StaticResource DC.Btn.Ghost}" Padding="20,8" FontSize="12"/>
                        <Button DockPanel.Dock="Right" Content="Završi prijavu" Command="{Binding ConfirmCommand}"
                                Style="{StaticResource DC.Btn.Primary}" Padding="22,9" FontSize="12"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
