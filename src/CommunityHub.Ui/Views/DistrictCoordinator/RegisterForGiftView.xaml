<UserControl x:Class="CommunityHub.Ui.Views.DistrictCoordinator.RegisterForGiftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="#99000000">
        <Border Background="{StaticResource BrushCard}" CornerRadius="10" MaxWidth="480"
                Margin="40" VerticalAlignment="Center" HorizontalAlignment="Center"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Background="{StaticResource BrushSurface}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="22,16,0,16">
                        <TextBlock Text="Prijava za poklon grada"
                                   FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" Command="{Binding CloseCommand}"
                            Width="34" Height="34" Background="Transparent" BorderThickness="0"
                            FontSize="14" Foreground="{StaticResource BrushTextMuted}" Cursor="Hand" Margin="0,8,14,8"/>
                </Grid>

                <Border Grid.Row="0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                        VerticalAlignment="Bottom"/>

                <!-- Content -->
                <StackPanel Grid.Row="1" Margin="22,20,22,8">

                    <!-- Info box: gift name -->
                    <Border Background="{StaticResource BrushSurface}" CornerRadius="6" Padding="14,12" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="24" Height="24" CornerRadius="12"
                                    Background="{StaticResource BrushAccent}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="i" FontSize="12" FontStyle="Italic" FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="12" Foreground="{StaticResource BrushAccent}" TextWrapping="Wrap">
                                    <Run Text="Prijavljujete se na "/>
                                    <Run Text="{Binding GiftName, Mode=OneWay}" FontWeight="Bold"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- District label -->
                    <TextBlock Text="Odaberite kvart" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8"/>

                    <!-- ComboBox -->
                    <ComboBox ItemsSource="{Binding Districts}"
                              SelectedItem="{Binding SelectedDistrict}"
                              Height="36" FontSize="13"
                              BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                              Margin="0,0,0,4">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" Margin="2,0"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Hint when only one district -->
                    <TextBlock FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="2,3,0,0"
                               Visibility="{Binding HasMultipleDistricts, Converter={StaticResource BoolToVis}}">
                        Moguće je prijaviti samo jedan kvart po poklonu.
                    </TextBlock>

                    <!-- Error -->
                    <Border Margin="0,12,0,0" Background="{StaticResource BrushSurface}" CornerRadius="6" Padding="12,9"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ErrorText, Mode=OneWay}"
                                   FontSize="12" Foreground="{StaticResource BrushDanger}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <!-- Footer -->
                <Border Grid.Row="2" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
                        Background="{StaticResource BrushBackground}" Padding="22,14">
                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="Otkaži" Command="{Binding CancelCommand}"
                                Background="Transparent" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                Padding="20,8" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" Cursor="Hand"/>
                        <Button DockPanel.Dock="Right" Content="Završi prijavu" Command="{Binding ConfirmCommand}"
                                Background="{StaticResource BrushSurface}" Foreground="{StaticResource BrushTextPrimary}" BorderThickness="0"
                                Padding="22,9" FontSize="12" FontWeight="SemiBold" Cursor="Hand"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
