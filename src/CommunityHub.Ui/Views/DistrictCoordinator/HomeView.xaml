<UserControl x:Class="CommunityHub.Ui.Views.DistrictCoordinator.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/DistrictCoordinator/DistrictCoordinatorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="DistrictCardStyle" TargetType="Border">
                <Setter Property="Margin"          Value="10"/>
                <Setter Property="CornerRadius"    Value="8"/>
                <Setter Property="Padding"         Value="16"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background"      Value="{StaticResource DC.Bg.Card}"/>
                <Setter Property="BorderBrush"     Value="{StaticResource DC.Border}"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background"  Value="{StaticResource DC.Accent.Light}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource DC.Accent}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="30,20,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding DistrictCountSummary}"
                           Style="{StaticResource DC.H2}"/>
                <TextBlock Text="Kliknite na kvart ili dugme za detalje o kvartu"
                           Style="{StaticResource DC.Caption}" Margin="0,2,0,0"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Registruj novi kvart"
                    Command="{Binding RegisterDistrictCommand}"
                    Style="{StaticResource DC.Btn.Primary}"
                    Padding="18,9" FontSize="13"
                    VerticalAlignment="Center"/>
        </DockPanel>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding DistrictCards}"
                      VerticalAlignment="Top">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource DistrictCardStyle}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding DataContext.OpenDistrictDetailCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DC.Caption}">
                                        <Setter Property="Text" Value="Kvart"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Text" Value="Izabran"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="{StaticResource DC.Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="{Binding Name}" Style="{StaticResource DC.H1}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding LocationDisplay}" FontSize="12"
                                       Foreground="{StaticResource DC.Text.Secondary}" HorizontalAlignment="Center"
                                       Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ukupan budžet"
                                           FontSize="12" Foreground="{StaticResource DC.Text.Secondary}" Margin="0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BudgetDisplay}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource DC.Text.Primary}" Margin="0,2"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Broj članova"
                                           FontSize="12" Foreground="{StaticResource DC.Text.Secondary}" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MembersCount}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource DC.Text.Primary}" Margin="0,2"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Broj ulica"
                                           FontSize="12" Foreground="{StaticResource DC.Text.Secondary}" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StreetsCount}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource DC.Text.Primary}" Margin="0,2"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Zahtevi na čekanju"
                                           FontSize="12" Foreground="{StaticResource DC.Text.Secondary}" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PendingRequestsCount}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource DC.Text.Primary}" Margin="0,2"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Finansije"
                                        Command="{Binding DataContext.OpenFinancesCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource DC.Btn.Ghost}"
                                        Padding="12,7" FontSize="12"
                                        Margin="0,0,8,0"/>
                                <Button Content="Detalji kvarta"
                                        Command="{Binding DataContext.OpenDistrictDetailCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource DC.Btn.Primary}"
                                        Padding="12,7" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </Grid>
</UserControl>
