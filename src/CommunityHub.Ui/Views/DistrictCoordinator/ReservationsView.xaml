<UserControl x:Class="CommunityHub.Ui.Views.DistrictCoordinator.ReservationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/DistrictCoordinator/DistrictCoordinatorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- Main content -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title + description -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="Mesta za rezervacije" Style="{StaticResource DC.H2}"/>
                <TextBlock Text="Broj glasova u gornjem desnom uglu predstavlja broj građana koji su glasali za dato mesto"
                           Style="{StaticResource DC.Caption}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- District selector -->
            <DockPanel Grid.Row="2" Margin="0,0,0,16" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Kvart:"
                           FontSize="13" Foreground="{StaticResource DC.Text.Secondary}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox DockPanel.Dock="Left"
                          ItemsSource="{Binding Districts}"
                          SelectedItem="{Binding SelectedDistrict}"
                          Style="{StaticResource DC.ComboBox}"
                          DisplayMemberPath="DisplayText"
                          Width="280"/>
            </DockPanel>

            <!-- City objects grid -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding CityObjects}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource DC.Border}" BorderThickness="1" CornerRadius="8"
                                    Background="{StaticResource DC.Bg.Card}" Margin="0,0,16,16" Width="200">
                                <Grid Margin="14,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Vote count (top-right) -->
                                    <TextBlock Grid.Row="0"
                                               HorizontalAlignment="Right"
                                               FontSize="11" Foreground="{StaticResource DC.Text.Caption}"
                                               Text="{Binding VoteCount, Mode=OneWay, StringFormat={}{0} glasova}"/>

                                    <!-- Name -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Name}"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource DC.Text.Primary}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,4"/>

                                    <!-- Location & capacity -->
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding LocationCapacityDisplay}"
                                               FontSize="11" Foreground="{StaticResource DC.Text.Secondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12"/>

                                    <!-- Reserve button -->
                                    <Button Grid.Row="3"
                                            Content="Rezerviši"
                                            Command="{Binding ReserveCommand}"
                                            Style="{StaticResource DC.Btn.Secondary}"
                                            HorizontalAlignment="Right"
                                            Padding="14,5" FontSize="12"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Success/error notification -->
            <Border Grid.Row="4"
                    Background="{StaticResource DC.Success}" CornerRadius="6"
                    Padding="16,10" HorizontalAlignment="Center"
                    Visibility="{Binding HasNotification, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding NotificationText}"
                           FontSize="13" FontStyle="Italic" FontWeight="SemiBold"
                           Foreground="White"/>
            </Border>
        </Grid>

    </Grid>
</UserControl>
