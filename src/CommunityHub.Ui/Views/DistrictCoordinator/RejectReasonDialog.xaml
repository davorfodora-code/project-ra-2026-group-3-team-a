<Window x:Class="CommunityHub.Ui.Views.DistrictCoordinator.RejectReasonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Odbijanje zahteva" Height="220" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Obrazlozenje odbijanja (opciono):"
                   FontSize="14" Margin="0,0,0,8"/>

        <TextBox Grid.Row="1" x:Name="ReasonTextBox"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,10"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Odbij zahtev" Click="ConfirmButton_Click"
                    Padding="15,8" Margin="0,0,10,0"
                    Background="#E74C3C" Foreground="White"/>
            <Button Content="Otkazi" Click="CancelButton_Click"
                    Padding="15,8"/>
        </StackPanel>
    </Grid>
</Window>
