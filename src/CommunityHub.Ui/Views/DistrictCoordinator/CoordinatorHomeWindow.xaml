<Window x:Class="CommunityHub.Ui.Views.DistrictCoordinator.CoordinatorHomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CommunityHub.Ui.ViewModels.DistrictCoordinator"
        xmlns:local="clr-namespace:CommunityHub.Ui.Views.DistrictCoordinator"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="DCord" Height="780" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource DC.Bg.Page}">

    <Window.InputBindings>
        <KeyBinding Key="F1"    Command="{Binding ToggleContextHelpCommand}"/>
        <KeyBinding Key="F2"    Command="{Binding SwitchTabCommand}" CommandParameter="home"/>
        <KeyBinding Key="N"     Modifiers="Ctrl" Command="{Binding NewItemCommand}"/>
        <KeyBinding Key="F5"    Command="{Binding RefreshTabCommand}"/>
        <KeyBinding Key="Return" Command="{Binding ConfirmCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
        <KeyBinding Key="D"     Modifiers="Ctrl" Command="{Binding CancelDialogTabCommand}"/>
        <KeyBinding Key="X"     Modifiers="Ctrl" Command="{Binding DismissWelcomeCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding GlobalEscapeCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/DistrictCoordinator/DistrictCoordinatorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <DataTemplate DataType="{x:Type vm:HomeContentViewModel}">
                <local:HomeView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AccessRequestsViewModel}">
                <local:AccessRequestsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StatisticsViewModel}">
                <local:StatisticsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DistrictRegistrationViewModel}">
                <local:DistrictRegistrationOverlay/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DistrictDetailViewModel}">
                <local:DistrictDetailView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ForumViewModel}">
                <local:ForumView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CreateForumDialogViewModel}">
                <local:CreateForumDialog/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReservationsViewModel}">
                <local:ReservationsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReservationDialogViewModel}">
                <local:ReservationDialogView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReviewsViewModel}">
                <local:ReviewsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FinancesViewModel}">
                <local:FinancesView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CityGiftsViewModel}">
                <local:CityGiftsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HelpViewModel}">
                <local:HelpView/>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- top bar -->
            <RowDefinition Height="Auto"/>  <!-- nav tabs -->
            <RowDefinition Height="*"/>     <!-- content -->
            <RowDefinition Height="Auto"/>  <!-- footer -->
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource DC.Bg.Card}"
                BorderBrush="{StaticResource DC.Border}" BorderThickness="0,0,0,1"
                Padding="28,22">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="DCord" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource DC.Accent}" VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource DC.Text.Primary}"
                       VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Moji kvartovi"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRequestsTab}" Value="True">
                                <Setter Property="Text" Value="Zahtevi"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsStatsTab}" Value="True">
                                <Setter Property="Text" Value="Statistika"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsForumTab}" Value="True">
                                <Setter Property="Text" Value="Forum"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsReservationsTab}" Value="True">
                                <Setter Property="Text" Value="Rezervacije"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsReviewsTab}" Value="True">
                                <Setter Property="Text" Value="Recenzije"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFinancesTab}" Value="True">
                                <Setter Property="Text" Value="Finansije kvarta"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCityGiftsTab}" Value="True">
                                <Setter Property="Text" Value="Poklon grada"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHelpTab}" Value="True">
                                <Setter Property="Text" Value="Pomoć"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Header.SavedAtText}" FontSize="11" Foreground="{StaticResource DC.Text.Caption}"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Border Width="36" Height="36" Background="{StaticResource DC.Primary}" CornerRadius="18"
                        Margin="0,0,8,0">
                    <TextBlock Text="{Binding Header.Initials}" Foreground="White"
                               FontWeight="Bold" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Header.FullName}"
                               FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DC.Text.Primary}"/>
                    <TextBlock Text="Koordinator" FontSize="11" Foreground="{StaticResource DC.Text.Caption}"/>
                </StackPanel>
                <Button Content="Odjavi se"
                        Command="{Binding LogoutCommand}"
                        Style="{StaticResource DC.Btn.Ghost}"
                        Padding="10,4" FontSize="11" Margin="16,0,0,0"/>
            </StackPanel>
        </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="{StaticResource DC.Border}" BorderThickness="0,0,0,1"
                Background="{StaticResource DC.Bg.Card}">
            <StackPanel Orientation="Horizontal" Margin="20,0">

                <Grid>
                    <Button Content="Moji kvartovi"
                            Command="{Binding SwitchTabCommand}" CommandParameter="home">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DC.NavTab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHomeTab}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource DC.Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Height="3" Background="{StaticResource DC.Accent}" VerticalAlignment="Bottom"
                            Visibility="{Binding IsHomeTab, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <Grid>
                    <Button Content="Finansije kvarta"
                            Command="{Binding SwitchTabCommand}" CommandParameter="finances">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DC.NavTab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFinancesTab}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource DC.Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Height="3" Background="{StaticResource DC.Accent}" VerticalAlignment="Bottom"
                            Visibility="{Binding IsFinancesTab, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <Grid>
                    <Button Content="Zahtevi"
                            Command="{Binding SwitchTabCommand}" CommandParameter="requests">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DC.NavTab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRequestsTab}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource DC.Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Height="3" Background="{StaticResource DC.Accent}" VerticalAlignment="Bottom"
                            Visibility="{Binding IsRequestsTab, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <Grid>
                    <Button Content="Statistika"
                            Command="{Binding SwitchTabCommand}" CommandParameter="stats">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DC.NavTab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatsTab}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource DC.Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Height="3" Background="{StaticResource DC.Accent}" VerticalAlignment="Bottom"
                            Visibility="{Binding IsStatsTab, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <Grid>
                    <Button Content="Forum"
                            Command="{Binding SwitchTabCommand}" CommandParameter="forum">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DC.NavTab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsForumTab}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource DC.Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Height="3" Background="{StaticResource DC.Accent}" VerticalAlignment="Bottom"
                            Visibility="{Binding IsForumTab, Converter={StaticResource BoolToVis}}"/>
                </Grid>
                <Grid>
                    <Button Content="Rezervacije"
                            Command="{Binding SwitchTabCommand}" CommandParameter="reservations">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DC.NavTab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReservationsTab}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource DC.Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Height="3" Background="{StaticResource DC.Accent}" VerticalAlignment="Bottom"
                            Visibility="{Binding IsReservationsTab, Converter={StaticResource BoolToVis}}"/>
                </Grid>
                <Grid>
                    <Button Content="Recenzije"
                            Command="{Binding SwitchTabCommand}" CommandParameter="reviews">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DC.NavTab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReviewsTab}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource DC.Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Height="3" Background="{StaticResource DC.Accent}" VerticalAlignment="Bottom"
                            Visibility="{Binding IsReviewsTab, Converter={StaticResource BoolToVis}}"/>
                </Grid>
                <Grid>
                    <Button Content="Poklon grada"
                            Command="{Binding SwitchTabCommand}" CommandParameter="citygifts">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DC.NavTab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCityGiftsTab}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource DC.Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Height="3" Background="{StaticResource DC.Accent}" VerticalAlignment="Bottom"
                            Visibility="{Binding IsCityGiftsTab, Converter={StaticResource BoolToVis}}"/>
                </Grid>
                <Grid>
                    <Button Content="Pomoć"
                            Command="{Binding SwitchTabCommand}" CommandParameter="help">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DC.NavTab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHelpTab}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource DC.Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Height="3" Background="{StaticResource DC.Accent}" VerticalAlignment="Bottom"
                            Visibility="{Binding IsHelpTab, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="2">
            <!-- Uvodni "welcome" banner — prikazuje se samo prvi put -->
            <Border DockPanel.Dock="Top"
                    Visibility="{Binding ShowWelcomeBanner, Converter={StaticResource BoolToVis}}"
                    Background="{StaticResource DC.Bg.Subtle}"
                    BorderBrush="{StaticResource DC.Accent}" BorderThickness="1"
                    CornerRadius="10" Margin="30,18,30,0" Padding="22,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Info ikona -->
                    <Border Grid.Column="0" Width="56" Height="56" CornerRadius="28"
                            Background="{StaticResource DC.Accent.Light}"
                            VerticalAlignment="Center" Margin="0,0,18,0">
                        <fa:IconImage Icon="Info" Width="26" Height="26"
                                      Foreground="{StaticResource DC.Accent}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Tekst -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="Nije Vam poznato okruženje?"
                                   FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource DC.Text.Primary}"/>
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                   FontSize="13" Foreground="{StaticResource DC.Text.Secondary}"
                                   Text="Pogledajte tutorijal i upoznajte se sa svim funkcionalnostima aplikacije. Ovaj tutorijal možete i naknadno pokrenuti klikom na upitnik u donjem desnom uglu."/>
                    </StackPanel>

                    <!-- Akcije -->
                    <Button Grid.Column="2" Content="Pogledaj tutorijal"
                            Command="{Binding WatchWelcomeTutorialCommand}"
                            Style="{StaticResource DC.Btn.Primary}"
                            Padding="18,9" FontSize="13" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Content="Zatvori (Ctrl+X)"
                            Command="{Binding DismissWelcomeCommand}"
                            Style="{StaticResource DC.Btn.Secondary}"
                            Padding="16,9" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <ContentControl Content="{Binding CurrentTabContent}"/>
        </DockPanel>

        <Border Grid.Row="3" BorderBrush="{StaticResource DC.Border}" BorderThickness="0,1,0,0"
                Background="{StaticResource DC.Bg.Card}" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,32,0">
                    <TextBlock Text="Saldo:" FontSize="11" Foreground="{StaticResource DC.Text.Caption}"/>
                    <TextBlock Text="{Binding Header.TotalBudgetDisplay}" FontSize="13"
                               FontWeight="SemiBold" Foreground="{StaticResource DC.Primary}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,32,0">
                    <TextBlock Text="Ukupno donacija:" FontSize="11" Foreground="{StaticResource DC.Text.Caption}"/>
                    <TextBlock Text="{Binding Finances.DonationsDisplay}" FontSize="13"
                               FontWeight="SemiBold" Foreground="{StaticResource DC.Success}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Ukupno troškova:" FontSize="11" Foreground="{StaticResource DC.Text.Caption}"/>
                    <TextBlock Text="{Binding Finances.ExpensesDisplay}" FontSize="13"
                               FontWeight="SemiBold" Foreground="{StaticResource DC.Danger}"/>
                </StackPanel>

                <TextBlock Grid.Column="4" Text="{Binding Header.FooterInfo}"
                           FontSize="11" Foreground="{StaticResource DC.Text.Caption}"
                           HorizontalAlignment="Right" TextAlignment="Right"/>
            </Grid>
        </Border>

        <ContentControl Grid.RowSpan="4" Panel.ZIndex="100"
                        Content="{Binding ActiveOverlay}"
                        Visibility="{Binding HasOverlay, Converter={StaticResource BoolToVis}}"/>

        <!-- Nav leave confirm -->
        <Grid Grid.RowSpan="4" Panel.ZIndex="200" Background="#99000000"
              Visibility="{Binding ShowNavLeaveConfirm, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource DC.Bg.Card}" CornerRadius="8" MaxWidth="400"
                    Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{StaticResource DC.Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Imate nepopunjene podatke u formi"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource DC.Text.Primary}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="Da li ste sigurni da želite da napustite trenutnu formu? Sve unesene podatke ćete izgubiti."
                               FontSize="13" Foreground="{StaticResource DC.Text.Secondary}"
                               TextWrapping="Wrap" Margin="0,0,0,24"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Ostani" Command="{Binding StayNavCommand}"
                                Style="{StaticResource DC.Btn.Ghost}"
                                Padding="20,8" FontSize="13" Margin="0,0,12,0"/>
                        <Button Content="Napusti" Command="{Binding ConfirmNavLeaveCommand}"
                                Style="{StaticResource DC.Btn.Danger}"
                                Padding="20,8" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Context help: floating "?" button + side panel -->
        <Grid Grid.Row="2" Panel.ZIndex="50">

            <!-- Help side panel (right side, visible when open) -->
            <Border Background="{StaticResource DC.Bg.Card}"
                    BorderBrush="{StaticResource DC.Border}" BorderThickness="1,0,0,0"
                    Width="360" HorizontalAlignment="Right"
                    Visibility="{Binding IsContextHelpOpen, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Panel header -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource DC.Border}" BorderThickness="0,0,0,1"
                            Background="{StaticResource DC.Bg.Subtle}" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource DC.Text.Primary}" TextWrapping="Wrap">
                                <Run Text="{Binding ContextHelpTutorial.Number, Mode=OneWay}"/>
                                <Run Text=". "/>
                                <Run Text="{Binding ContextHelpTutorial.Title, Mode=OneWay}"/>
                            </TextBlock>
                            <Button Grid.Column="1" Content="✕"
                                    Command="{Binding CloseContextHelpCommand}"
                                    Width="28" Height="28"
                                    Background="Transparent" BorderThickness="0"
                                    FontSize="13" Foreground="{StaticResource DC.Text.Caption}"
                                    Cursor="Hand" VerticalAlignment="Top" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Panel body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            <!-- Video player -->
                            <Border Height="210" CornerRadius="8" Background="#1C2B24" ClipToBounds="True">
                                <Grid>
                                    <MediaElement x:Name="SidebarVideoPlayer"
                                                  LoadedBehavior="Manual"
                                                  UnloadedBehavior="Stop"
                                                  Stretch="Uniform"
                                                  MediaOpened="SidebarVideo_MediaOpened"
                                                  MediaEnded="SidebarVideo_MediaEnded"/>
                                    <!-- Poster (prikazuje se prije pokretanja umjesto crnog) -->
                                    <Border x:Name="SidebarPoster" Cursor="Hand"
                                            MouseLeftButtonUp="SidebarPoster_Click">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#1E3A2F" Offset="0"/>
                                                <GradientStop Color="#2D5A45" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid>
                                            <fa:IconImage Icon="{Binding ContextHelpTutorial.Icon}"
                                                          Width="80" Height="80"
                                                          Foreground="{StaticResource DC.Accent}"
                                                          Opacity="0.20"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                            <Border Width="56" Height="56" CornerRadius="28"
                                                    Background="#CCFFFFFF"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="▶" FontSize="22" Foreground="#1E3A2F"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Margin="4,0,0,0"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <!-- Controls overlay -->
                                    <Border VerticalAlignment="Bottom" Background="#CC000000" Padding="10,8">
                                        <StackPanel>
                                            <!-- Seek bar -->
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="SidebarSeek" Grid.Column="0"
                                                        Minimum="0" Maximum="1" Value="0"
                                                        IsMoveToPointEnabled="True"
                                                        VerticalAlignment="Center"
                                                        PreviewMouseLeftButtonDown="SidebarSeek_DragStart"
                                                        PreviewMouseLeftButtonUp="SidebarSeek_DragEnd"/>
                                                <TextBlock x:Name="SidebarTime" Grid.Column="1"
                                                           Text="0:00 / 0:00" FontSize="9"
                                                           Foreground="White" Opacity="0.85"
                                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                            <!-- Buttons row -->
                                            <DockPanel LastChildFill="False">
                                                <Button x:Name="SidebarPlayPauseBtn" Content="▶"
                                                        Click="SidebarPlayPause_Click"
                                                        FontSize="12" Foreground="White"
                                                        Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand" Padding="3,2" DockPanel.Dock="Left"
                                                        ToolTip="Pusti / Pauziraj"/>
                                                <Button Content="■" Click="SidebarStopBtn_Click"
                                                        FontSize="11" Foreground="White"
                                                        Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand" Padding="3,2" DockPanel.Dock="Left"
                                                        Margin="4,0,0,0" ToolTip="Zaustavi"/>
                                                <Button Click="SidebarFullscreen_Click"
                                                        Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand" Padding="3,2" DockPanel.Dock="Right"
                                                        ToolTip="Puni ekran (Esc za izlaz)">
                                                    <fa:IconImage Icon="Expand" Width="11" Height="11" Foreground="White"/>
                                                </Button>
                                                <Button x:Name="SidebarSpeedBtn" Content="1.0x"
                                                        Click="SidebarSpeed_Click"
                                                        FontSize="9" Foreground="White"
                                                        Background="#44FFFFFF" BorderThickness="0"
                                                        Cursor="Hand" Padding="5,2" DockPanel.Dock="Right"
                                                        Margin="0,0,6,0" ToolTip="Brzina reprodukcije"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Description -->
                            <TextBlock FontSize="12" Foreground="{StaticResource DC.Text.Secondary}"
                                       TextWrapping="Wrap" Margin="0,10,0,12">
                                <Run Text="U ovom tutorijalu se prikazuje uputstvo za Vašu trenutnu stranicu — "/>
                                <Run Text="{Binding ContextHelpTutorial.Title, Mode=OneWay}"
                                     FontWeight="SemiBold" Foreground="{StaticResource DC.Text.Primary}"/>
                            </TextBlock>

                            <!-- Open help center -->
                            <Button Content="Otvori tutorijal centar"
                                    Command="{Binding OpenHelpCenterCommand}"
                                    Style="{StaticResource DC.Btn.Primary}"
                                    HorizontalAlignment="Stretch"
                                    Padding="0,10" FontSize="13"/>

                            <!-- Window shortcuts -->
                            <Border Height="1" Background="{StaticResource DC.Border}" Margin="0,14"/>
                            <TextBlock Text="Prečice za dati prozor"
                                       FontSize="12" FontWeight="SemiBold" FontStyle="Italic"
                                       Foreground="{StaticResource DC.Text.Secondary}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding ContextHelpTutorial.WindowShortcuts}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,8,10">
                                            <Border Background="{StaticResource DC.Bg.Subtle}"
                                                    BorderBrush="{StaticResource DC.Border}" BorderThickness="1"
                                                    CornerRadius="4" Padding="5,2" HorizontalAlignment="Left"
                                                    Margin="0,0,0,2">
                                                <TextBlock Text="{Binding Keys}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource DC.Text.Primary}"
                                                           FontFamily="Consolas"/>
                                            </Border>
                                            <TextBlock Text="{Binding Description}" FontSize="11"
                                                       Foreground="{StaticResource DC.Text.Secondary}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Floating "?" button (visible when panel closed and not on Help tab) -->
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsContextHelpOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ShowContextHelpButton}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Pritisni F1 za pomoć" FontSize="10"
                           Foreground="{StaticResource DC.Text.Caption}"
                           HorizontalAlignment="Right" Margin="0,0,0,4"/>
                <Button Width="44" Height="44" HorizontalAlignment="Right"
                        Command="{Binding ToggleContextHelpCommand}" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Width="44" Height="44" CornerRadius="22"
                                    Background="{StaticResource DC.Primary}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background"
                                            Value="{StaticResource DC.Primary.Hover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="?" FontSize="20" FontWeight="Bold" Foreground="White"/>
                </Button>
            </StackPanel>

        </Grid>

    </Grid>
</Window>
