<Window x:Class="CommunityHub.Ui.Views.DistrictCoordinator.CoordinatorHomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CommunityHub.Ui.ViewModels.DistrictCoordinator"
        xmlns:local="clr-namespace:CommunityHub.Ui.Views.DistrictCoordinator"
        Title="Naziv Aplikacije" Height="780" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate DataType="{x:Type vm:HomeContentViewModel}">
            <local:HomeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccessRequestsViewModel}">
            <local:AccessRequestsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatisticsViewModel}">
            <local:StatisticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DistrictRegistrationViewModel}">
            <local:DistrictRegistrationOverlay/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ForumViewModel}">
            <local:ForumView/>
        </DataTemplate>

        <Style x:Key="NavTabStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#2C3E50"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14,10"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- top bar -->
            <RowDefinition Height="Auto"/>  <!-- nav tabs -->
            <RowDefinition Height="*"/>     <!-- content -->
            <RowDefinition Height="Auto"/>  <!-- footer -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="White" Margin="20,16,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Width="36" Height="36" BorderBrush="#2C3E50" BorderThickness="1"
                        CornerRadius="18" Margin="0,0,10,0">
                    <TextBlock Text="i" FontSize="18" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="#2C3E50"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="Naziv Aplikacije" FontSize="14" FontWeight="SemiBold"
                               Foreground="#2C3E50"/>
                    <TextBlock Text="Klikom na logo/naziv aplikacije"
                               FontSize="10" Foreground="#888"/>
                    <TextBlock Text="imate uvid u sve kvartove"
                               FontSize="10" Foreground="#888"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Column="1" FontSize="22" FontWeight="Bold" Foreground="#2C3E50"
                       VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Moji kvartovi"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRequestsTab}" Value="True">
                                <Setter Property="Text" Value="Zahtevi"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsStatsTab}" Value="True">
                                <Setter Property="Text" Value="Statistika"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsForumTab}" Value="True">
                                <Setter Property="Text" Value="Forum"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Header.SavedAtText}" FontSize="11" Foreground="#888"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Border Width="36" Height="36" Background="#2C3E50" CornerRadius="18"
                        Margin="0,0,8,0">
                    <TextBlock Text="{Binding Header.Initials}" Foreground="White"
                               FontWeight="Bold" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Header.FullName}"
                               FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50"/>
                    <TextBlock Text="Koordinator" FontSize="11" Foreground="#888"/>
                </StackPanel>
                <Button Content="Odjavi se"
                        Command="{Binding LogoutCommand}"
                        Padding="10,4" FontSize="11" Margin="16,0,0,0"
                        Background="Transparent" Foreground="#2C3E50"
                        BorderBrush="#BDC3C7" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="0,1,0,1"
                Background="White">
            <StackPanel Orientation="Horizontal" Margin="20,0">


                <Grid>
                    <Button Content="Moji kvartovi"
                            Command="{Binding SwitchTabCommand}" CommandParameter="home">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavTabStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHomeTab}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Height="2" Background="#2C3E50" VerticalAlignment="Bottom"
                            Visibility="{Binding IsHomeTab, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <Grid>
                    <Button Content="Zahtevi"
                            Command="{Binding SwitchTabCommand}" CommandParameter="requests">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavTabStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRequestsTab}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Height="2" Background="#2C3E50" VerticalAlignment="Bottom"
                            Visibility="{Binding IsRequestsTab, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <Grid>
                    <Button Content="Statistika"
                            Command="{Binding SwitchTabCommand}" CommandParameter="stats">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavTabStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatsTab}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Height="2" Background="#2C3E50" VerticalAlignment="Bottom"
                            Visibility="{Binding IsStatsTab, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <Grid>
                    <Button Content="Forum"
                            Command="{Binding SwitchTabCommand}" CommandParameter="forum">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavTabStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsForumTab}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Height="2" Background="#2C3E50" VerticalAlignment="Bottom"
                            Visibility="{Binding IsForumTab, Converter={StaticResource BoolToVis}}"/>
                </Grid>
                <Button Content="Rezervacije"  Style="{StaticResource NavTabStyle}"
                        Command="{Binding NotImplementedTabCommand}" CommandParameter="Rezervacije"/>
                <Button Content="Recenzije"    Style="{StaticResource NavTabStyle}"
                        Command="{Binding NotImplementedTabCommand}" CommandParameter="Recenzije"/>
                <Button Content="Poklon grada" Style="{StaticResource NavTabStyle}"
                        Command="{Binding NotImplementedTabCommand}" CommandParameter="Poklon grada"/>
                <Button Content="Pomoc"        Style="{StaticResource NavTabStyle}"
                        Command="{Binding NotImplementedTabCommand}" CommandParameter="Pomoc"/>
            </StackPanel>
        </Border>

        <ContentControl Grid.Row="2" Content="{Binding CurrentTabContent}"/>

        <Border Grid.Row="3" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
                Background="#FAFAFA" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,32,0">
                    <TextBlock Text="Saldo:" FontSize="11" Foreground="#666"/>
                    <TextBlock Text="{Binding Header.TotalBudgetDisplay}" FontSize="13"
                               FontWeight="SemiBold" Foreground="#2C3E50"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,32,0">
                    <TextBlock Text="Ukupno donacija:" FontSize="11" Foreground="#666"/>
                    <TextBlock Text="—" FontSize="13"
                               FontWeight="SemiBold" Foreground="#2C3E50"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Ukupno troskova:" FontSize="11" Foreground="#666"/>
                    <TextBlock Text="—" FontSize="13"
                               FontWeight="SemiBold" Foreground="#2C3E50"/>
                </StackPanel>

                <TextBlock Grid.Column="4" Text="{Binding Header.FooterInfo}"
                           FontSize="11" Foreground="#444"
                           HorizontalAlignment="Right" TextAlignment="Right"/>
            </Grid>
        </Border>

        <ContentControl Grid.RowSpan="4" Panel.ZIndex="100"
                        Content="{Binding ActiveOverlay}"
                        Visibility="{Binding HasOverlay, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</Window>
