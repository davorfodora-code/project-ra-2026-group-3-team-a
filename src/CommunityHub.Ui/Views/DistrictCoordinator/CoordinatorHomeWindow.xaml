<Window x:Class="CommunityHub.Ui.Views.DistrictCoordinator.CoordinatorHomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CommunityHub.Ui.ViewModels.DistrictCoordinator"
        xmlns:local="clr-namespace:CommunityHub.Ui.Views.DistrictCoordinator"
        Title="Naziv Aplikacije" Height="780" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBackground}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate DataType="{x:Type vm:HomeContentViewModel}">
            <local:HomeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccessRequestsViewModel}">
            <local:AccessRequestsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatisticsViewModel}">
            <local:StatisticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DistrictRegistrationViewModel}">
            <local:DistrictRegistrationOverlay/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ForumViewModel}">
            <local:ForumView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReservationsViewModel}">
            <local:ReservationsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReservationDialogViewModel}">
            <local:ReservationDialogView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReviewsViewModel}">
            <local:ReviewsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FinancesViewModel}">
            <local:FinancesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CityGiftsViewModel}">
            <local:CityGiftsView/>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- top bar -->
            <RowDefinition Height="Auto"/>  <!-- nav tabs -->
            <RowDefinition Height="*"/>     <!-- content -->
            <RowDefinition Height="Auto"/>  <!-- footer -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource BrushCard}" Margin="20,16,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Width="36" Height="36" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                        CornerRadius="18" Margin="0,0,10,0">
                    <TextBlock Text="i" FontSize="18" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="{StaticResource BrushTextPrimary}"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="Naziv Aplikacije" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="Klikom na logo/naziv aplikacije"
                               FontSize="10" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Text="imate uvid u sve kvartove"
                               FontSize="10" Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Column="1" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"
                       VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Moji kvartovi"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRequestsTab}" Value="True">
                                <Setter Property="Text" Value="Zahtevi"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsStatsTab}" Value="True">
                                <Setter Property="Text" Value="Statistika"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsForumTab}" Value="True">
                                <Setter Property="Text" Value="Forum"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsReservationsTab}" Value="True">
                                <Setter Property="Text" Value="Rezervacije"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsReviewsTab}" Value="True">
                                <Setter Property="Text" Value="Recenzije"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFinancesTab}" Value="True">
                                <Setter Property="Text" Value="Finansije kvarta"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCityGiftsTab}" Value="True">
                                <Setter Property="Text" Value="Poklon grada"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Header.SavedAtText}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Border Width="36" Height="36" Background="{StaticResource BrushSurface}" CornerRadius="18"
                        Margin="0,0,8,0">
                    <TextBlock Text="{Binding Header.Initials}" Foreground="{StaticResource BrushTextPrimary}"
                               FontWeight="Bold" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Header.FullName}"
                               FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="Koordinator" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>
                <Button Content="Odjavi se"
                        Command="{Binding LogoutCommand}"
                        Padding="10,4" FontSize="11" Margin="16,0,0,0"
                        Background="Transparent" Foreground="{StaticResource BrushTextPrimary}"
                        BorderBrush="{StaticResource BrushBorder}" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,1"
                Background="{StaticResource BrushCard}">
            <StackPanel Orientation="Horizontal" Margin="20,0">

                <Grid>
                    <Button Content="Finansije kvarta"
                            Command="{Binding SwitchTabCommand}" CommandParameter="finances">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavTabStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFinancesTab}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Height="2" Background="{StaticResource BrushAccent}" VerticalAlignment="Bottom"
                            Visibility="{Binding IsFinancesTab, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <Grid>
                    <Button Content="Moji kvartovi"
                            Command="{Binding SwitchTabCommand}" CommandParameter="home">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavTabStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHomeTab}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Height="2" Background="{StaticResource BrushAccent}" VerticalAlignment="Bottom"
                            Visibility="{Binding IsHomeTab, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <Grid>
                    <Button Content="Zahtevi"
                            Command="{Binding SwitchTabCommand}" CommandParameter="requests">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavTabStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRequestsTab}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Height="2" Background="{StaticResource BrushAccent}" VerticalAlignment="Bottom"
                            Visibility="{Binding IsRequestsTab, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <Grid>
                    <Button Content="Statistika"
                            Command="{Binding SwitchTabCommand}" CommandParameter="stats">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavTabStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatsTab}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Height="2" Background="{StaticResource BrushAccent}" VerticalAlignment="Bottom"
                            Visibility="{Binding IsStatsTab, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <Grid>
                    <Button Content="Forum"
                            Command="{Binding SwitchTabCommand}" CommandParameter="forum">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavTabStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsForumTab}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Height="2" Background="{StaticResource BrushAccent}" VerticalAlignment="Bottom"
                            Visibility="{Binding IsForumTab, Converter={StaticResource BoolToVis}}"/>
                </Grid>
                <Grid>
                    <Button Content="Rezervacije"
                            Command="{Binding SwitchTabCommand}" CommandParameter="reservations">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavTabStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReservationsTab}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Height="2" Background="{StaticResource BrushAccent}" VerticalAlignment="Bottom"
                            Visibility="{Binding IsReservationsTab, Converter={StaticResource BoolToVis}}"/>
                </Grid>
                <Grid>
                    <Button Content="Recenzije"
                            Command="{Binding SwitchTabCommand}" CommandParameter="reviews">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavTabStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReviewsTab}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Height="2" Background="{StaticResource BrushAccent}" VerticalAlignment="Bottom"
                            Visibility="{Binding IsReviewsTab, Converter={StaticResource BoolToVis}}"/>
                </Grid>
                <Grid>
                    <Button Content="Poklon grada"
                            Command="{Binding SwitchTabCommand}" CommandParameter="citygifts">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavTabStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCityGiftsTab}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Height="2" Background="{StaticResource BrushAccent}" VerticalAlignment="Bottom"
                            Visibility="{Binding IsCityGiftsTab, Converter={StaticResource BoolToVis}}"/>
                </Grid>
                <Button Content="Pomoc"        Style="{StaticResource NavTabStyle}"
                        Command="{Binding NotImplementedTabCommand}" CommandParameter="Pomoc"/>
            </StackPanel>
        </Border>

        <ContentControl Grid.Row="2" Content="{Binding CurrentTabContent}"/>

        <Border Grid.Row="3" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
                Background="{StaticResource BrushBackground}" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,32,0">
                    <TextBlock Text="Saldo:" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Text="{Binding Header.TotalBudgetDisplay}" FontSize="13"
                               FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,32,0">
                    <TextBlock Text="Ukupno donacija:" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Text="—" FontSize="13"
                               FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Ukupno troskova:" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Text="—" FontSize="13"
                               FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                </StackPanel>

                <TextBlock Grid.Column="4" Text="{Binding Header.FooterInfo}"
                           FontSize="11" Foreground="{StaticResource BrushTextSecondary}"
                           HorizontalAlignment="Right" TextAlignment="Right"/>
            </Grid>
        </Border>

        <ContentControl Grid.RowSpan="4" Panel.ZIndex="100"
                        Content="{Binding ActiveOverlay}"
                        Visibility="{Binding HasOverlay, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</Window>
