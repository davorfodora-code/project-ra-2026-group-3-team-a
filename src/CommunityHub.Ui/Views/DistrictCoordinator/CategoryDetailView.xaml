<UserControl x:Class="CommunityHub.Ui.Views.DistrictCoordinator.CategoryDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/DistrictCoordinator/DistrictCoordinatorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#99000000">
        <Border Background="{StaticResource DC.Bg.Card}" CornerRadius="8" Width="760" Height="560"
                Margin="40" VerticalAlignment="Center" HorizontalAlignment="Center"
                BorderBrush="{StaticResource DC.Border}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Background="{StaticResource DC.Bg.Subtle}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding CategoryName, Mode=OneWay}"
                               Margin="20,14" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource DC.Text.Primary}"/>
                    <Button Grid.Column="1" Content="✕" Command="{Binding CloseCommand}"
                            Width="32" Height="32" Background="Transparent" BorderThickness="0"
                            FontSize="14" Foreground="{StaticResource DC.Text.Caption}" Cursor="Hand" Margin="0,8,12,8"/>
                </Grid>

                <!-- Content -->
                <Grid Grid.Row="1" Margin="24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Donations -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Donacije" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource DC.Text.Primary}" Margin="0,0,0,8"/>
                        <Border BorderBrush="{StaticResource DC.Border}" BorderThickness="1" CornerRadius="4">
                            <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Donations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="10,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding AmountDisplay, Mode=OneWay}"
                                                           FontSize="13" Foreground="{StaticResource DC.Success}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DateDisplay, Mode=OneWay}"
                                                           FontSize="11" Foreground="{StaticResource DC.Text.Caption}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <TextBlock Text="Nema donacija za odabrani period."
                                   FontSize="12" Foreground="{StaticResource DC.Text.Caption}" Margin="4,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Donations.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Expenses -->
                    <StackPanel Grid.Column="2">
                        <DockPanel Margin="0,0,0,8" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="Troškovi"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource DC.Text.Primary}"/>
                            <Button DockPanel.Dock="Right" Content="+ Novi trosak"
                                    Command="{Binding AddExpenseCommand}"
                                    Style="{StaticResource DC.Btn.Secondary}"
                                    Padding="10,4" FontSize="11"/>
                        </DockPanel>
                        <Border BorderBrush="{StaticResource DC.Border}" BorderThickness="1" CornerRadius="4">
                            <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Expenses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Cursor="Hand" Margin="0,0,0,1"
                                                    BorderBrush="{StaticResource DC.Border}" BorderThickness="0,0,0,1">
                                                <Button Command="{Binding DataContext.ViewExpenseCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0"
                                                        HorizontalContentAlignment="Stretch" Cursor="Hand">
                                                    <Grid Margin="10,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding AmountDisplay, Mode=OneWay}"
                                                                   FontSize="13" Foreground="{StaticResource DC.Danger}"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding DateDisplay, Mode=OneWay}"
                                                                   FontSize="11" Foreground="{StaticResource DC.Text.Caption}"
                                                                   VerticalAlignment="Center" Margin="8,0"/>
                                                        <TextBlock Grid.Column="2" Text="Detalji ->"
                                                                   FontSize="11" Foreground="{StaticResource DC.Accent}"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Button>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <TextBlock Text="Nema troškova za odabrani period."
                                   FontSize="12" Foreground="{StaticResource DC.Text.Caption}" Margin="4,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Expenses.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="2" BorderBrush="{StaticResource DC.Border}" BorderThickness="0,1,0,0" Padding="24,14">
                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="Nazad" Command="{Binding BackCommand}"
                                Style="{StaticResource DC.Btn.Ghost}" Padding="20,8" FontSize="13"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
