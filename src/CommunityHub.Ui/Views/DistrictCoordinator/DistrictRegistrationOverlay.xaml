<UserControl x:Class="CommunityHub.Ui.Views.DistrictCoordinator.DistrictRegistrationOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ValidationLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="Margin"       Value="0,0,0,10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground"   Value="Red"/>
            <Setter Property="Visibility"   Value="Collapsed"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#99000000">
        <Border Background="White" CornerRadius="8" MaxWidth="700" MinHeight="420"
                MaxHeight="560"
                Margin="40" VerticalAlignment="Center" HorizontalAlignment="Center"
                BorderBrush="#CCC" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="#F8F9FA" Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Registracija kvarta"
                               Margin="20,12" FontSize="14" FontWeight="SemiBold"
                               Foreground="#2C3E50" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding StepIndicator}"
                               FontSize="14" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#2C3E50"/>
                    <TextBlock Grid.Column="2" Text="Proces je potrebno izvršiti u 3 koraka"
                               Margin="0,12,20,12" FontSize="11" Foreground="#888"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="3"
                            Command="{Binding CancelCommand}"
                            Content="✕" Width="32" Height="32"
                            Background="Transparent" BorderThickness="0"
                            FontSize="14" Foreground="#888" Cursor="Hand"
                            Margin="0,8,12,8"/>
                </Grid>

                <Grid Grid.Row="1" Margin="24,16">
 
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Naziv kvarta" FontSize="13" Margin="0,0,0,4"/>
                            <TextBox Height="32" FontSize="13" Padding="6,4" Margin="0,0,0,4"
                                     Text="{Binding BasicInfo.Name, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource ValidationLabelStyle}"
                                       Text="{Binding BasicInfo.NameError}"
                                       Visibility="{Binding BasicInfo.HasNameError, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Text="Opis kvarta" FontSize="13" Margin="0,0,0,4"/>
                            <TextBox Height="80" FontSize="13" Padding="6,4" Margin="0,0,0,4"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding BasicInfo.Description, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource ValidationLabelStyle}"
                                       Text="{Binding BasicInfo.DescriptionError}"
                                       Visibility="{Binding BasicInfo.HasDescriptionError, Converter={StaticResource BoolToVis}}"/>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Grad" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBox Height="32" FontSize="13" Padding="6,4"
                                             Text="{Binding BasicInfo.City, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource ValidationLabelStyle}"
                                               Text="{Binding BasicInfo.CityError}"
                                               Visibility="{Binding BasicInfo.HasCityError, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Država" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBox Height="32" FontSize="13" Padding="6,4"
                                             Text="{Binding BasicInfo.Country, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource ValidationLabelStyle}"
                                               Text="{Binding BasicInfo.CountryError}"
                                               Visibility="{Binding BasicInfo.HasCountryError, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>


                    <Grid Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E0E0E0"
                                BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Naziv ulice"
                                           FontSize="11" Foreground="#666" Margin="0,0,8,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Od br."
                                           FontSize="11" Foreground="#666" Margin="0,0,8,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Do br."
                                           FontSize="11" Foreground="#666" Margin="0,0,8,2"/>

                                <TextBox Grid.Row="1" Grid.Column="0" Height="32" FontSize="13"
                                         Padding="6,4" Margin="0,0,8,0"
                                         Text="{Binding StreetForm.StreetName, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Height="32" FontSize="13"
                                         Padding="6,4" Margin="0,0,8,0"
                                         Text="{Binding StreetForm.StreetStart, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Row="1" Grid.Column="2" Height="32" FontSize="13"
                                         Padding="6,4" Margin="0,0,8,0"
                                         Text="{Binding StreetForm.StreetEnd, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Row="1" Grid.Column="3" Content="Dodaj ulicu"
                                        Command="{Binding StreetForm.AddStreetCommand}"
                                        Height="32" Padding="12,0" FontSize="12"
                                        Background="#2C3E50" Foreground="White"
                                        BorderThickness="0" Cursor="Hand"/>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding StreetForm.Streets}"
                                  AutoGenerateColumns="False" IsReadOnly="False"
                                  CanUserAddRows="False" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderBrush="#DDDDDD" BorderThickness="1"
                                  CanUserResizeRows="False"
                                  RowBackground="White" AlternatingRowBackground="#FAFAFA">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Naziv ulice" Binding="{Binding StreetName}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Od broja"    Binding="{Binding StartNumber}" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Do broja"    Binding="{Binding EndNumber}"   Width="90" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Akcija" Width="80" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Ukloni"
                                                    Command="{Binding DataContext.StreetForm.RemoveStreetCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,2" FontSize="11"
                                                    Background="#E74C3C" Foreground="White"
                                                    BorderThickness="0" Cursor="Hand"
                                                    HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="2" Foreground="Red" FontSize="11" Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Text="{Binding StreetForm.StreetError}"
                                   Visibility="{Binding StreetForm.HasStreetError, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <Grid Visibility="{Binding IsStep3, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Kliknite na slot da dodate sliku (opciono)."
                                   FontSize="12" Foreground="#666" Margin="0,0,0,12"/>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding ImageSlots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="6" Cursor="Hand" CornerRadius="4" BorderThickness="1">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.PickImageCommand,
                                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"  Value="#F5F5F5"/>
                                                <Setter Property="BorderBrush" Value="#CCCCCC"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                        <Setter Property="Background"  Value="#E8F8F5"/>
                                                        <Setter Property="BorderBrush" Value="Green"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Margin="0,30">
                                            <TextBlock FontSize="32" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text"       Value="+"/>
                                                        <Setter Property="Foreground" Value="#999"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                                <Setter Property="Text"       Value="✓"/>
                                                                <Setter Property="Foreground" Value="Green"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="11"
                                                       Foreground="#2C3E50" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Grid.Row="2"
                                   Text="Slike su opcione. Možete registrovati kvart i bez njih."
                                   FontSize="11" Foreground="#666" Margin="0,8,0,0"/>
                    </Grid>
                </Grid>

                <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#E0E0E0"
                        BorderThickness="0,1,0,0" Padding="24,12">
                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="Otkaži"
                                Command="{Binding CancelCommand}"
                                Width="90" Height="32" FontSize="13"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Nazad"
                                    Command="{Binding BackStepCommand}"
                                    Width="90" Height="32" FontSize="13" Margin="0,0,8,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{Binding NextButtonText}"
                                    Command="{Binding NextStepCommand}"
                                    Width="130" Height="32" FontSize="13"
                                    Background="#2C3E50" Foreground="White" BorderThickness="0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
