<UserControl x:Class="CommunityHub.Ui.Views.DistrictCoordinator.DistrictRegistrationOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/DistrictCoordinator/DistrictCoordinatorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <Style x:Key="ValidationLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize"     Value="11"/>
                <Setter Property="Margin"       Value="0,0,0,10"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Foreground"   Value="{StaticResource DC.Danger}"/>
                <Setter Property="Visibility"   Value="Collapsed"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#99000000">
        <Border Background="{StaticResource DC.Bg.Card}" CornerRadius="8" Width="700" Height="650"
                Margin="40" VerticalAlignment="Center" HorizontalAlignment="Center"
                BorderBrush="{StaticResource DC.Border}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource DC.Bg.Subtle}" CornerRadius="8,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Registracija kvarta"
                               Margin="20,14" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource DC.Text.Primary}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding StepIndicator}"
                               FontSize="14" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource DC.Accent}"/>
                    <TextBlock Grid.Column="2" Text="Proces je potrebno izvršiti u 3 koraka"
                               Margin="0,14,20,14" FontSize="11" Foreground="{StaticResource DC.Text.Caption}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="3"
                            Command="{Binding CancelCommand}"
                            Content="✕" Width="32" Height="32"
                            Background="Transparent" BorderThickness="0"
                            FontSize="14" Foreground="{StaticResource DC.Text.Caption}" Cursor="Hand"
                            Margin="0,8,12,8"/>
                </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="24,16">
 
                    <StackPanel VerticalAlignment="Top"
                                Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Naziv kvarta" FontSize="13" Foreground="{StaticResource DC.Text.Secondary}"
                                       FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource DC.Input}" Margin="0,0,0,4"
                                     Text="{Binding BasicInfo.Name, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource ValidationLabelStyle}"
                                       Text="{Binding BasicInfo.NameError}"
                                       Visibility="{Binding BasicInfo.HasNameError, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Text="Opis kvarta" FontSize="13" Foreground="{StaticResource DC.Text.Secondary}"
                                       FontWeight="SemiBold" Margin="0,4,0,6"/>
                            <TextBox Style="{StaticResource DC.Input.Multiline}" Height="80" Margin="0,0,0,4"
                                     Text="{Binding BasicInfo.Description, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource ValidationLabelStyle}"
                                       Text="{Binding BasicInfo.DescriptionError}"
                                       Visibility="{Binding BasicInfo.HasDescriptionError, Converter={StaticResource BoolToVis}}"/>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Grad" FontSize="13" Foreground="{StaticResource DC.Text.Secondary}"
                                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox Style="{StaticResource DC.Input}"
                                             Text="{Binding BasicInfo.City, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource ValidationLabelStyle}"
                                               Text="{Binding BasicInfo.CityError}"
                                               Visibility="{Binding BasicInfo.HasCityError, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Država" FontSize="13" Foreground="{StaticResource DC.Text.Secondary}"
                                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox Style="{StaticResource DC.Input}"
                                             Text="{Binding BasicInfo.Country, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource ValidationLabelStyle}"
                                               Text="{Binding BasicInfo.CountryError}"
                                               Visibility="{Binding BasicInfo.HasCountryError, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Info notice -->
                            <Border Background="{StaticResource DC.Accent.Light}" CornerRadius="6"
                                    BorderBrush="{StaticResource DC.Accent}" BorderThickness="1"
                                    Padding="12,9" Margin="0,16,0,0">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" Text="i" FontWeight="Bold"
                                               Foreground="{StaticResource DC.Accent}"
                                               FontSize="14" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource DC.Accent}">
                                        Registrovani kvart prolazi kroz verifikaciju pre aktivacije. Preuzimate odgovornost koordinatora za sve kvartove koje registrujete.
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                    </StackPanel>

                    <Grid Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource DC.Panel}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Naziv ulice"
                                           FontSize="11" Foreground="{StaticResource DC.Text.Secondary}" Margin="0,0,8,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Od br."
                                           FontSize="11" Foreground="{StaticResource DC.Text.Secondary}" Margin="0,0,8,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Do br."
                                           FontSize="11" Foreground="{StaticResource DC.Text.Secondary}" Margin="0,0,8,2"/>

                                <TextBox Grid.Row="1" Grid.Column="0"
                                         Style="{StaticResource DC.Input}" Margin="0,0,8,0"
                                         Text="{Binding StreetForm.StreetName, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Style="{StaticResource DC.Input}" Margin="0,0,8,0"
                                         Text="{Binding StreetForm.StreetStart, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Row="1" Grid.Column="2"
                                         Style="{StaticResource DC.Input}" Margin="0,0,8,0"
                                         Text="{Binding StreetForm.StreetEnd, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Row="1" Grid.Column="3" Content="Dodaj ulicu"
                                        Command="{Binding StreetForm.AddStreetCommand}"
                                        Style="{StaticResource DC.Btn.Dark}"
                                        Height="32" Padding="12,0" FontSize="12"/>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding StreetForm.Streets}"
                                  Style="{StaticResource DC.DataGrid}"
                                  AutoGenerateColumns="False" IsReadOnly="False"
                                  CanUserAddRows="False" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Naziv ulice" Binding="{Binding StreetName}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Od broja"    Binding="{Binding StartNumber}" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Do broja"    Binding="{Binding EndNumber}"   Width="90" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Akcija" Width="80" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Ukloni"
                                                    Command="{Binding DataContext.StreetForm.RemoveStreetCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DC.Btn.Danger}"
                                                    Padding="6,2" FontSize="11"
                                                    HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="2" Foreground="{StaticResource DC.Danger}" FontSize="11" Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Text="{Binding StreetForm.StreetError}"
                                   Visibility="{Binding StreetForm.HasStreetError, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <Grid Visibility="{Binding IsStep3, Converter={StaticResource BoolToVis}}"
                          VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Big "+" add area -->
                        <Border Grid.Row="0" CornerRadius="8"
                                Background="{StaticResource DC.Accent.Light}"
                                BorderBrush="{StaticResource DC.Accent}" BorderThickness="1"
                                Cursor="Hand" Padding="0,22" Margin="0,0,0,16">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding AddImageSlotCommand}"/>
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="50" Height="50" CornerRadius="25"
                                        Background="{StaticResource DC.Accent}"
                                        HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock Text="+" FontSize="28" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="0,-2,0,0"/>
                                </Border>
                                <TextBlock Text="Kliknite da dodate slike" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource DC.Accent}" HorizontalAlignment="Center"/>
                                <TextBlock Text="JPG, PNG, BMP, GIF — možete odabrati više odjednom"
                                           FontSize="11" Foreground="{StaticResource DC.Text.Caption}"
                                           HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Thumbnails -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="270">
                            <ItemsControl ItemsSource="{Binding ImageSlots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="150" Height="118" Margin="0,0,10,10"
                                                CornerRadius="8" ClipToBounds="True"
                                                BorderBrush="{StaticResource DC.Border.Strong}"
                                                BorderThickness="1">
                                            <Grid>
                                                <!-- Image preview -->
                                                <Border>
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding FilePath, Converter={StaticResource ImagePathConverter}}"
                                                                    Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>
                                                <!-- Remove button (top-right) -->
                                                <Button Width="24" Height="24"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="0,6,6,0"
                                                        Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand"
                                                        Command="{Binding DataContext.RemoveImageCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bg" Width="24" Height="24" CornerRadius="12"
                                                                    Background="#CC000000">
                                                                <TextBlock Text="✕" FontSize="10" FontWeight="Bold"
                                                                           Foreground="White"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bg" Property="Background"
                                                                            Value="{StaticResource DC.Danger}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Hint -->
                        <TextBlock Grid.Row="2"
                                   Text="Slike su opcione. Možete registrovati kvart i bez njih."
                                   FontSize="11" Foreground="{StaticResource DC.Text.Caption}" Margin="0,8,0,0"/>
                    </Grid>
                </Grid>

                <Border Grid.Row="2" Background="{StaticResource DC.Bg.Subtle}"
                        BorderBrush="{StaticResource DC.Border}"
                        BorderThickness="0,1,0,0" Padding="24,16"
                        CornerRadius="0,0,8,8">
                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="Otkaži"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource DC.Btn.Ghost}"
                                Padding="20,9" Height="38" FontSize="13"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Nazad"
                                    Command="{Binding BackStepCommand}"
                                    Height="38" Padding="20,9" FontSize="13" Margin="0,0,10,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource DC.Btn.Ghost}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{Binding NextButtonText}"
                                    Command="{Binding NextStepCommand}"
                                    Style="{StaticResource DC.Btn.Primary}"
                                    Padding="24,9" Height="38" FontSize="13"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
