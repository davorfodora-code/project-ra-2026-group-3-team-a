<UserControl x:Class="CommunityHub.Ui.Views.DistrictCoordinator.CityGiftsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CommunityHub.Ui.ViewModels.DistrictCoordinator"
             xmlns:local="clr-namespace:CommunityHub.Ui.Views.DistrictCoordinator">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate DataType="{x:Type vm:RegisterForGiftViewModel}">
            <local:RegisterForGiftView/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,18" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="← Vrati se na finansije kvarta"
                    Command="{Binding BackToFinancesCommand}"
                    Background="Transparent" BorderBrush="#BDC3C7" BorderThickness="1"
                    Padding="14,7" FontSize="12" Foreground="#2C3E50" Cursor="Hand"/>
            <Button DockPanel.Dock="Right" Content="Osveži"
                    Command="{Binding RefreshCommand}"
                    Background="Transparent" BorderBrush="#BDC3C7" BorderThickness="1"
                    Padding="14,7" FontSize="12" Foreground="#2C3E50" Cursor="Hand"/>
        </DockPanel>

        <!-- Section title -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="Dostupni pokloni grada"
                       FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="Prijavite kvart za poklon grada — pobednik je kvart sa najmanji ukupnim budžetom."
                       FontSize="12" Foreground="#888" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Cards -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Gifts}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Card outer wrapper -->
                        <Border Margin="0,0,14,14" CornerRadius="10"
                                BorderThickness="1" Background="White">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#E0E4E8"/>
                            </Border.BorderBrush>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                                  Opacity="0.08" Direction="270" Color="#000000"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="5"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Colored top accent bar -->
                                <Border Grid.Row="0" CornerRadius="10,10,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#BDC3C7"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                    <Setter Property="Background" Value="#27AE60"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Awarded}" Value="True">
                                                    <Setter Property="Background" Value="#2980B9"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- Card body -->
                                <StackPanel Grid.Row="1" Margin="16,14,16,10">

                                    <!-- Status badge -->
                                    <Border HorizontalAlignment="Left" CornerRadius="10"
                                            Padding="9,4" Margin="0,0,0,12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F2F3F4"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                        <Setter Property="Background" Value="#E9F7EF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Awarded}" Value="True">
                                                        <Setter Property="Background" Value="#EBF5FB"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding BadgeText, Mode=OneWay}"
                                                   FontSize="10" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#7F8C8D"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                            <Setter Property="Foreground" Value="#1E8449"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Awarded}" Value="True">
                                                            <Setter Property="Foreground" Value="#1A5276"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Amount -->
                                    <TextBlock Text="{Binding AmountDisplay, Mode=OneWay}"
                                               FontSize="20" FontWeight="Bold" Foreground="#2C3E50"
                                               Margin="0,0,0,5"/>

                                    <!-- Gift name -->
                                    <TextBlock Text="{Binding Name, Mode=OneWay}"
                                               FontSize="12" Foreground="#666"
                                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                                    <!-- Deadline date -->
                                    <TextBlock FontSize="11" Foreground="#AAA">
                                        <Run Text="Rok: "/>
                                        <Run Text="{Binding DeadlineDisplay, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Card footer (separator + action) -->
                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="#ECF0F1"/>

                                    <Grid Grid.Row="1" Margin="16,12,16,14">

                                        <!-- "Prijavi se" / "Prijavi još (X/Y)" button -->
                                        <Button Content="{Binding RegisterButtonText, Mode=OneWay}"
                                                Command="{Binding RegisterCommand}"
                                                HorizontalAlignment="Stretch"
                                                Background="#2C3E50" Foreground="White"
                                                BorderThickness="0" Padding="0,9"
                                                FontSize="12" Cursor="Hand"
                                                Visibility="{Binding ShowRegisterButton, Converter={StaticResource BoolToVis}}"/>

                                        <!-- "✓ Svi kvartovi prijavljeni (X/Y)" -->
                                        <TextBlock Text="{Binding AllRegisteredText, Mode=OneWay}"
                                                   FontSize="12" Foreground="#27AE60" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding ShowAllRegistered, Converter={StaticResource BoolToVis}}"/>

                                        <!-- Rok istekao / Dodeljeno: X / Nema prijava -->
                                        <TextBlock Text="{Binding ClosedStatusText, Mode=OneWay}"
                                                   FontSize="12" Foreground="#7F8C8D"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding ShowClosedStatus, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Success notification -->
        <Border Grid.Row="3" Margin="0,12,0,0" HorizontalAlignment="Center"
                Background="#27AE60" CornerRadius="6" Padding="24,10"
                Visibility="{Binding HasNotification, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15" Direction="270"/>
            </Border.Effect>
            <TextBlock Text="{Binding NotificationText, Mode=OneWay}"
                       FontSize="13" FontStyle="Italic" FontWeight="SemiBold" Foreground="White"/>
        </Border>

        <!-- Dialog overlay -->
        <ContentControl Grid.RowSpan="4" Panel.ZIndex="10"
                        Content="{Binding ActiveDialog}"
                        Visibility="{Binding HasDialog, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</UserControl>
