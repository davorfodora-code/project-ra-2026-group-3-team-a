<Window x:Class="CommunityHub.Ui.Views.DistrictCoordinator.DistrictRegWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registracija kvarta" Height="650" Width="550"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Registracija kvarta" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

                <TextBlock Text="Naziv kvarta:" Margin="0,5,0,2"/>
                <TextBox x:Name="NameTextBox" Margin="0,0,0,5"/>

                <TextBlock Text="Opis:" Margin="0,5,0,2"/>
                <TextBox x:Name="DescriptionTextBox" Margin="0,0,0,5"
                         TextWrapping="Wrap" AcceptsReturn="True" Height="80"
                         VerticalScrollBarVisibility="Auto"/>

                <TextBlock Text="Grad:" Margin="0,5,0,2"/>
                <TextBox x:Name="CityTextBox" Margin="0,0,0,5"/>

                <TextBlock Text="Drzava:" Margin="0,5,0,2"/>
                <TextBox x:Name="CountryTextBox" Margin="0,0,0,5"/>

                <TextBlock Text="Broj ulica:" Margin="0,10,0,2" FontWeight="SemiBold"/>
                <TextBox x:Name="NumberOfStreetsTextBox" Margin="0,0,0,5"
                         TextChanged="NumberOfStreetsTextBox_TextChanged"/>

                <TextBlock Text="Ulice u kvartu:" Margin="0,10,0,2" FontWeight="SemiBold"/>
                <TextBlock Text="(za svaku ulicu unesite naziv, pocetni i krajnji broj)"
                           FontSize="11" Foreground="Gray" Margin="0,0,0,5"/>
                <StackPanel x:Name="StreetsPanel" Margin="0,0,0,5"/>

                <TextBlock Text="Slike kvarta:" Margin="0,10,0,2" FontWeight="SemiBold"/>
                <Button Content="Odaberi slike..." Click="SelectImagesButton_Click"
                        HorizontalAlignment="Left" Padding="10,5" Margin="0,0,0,5"/>
                <ListBox x:Name="ImagesListBox" Height="80" Margin="0,0,0,10"/>

                <TextBlock x:Name="ErrorTextBlock" Foreground="Red"
                           Visibility="Collapsed" Margin="0,0,0,10" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Registruj kvart" Click="RegisterButton_Click"
                            Padding="15,8" Margin="0,0,10,0" FontWeight="SemiBold"/>
                    <Button Content="Otkazi" Click="CancelButton_Click" Padding="15,8"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
