<UserControl x:Class="CommunityHub.Ui.Views.DistrictCoordinator.ReviewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="{StaticResource BrushTextPrimary}"/>
        </Style>

        <Style x:Key="CellTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="Foreground"   Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="StarStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource BrushWarning}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- back button -->
            <RowDefinition Height="Auto"/>  <!-- district selector + avg -->
            <RowDefinition Height="Auto"/>  <!-- table header -->
            <RowDefinition Height="*"/>     <!-- table rows -->
        </Grid.RowDefinitions>

        <!-- Back button -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Vrati se na finansije kvarta"
                    Background="Transparent" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                    Padding="12,6" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" Cursor="Hand"/>
        </DockPanel>

        <!-- District selector + average rating bar -->
        <Border Grid.Row="1" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6"
                Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- District selector -->
                <TextBlock Grid.Column="0" Text="Izaberite" FontSize="13"
                           Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Districts}"
                          SelectedItem="{Binding SelectedDistrict}"
                          Height="28" FontSize="13">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayText}" Margin="2,0"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Total count -->
                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}">
                    <Run Text="Ukupno recenzija: "/>
                    <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>

                <!-- Average rating -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Prosečna ocena" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding AverageStars, Mode=OneWay}"
                               Style="{StaticResource StarStyle}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding AverageDisplay, Mode=OneWay}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Table header -->
        <Border Grid.Row="2" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1,1,1,0">
            <Grid Margin="14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Ocena"    Style="{StaticResource HeaderTextStyle}"/>
                <TextBlock Grid.Column="1" Text="Komentar" Style="{StaticResource HeaderTextStyle}"/>
                <TextBlock Grid.Column="2" Text="Datum"    Style="{StaticResource HeaderTextStyle}"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Table rows -->
        <Border Grid.Row="3" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Reviews}">

                    <!-- Empty state -->
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Reviews.Count}" Value="0">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <TextBlock Text="Nema recenzija za odabrani kvart u poslednjih godinu dana."
                                                           FontSize="13" Foreground="{StaticResource BrushTextSecondary}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Margin="0,40,0,0"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                                    Background="{StaticResource BrushCard}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrushCardHover}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid Margin="14,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Stars -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding StarsDisplay, Mode=OneWay}"
                                               Style="{StaticResource StarStyle}"/>

                                    <!-- Comment -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CommentDisplay, Mode=OneWay}"
                                               Style="{StaticResource CellTextStyle}"
                                               Margin="8,0"/>

                                    <!-- Date -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DateDisplay, Mode=OneWay}"
                                               Style="{StaticResource CellTextStyle}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
