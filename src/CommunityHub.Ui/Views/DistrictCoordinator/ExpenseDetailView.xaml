<UserControl x:Class="CommunityHub.Ui.Views.DistrictCoordinator.ExpenseDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/DistrictCoordinator/DistrictCoordinatorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#99000000">
        <Border Background="{StaticResource DC.Bg.Card}" CornerRadius="8" Width="680" Height="380"
                Margin="40" VerticalAlignment="Center" HorizontalAlignment="Center"
                BorderBrush="{StaticResource DC.Border}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Background="{StaticResource DC.Bg.Subtle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Detalji troška"
                               Margin="20,14" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource DC.Text.Primary}"/>
                    <Button Grid.Column="1" Content="✕" Command="{Binding CloseCommand}"
                            Width="32" Height="32" Background="Transparent" BorderThickness="0"
                            FontSize="14" Foreground="{StaticResource DC.Text.Caption}" Cursor="Hand" Margin="0,8,12,8"/>
                </Grid>

                <!-- Content -->
                <StackPanel Grid.Row="1" Margin="32,24">
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Iznos" Style="{StaticResource DC.Label}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Expense.AmountDisplay, Mode=OneWay}"
                                   FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource DC.Text.Primary}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Opis" Style="{StaticResource DC.Label}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Expense.Description, Mode=OneWay}"
                                   FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource DC.Text.Primary}"/>
                    </Grid>
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Datum" Style="{StaticResource DC.Label}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Expense.DateDisplay, Mode=OneWay}"
                                   FontSize="14" Foreground="{StaticResource DC.Text.Primary}"/>
                    </Grid>

                    <!-- Info banner -->
                    <Border Background="{StaticResource DC.Warning.Light}" CornerRadius="6" Padding="14,10"
                            BorderBrush="{StaticResource DC.Warning}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="14"
                                    BorderBrush="{StaticResource DC.Warning}" BorderThickness="1.5" Margin="0,0,10,0">
                                <TextBlock Text="i" FontSize="14" FontWeight="Bold" Foreground="{StaticResource DC.Warning}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock FontSize="12" Foreground="{StaticResource DC.Text.Secondary}" VerticalAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="480">
                                Nije moguće vršiti izmenu datih podataka u trenutnoj sekciji,
                                za izmenu kliknuti dugme u donjem desnom uglu.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Footer -->
                <Border Grid.Row="2" BorderBrush="{StaticResource DC.Border}" BorderThickness="0,1,0,0" Padding="24,14">
                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="Nazad" Command="{Binding BackCommand}"
                                Style="{StaticResource DC.Btn.Ghost}" Padding="20,8" FontSize="13"/>
                        <Button DockPanel.Dock="Right" Content="Uredi trosak" Command="{Binding EditCommand}"
                                Style="{StaticResource DC.Btn.Primary}" Padding="20,8" FontSize="13"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
