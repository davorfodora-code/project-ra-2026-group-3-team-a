<UserControl x:Class="CommunityHub.Ui.Views.DistrictCoordinator.AddDonationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Background="#99000000">
        <Border Background="White" CornerRadius="8" MaxWidth="500"
                Margin="40" VerticalAlignment="Center" HorizontalAlignment="Center"
                BorderBrush="#CCC" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="#F8F9FA">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Nova donacija"
                               Margin="20,14" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50"/>
                    <Button Grid.Column="1" Content="✕" Command="{Binding CloseCommand}"
                            Width="32" Height="32" Background="Transparent" BorderThickness="0"
                            FontSize="14" Foreground="#888" Cursor="Hand" Margin="0,8,12,8"/>
                </Grid>
                <StackPanel Grid.Row="1" Margin="28,20">
                    <TextBlock Text="Iznos" FontSize="13" Foreground="#2C3E50" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                             Height="36" FontSize="13" Padding="10,4"
                             BorderBrush="#BDC3C7" BorderThickness="1" Margin="0,0,0,4"/>
                    <TextBlock FontSize="11" Margin="0,0,0,16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text"       Value="{Binding AmountError, Mode=OneWay}"/>
                                <Setter Property="Foreground" Value="Red"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AmountIsValid}" Value="True">
                                        <Setter Property="Text"       Value="Iznos je ispravan"/>
                                        <Setter Property="Foreground" Value="#27AE60"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="Datum" FontSize="13" Foreground="#2C3E50" Margin="0,0,0,6"/>
                    <DatePicker SelectedDate="{Binding SelectedDate}"
                                FontSize="12" Height="32" HorizontalAlignment="Left" Width="200"/>
                </StackPanel>
                <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="24,14">
                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="Otkaži" Command="{Binding CancelCommand}"
                                Background="Transparent" BorderBrush="#BDC3C7" BorderThickness="1"
                                Padding="20,8" FontSize="13" Foreground="#2C3E50" Cursor="Hand"/>
                        <Button DockPanel.Dock="Right" Content="Sacuvaj" Command="{Binding SaveCommand}"
                                Background="#2C3E50" Foreground="White" BorderThickness="0"
                                Padding="20,8" FontSize="13" Cursor="Hand"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
