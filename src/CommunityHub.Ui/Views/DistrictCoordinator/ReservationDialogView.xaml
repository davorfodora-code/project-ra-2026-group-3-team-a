<UserControl x:Class="CommunityHub.Ui.Views.DistrictCoordinator.ReservationDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SlotItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding"    Value="0"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6" BorderThickness="1"
                                BorderBrush="#D5D8DC" Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"    Value="#EBF5FB"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush"   Value="#2980B9"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#AED6F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#99000000">
        <Border Background="White" CornerRadius="8"
                MaxWidth="620" MinHeight="420"
                Margin="40" VerticalAlignment="Center" HorizontalAlignment="Center"
                BorderBrush="#CCC" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Background="#F8F9FA">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Rezervacija mesta"
                               Margin="20,14" FontSize="14" FontWeight="SemiBold"
                               Foreground="#2C3E50" VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Command="{Binding CancelCommand}"
                            Content="✕" Width="32" Height="32"
                            Background="Transparent" BorderThickness="0"
                            FontSize="14" Foreground="#888" Cursor="Hand"
                            Margin="0,8,12,8"/>
                </Grid>

                <!-- STEP 1: Input form -->
                <StackPanel Grid.Row="1" Margin="28,20"
                            Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">

                    <Border Background="#EBF5FB" CornerRadius="6" Padding="14,10" Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="14"
                                    BorderBrush="#2980B9" BorderThickness="1.5"
                                    Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="i" FontSize="14" FontWeight="Bold"
                                           Foreground="#2980B9"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="#2C3E50">
                                <Run Text="Rezervišete za "/>
                                <Run Text="{Binding CityObjectName, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Duration -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Trajanje posete (h):"
                                   FontSize="13" VerticalAlignment="Center" Foreground="#2C3E50"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding DurationHoursText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34" FontSize="13" Padding="8,4"
                                 BorderBrush="#BDC3C7" BorderThickness="1"
                                 VerticalContentAlignment="Center"/>
                    </Grid>

                    <!-- Date range -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Datum od - do:"
                                   FontSize="13" VerticalAlignment="Top"
                                   Margin="0,6,0,0" Foreground="#2C3E50"/>
                        <StackPanel Grid.Column="1">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Od:" FontSize="12"
                                           Foreground="#555" VerticalAlignment="Center"/>
                                <DatePicker Grid.Column="1"
                                            SelectedDate="{Binding RangeStart}"
                                            FontSize="12" Height="30"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Do:" FontSize="12"
                                           Foreground="#555" VerticalAlignment="Center"/>
                                <DatePicker Grid.Column="1"
                                            SelectedDate="{Binding RangeEnd}"
                                            FontSize="12" Height="30"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Validation -->
                    <TextBlock Text="{Binding ValidationMessage}"
                               Foreground="Red" FontSize="11" TextWrapping="Wrap"
                               Margin="0,12,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasValidation}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- STEP 2: Slot selection -->
                <StackPanel Grid.Row="1" Margin="28,20"
                            Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">

                    <Border Background="#EBF5FB" CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="14"
                                    BorderBrush="#2980B9" BorderThickness="1.5"
                                    Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="i" FontSize="14" FontWeight="Bold"
                                           Foreground="#2980B9"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock VerticalAlignment="Center" FontSize="13"
                                       Foreground="#2C3E50" TextWrapping="Wrap">
                                <Run Text="Rezervišete za "/>
                                <Run Text="{Binding CityObjectName, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text=", izaberite odgovarajući termin"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                        <ListBox ItemsSource="{Binding AvailableSlots}"
                                 SelectedItem="{Binding SelectedSlot}"
                                 BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource SlotItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Grid.Column="0"
                                                     IsChecked="{Binding IsSelected,
                                                         RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                     IsHitTestVisible="False"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FullDisplay, Mode=OneWay}"
                                                   FontSize="13" Foreground="#2C3E50"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="Slobodan"
                                                   FontSize="12" Foreground="#27AE60"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <!-- No slots message -->
                    <TextBlock FontSize="12" Foreground="#888" TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Text="Nema slobodnih termina. Pokušajte sa kraćim trajanjem posete.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AvailableSlots.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Validation -->
                    <TextBlock Text="{Binding ValidationMessage}"
                               Foreground="Red" FontSize="11" TextWrapping="Wrap"
                               Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasValidation}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Footer -->
                <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="24,14">
                    <Grid>
                        <!-- Step 1 buttons -->
                        <DockPanel LastChildFill="False"
                                   Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">
                            <Button DockPanel.Dock="Left" Content="Otkaži"
                                    Command="{Binding CancelCommand}"
                                    Background="Transparent" BorderBrush="#BDC3C7" BorderThickness="1"
                                    Padding="20,8" FontSize="13" Foreground="#2C3E50" Cursor="Hand"/>
                            <Button DockPanel.Dock="Right" Content="Pronađi termin"
                                    Command="{Binding FindSlotsCommand}"
                                    Background="#2C3E50" Foreground="White" BorderThickness="0"
                                    Padding="20,8" FontSize="13" Cursor="Hand"/>
                        </DockPanel>

                        <!-- Step 2 buttons -->
                        <DockPanel LastChildFill="False"
                                   Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">
                            <Button DockPanel.Dock="Left" Content="Nazad"
                                    Command="{Binding BackCommand}"
                                    Background="Transparent" BorderBrush="#BDC3C7" BorderThickness="1"
                                    Padding="20,8" FontSize="13" Foreground="#2C3E50" Cursor="Hand"/>
                            <Button DockPanel.Dock="Right" Content="Zakaži termin"
                                    Command="{Binding ReserveCommand}"
                                    Background="#2C3E50" Foreground="White" BorderThickness="0"
                                    Padding="20,8" FontSize="13" Cursor="Hand"/>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
