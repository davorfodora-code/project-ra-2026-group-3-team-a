<UserControl x:Class="CommunityHub.Ui.Views.DistrictCoordinator.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CommunityHub.Ui.Converters">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/DistrictCoordinator/DistrictCoordinatorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:ActiveFilterToBackgroundConverter x:Key="FilterBg"/>
            <conv:ActiveFilterToForegroundConverter x:Key="FilterFg"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <TextBlock Text="Kvart:" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding Districts}"
                          SelectedItem="{Binding SelectedDistrict, Mode=TwoWay}"
                          Style="{StaticResource DC.ComboBox}"
                          Width="220" FontSize="13"
                          DisplayMemberPath="DistrictName"/>
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    Content="Zakaži sastanak"
                    Command="{Binding ScheduleMeetingCommand}"
                    Style="{StaticResource DC.Btn.Primary}"
                    Padding="16,8" FontSize="13"/>
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource DC.Accent.Light}"
                BorderBrush="{StaticResource DC.Accent}"
                BorderThickness="1" CornerRadius="6" Padding="14,8" Margin="0,0,0,14">
            <TextBlock Text="{Binding RecommendationText}"
                       FontSize="13" Foreground="{StaticResource DC.Primary}" TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource DC.Panel}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding NeaktivanCount}" FontSize="22"
                               FontWeight="Bold" HorizontalAlignment="Center" Foreground="#E65C00"/>
                    <TextBlock Text="Neaktivan" FontSize="11"
                               HorizontalAlignment="Center" Foreground="{StaticResource DC.Text.Secondary}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding AktivanCount}" FontSize="22"
                               FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2E7D32"/>
                    <TextBlock Text="Aktivan" FontSize="11"
                               HorizontalAlignment="Center" Foreground="{StaticResource DC.Text.Secondary}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding NovCount}" FontSize="22"
                               FontWeight="Bold" HorizontalAlignment="Center" Foreground="#1565C0"/>
                    <TextBlock Text="Nov u kvartu" FontSize="11"
                               HorizontalAlignment="Center" Foreground="{StaticResource DC.Text.Secondary}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding OdPoverenjaCount}" FontSize="22"
                               FontWeight="Bold" HorizontalAlignment="Center" Foreground="#F9A825"/>
                    <TextBlock Text="Od poverenja" FontSize="11"
                               HorizontalAlignment="Center" Foreground="{StaticResource DC.Text.Secondary}"/>
                </StackPanel>
                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding IstaknutiCount}" FontSize="22"
                               FontWeight="Bold" HorizontalAlignment="Center" Foreground="#6A1B9A"/>
                    <TextBlock Text="Istaknut" FontSize="11"
                               HorizontalAlignment="Center" Foreground="{StaticResource DC.Text.Secondary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Style="{StaticResource DC.FilterButton}" Margin="0,0,6,0" Content="Svi"
                    Command="{Binding MeetingList.SetFilterCommand}" CommandParameter="all"
                    Background="{Binding MeetingList.ActiveFilter, Converter={StaticResource FilterBg}, ConverterParameter=all}"
                    Foreground="{Binding MeetingList.ActiveFilter, Converter={StaticResource FilterFg}, ConverterParameter=all}"/>
            <Button Style="{StaticResource DC.FilterButton}" Margin="0,0,6,0" Content="Zakazani"
                    Command="{Binding MeetingList.SetFilterCommand}" CommandParameter="scheduled"
                    Background="{Binding MeetingList.ActiveFilter, Converter={StaticResource FilterBg}, ConverterParameter=scheduled}"
                    Foreground="{Binding MeetingList.ActiveFilter, Converter={StaticResource FilterFg}, ConverterParameter=scheduled}"/>
            <Button Style="{StaticResource DC.FilterButton}" Margin="0,0,6,0" Content="U pripremi"
                    Command="{Binding MeetingList.SetFilterCommand}" CommandParameter="inprogress"
                    Background="{Binding MeetingList.ActiveFilter, Converter={StaticResource FilterBg}, ConverterParameter=inprogress}"
                    Foreground="{Binding MeetingList.ActiveFilter, Converter={StaticResource FilterFg}, ConverterParameter=inprogress}"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="Pregled svih sastanaka" Style="{StaticResource DC.H3}" Margin="0,0,0,8"/>

        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding MeetingList.FilteredMeetings}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DC.Panel}" Margin="0,0,8,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding MeetingTypeDisplay}"
                                           FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource DC.Text.Primary}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding VoteCount, StringFormat='{}{0} glasova'}"
                                           FontSize="12" Foreground="{StaticResource DC.Text.Secondary}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="{Binding DateTimeDisplay}"
                                           FontSize="12" Foreground="{StaticResource DC.Text.Secondary}" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding StatusDisplay}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource DC.Text.Primary}"
                                           Margin="0,4,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
