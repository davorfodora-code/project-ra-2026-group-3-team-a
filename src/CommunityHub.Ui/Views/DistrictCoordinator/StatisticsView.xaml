<UserControl x:Class="CommunityHub.Ui.Views.DistrictCoordinator.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CommunityHub.Ui.Converters">
    <UserControl.Resources>
        <conv:ActiveFilterToBackgroundConverter x:Key="FilterBg"/>
        <conv:ActiveFilterToForegroundConverter x:Key="FilterFg"/>

        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="Margin"          Value="0,0,8,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <TextBlock Text="Kvart:" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding Districts}"
                          SelectedItem="{Binding SelectedDistrict, Mode=TwoWay}"
                          Width="220" Height="32" FontSize="13">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DistrictName}" Margin="2,0"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    Content="Zakaži sastanak"
                    Command="{Binding ScheduleMeetingCommand}"
                    Padding="16,8" FontSize="13"
                    Background="{StaticResource BrushSurface}" Foreground="{StaticResource BrushTextPrimary}"
                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1" CornerRadius="6" Padding="14,8" Margin="0,0,0,14">
            <TextBlock Text="{Binding RecommendationText}"
                       FontSize="13" Foreground="{StaticResource BrushAccent}" TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1" CornerRadius="6" Padding="16,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding NeaktivanCount}" FontSize="22"
                               FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource BrushWarning}"/>
                    <TextBlock Text="Neaktivan" FontSize="11"
                               HorizontalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding AktivanCount}" FontSize="22"
                               FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource BrushSuccess}"/>
                    <TextBlock Text="Aktivan" FontSize="11"
                               HorizontalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding NovCount}" FontSize="22"
                               FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource BrushAccent}"/>
                    <TextBlock Text="Nov u kvartu" FontSize="11"
                               HorizontalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding OdPoverenjaCount}" FontSize="22"
                               FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource BrushWarning}"/>
                    <TextBlock Text="Od poverenja" FontSize="11"
                               HorizontalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>
                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding IstaknutiCount}" FontSize="22"
                               FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource BrushAccent}"/>
                    <TextBlock Text="Istaknut" FontSize="11"
                               HorizontalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Style="{StaticResource FilterButtonStyle}" Content="Prikaži sve sastanke"
                    Command="{Binding MeetingList.SetFilterCommand}" CommandParameter="all"
                    Background="{Binding MeetingList.ActiveFilter, Converter={StaticResource FilterBg}, ConverterParameter=all}"
                    Foreground="{Binding MeetingList.ActiveFilter, Converter={StaticResource FilterFg}, ConverterParameter=all}"/>
            <Button Style="{StaticResource FilterButtonStyle}" Content="Prikaži zakazane"
                    Command="{Binding MeetingList.SetFilterCommand}" CommandParameter="scheduled"
                    Background="{Binding MeetingList.ActiveFilter, Converter={StaticResource FilterBg}, ConverterParameter=scheduled}"
                    Foreground="{Binding MeetingList.ActiveFilter, Converter={StaticResource FilterFg}, ConverterParameter=scheduled}"/>
            <Button Style="{StaticResource FilterButtonStyle}" Content="Prikaži u pripremi"
                    Command="{Binding MeetingList.SetFilterCommand}" CommandParameter="inprogress"
                    Background="{Binding MeetingList.ActiveFilter, Converter={StaticResource FilterBg}, ConverterParameter=inprogress}"
                    Foreground="{Binding MeetingList.ActiveFilter, Converter={StaticResource FilterFg}, ConverterParameter=inprogress}"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="Pregled svih sastanaka"
                   FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8"/>

        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding MeetingList.FilteredMeetings}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                CornerRadius="6" Padding="14,10" Margin="0,0,8,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding MeetingTypeDisplay}"
                                           FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding VoteCount, StringFormat='{}{0} glasova'}"
                                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="{Binding DateTimeDisplay}"
                                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding StatusDisplay}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"
                                           Margin="0,4,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
