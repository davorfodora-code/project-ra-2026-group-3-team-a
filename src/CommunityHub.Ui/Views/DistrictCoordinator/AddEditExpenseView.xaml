<UserControl x:Class="CommunityHub.Ui.Views.DistrictCoordinator.AddEditExpenseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/DistrictCoordinator/DistrictCoordinatorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#99000000">
        <!-- Main dialog -->
        <Border Background="{StaticResource DC.Bg.Card}" CornerRadius="8" Width="680" Height="460"
                Margin="40" VerticalAlignment="Center" HorizontalAlignment="Center"
                BorderBrush="{StaticResource DC.Border}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Background="{StaticResource DC.Bg.Subtle}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Title, Mode=OneWay}"
                               Margin="20,14" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource DC.Text.Primary}"/>
                    <Button Grid.Column="1" Content="✕" Command="{Binding CloseCommand}"
                            Width="32" Height="32" Background="Transparent" BorderThickness="0"
                            FontSize="14" Foreground="{StaticResource DC.Text.Caption}" Cursor="Hand" Margin="0,8,12,8"/>
                </Grid>

                <!-- Form -->
                <StackPanel Grid.Row="1" Margin="32,20">

                    <!-- Iznos -->
                    <TextBlock Text="Iznos" FontSize="13" Foreground="{StaticResource DC.Text.Secondary}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DC.Input}" Margin="0,0,0,4"/>
                    <TextBlock FontSize="11" Margin="0,0,0,12"
                               Visibility="{Binding ShowAmountFeedback, Converter={StaticResource BoolToVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text"       Value="{Binding AmountError, Mode=OneWay}"/>
                                <Setter Property="Foreground" Value="{StaticResource DC.Danger}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAmountError}" Value="False">
                                        <Setter Property="Text"       Value="Iznos je ispravan"/>
                                        <Setter Property="Foreground" Value="{StaticResource DC.Success}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Opis -->
                    <TextBlock Text="Opis" FontSize="13" Foreground="{StaticResource DC.Text.Secondary}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DC.Input.Multiline}"
                             Height="80" Margin="0,0,0,4"/>
                    <TextBlock FontSize="11" Margin="0,0,0,12"
                               Visibility="{Binding ShowDescFeedback, Converter={StaticResource BoolToVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text"       Value="{Binding DescError, Mode=OneWay}"/>
                                <Setter Property="Foreground" Value="{StaticResource DC.Danger}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDescError}" Value="False">
                                        <Setter Property="Text"       Value="Opis je ispravan"/>
                                        <Setter Property="Foreground" Value="{StaticResource DC.Success}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Datum -->
                    <TextBlock Text="Datum" FontSize="13" Foreground="{StaticResource DC.Text.Secondary}" Margin="0,0,0,6"/>
                    <DatePicker SelectedDate="{Binding SelectedDate}"
                                FontSize="12" Height="32" HorizontalAlignment="Left" Width="200"/>
                </StackPanel>

                <!-- Footer -->
                <Border Grid.Row="2" BorderBrush="{StaticResource DC.Border}" BorderThickness="0,1,0,0" Padding="24,14">
                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Left"
                                Content="{Binding CancelLabel, Mode=OneWay}"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource DC.Btn.Ghost}"
                                Padding="20,8" FontSize="13"/>
                        <Button DockPanel.Dock="Right"
                                Content="{Binding SaveLabel, Mode=OneWay}"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource DC.Btn.Primary}"
                                Padding="20,8" FontSize="13"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Unsaved changes confirmation -->
        <Border Background="#CC000000"
                Visibility="{Binding ShowLeaveConfirm, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource DC.Bg.Card}" CornerRadius="8" MaxWidth="380"
                    Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="U polju - iznos, imate popunjene podatke"
                               FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DC.Text.Primary}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="Da li ste sigurni da želite da napustite prozor?"
                               FontSize="13" Foreground="{StaticResource DC.Text.Secondary}"
                               TextWrapping="Wrap" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Ostani" Command="{Binding StayCommand}"
                                Style="{StaticResource DC.Btn.Ghost}"
                                Padding="20,8" FontSize="13"
                                Margin="0,0,12,0"/>
                        <Button Content="Napusti" Command="{Binding ConfirmLeaveCommand}"
                                Style="{StaticResource DC.Btn.Danger}"
                                Padding="20,8" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
