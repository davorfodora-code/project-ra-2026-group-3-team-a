<Window x:Class="CommunityHub.Ui.Views.DistrictCoordinator.ScheduleMeetingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zakazivanje sastanka"
        Width="460" Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/DistrictCoordinator/DistrictCoordinatorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <Style x:Key="TypeToggleStyle" TargetType="Button">
                <Setter Property="Height"          Value="56"/>
                <Setter Property="FontSize"        Value="14"/>
                <Setter Property="FontWeight"      Value="SemiBold"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Background"      Value="{StaticResource DC.Border}"/>
                <Setter Property="Foreground"      Value="{StaticResource DC.Text.Secondary}"/>
                <Setter Property="BorderBrush"     Value="{StaticResource DC.Border}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24" Background="{StaticResource DC.Bg.Card}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Zakazivanje sastanka"
                   FontSize="17" FontWeight="Bold" Margin="0,0,0,16"
                   Foreground="{StaticResource DC.Text.Primary}"/>

        <TextBlock Grid.Row="1" Text="Tema sastanka:" FontSize="13" Margin="0,0,0,8"
                   Foreground="{StaticResource DC.Text.Secondary}"/>
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Dobrodošlica"
                    Command="{Binding SelectDobrodoslicaCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TypeToggleStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDobrodoslicaSelected}" Value="True">
                                <Setter Property="Background"  Value="{StaticResource DC.Primary}"/>
                                <Setter Property="Foreground"  Value="{StaticResource DC.Text.OnDark}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource DC.Primary}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Grid.Column="2" Content="Motivacija"
                    Command="{Binding SelectMotivacijaCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TypeToggleStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMotivacijaSelected}" Value="True">
                                <Setter Property="Background"  Value="{StaticResource DC.Primary}"/>
                                <Setter Property="Foreground"  Value="{StaticResource DC.Text.OnDark}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource DC.Primary}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <TextBlock Grid.Row="3" Text="Vreme održavanja (HH:mm):" FontSize="13" Margin="0,0,0,4"
                   Foreground="{StaticResource DC.Text.Secondary}"/>
        <TextBox Grid.Row="4"
                 Text="{Binding MeetingTimeText, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource DC.Input}" Margin="0,0,0,16"/>

        <Grid Grid.Row="5" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Opseg datuma (od — do):" FontSize="13" Margin="0,0,0,4"
                       Foreground="{StaticResource DC.Text.Secondary}"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <DatePicker Grid.Column="0"
                            SelectedDate="{Binding DateRangeStart, Mode=TwoWay}"
                            Height="32" FontSize="13"/>
                <TextBlock Grid.Column="1" Text=" — " VerticalAlignment="Center"
                           FontSize="14" Margin="6,0"
                           Foreground="{StaticResource DC.Text.Secondary}"/>
                <DatePicker Grid.Column="2"
                            SelectedDate="{Binding DateRangeEnd, Mode=TwoWay}"
                            Height="32" FontSize="13"/>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="6" Margin="0,16,0,0">
            <TextBlock Text="{Binding ErrorText}"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                       Foreground="{StaticResource DC.Danger}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Otkaži" Width="90" Height="32" Margin="0,0,8,0"
                        Command="{Binding CancelCommand}" FontSize="13"
                        Style="{StaticResource DC.Btn.Ghost}"/>
                <Button Content="Zakaži" Width="90" Height="32"
                        Command="{Binding ConfirmCommand}" FontSize="13"
                        Style="{StaticResource DC.Btn.Primary}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
