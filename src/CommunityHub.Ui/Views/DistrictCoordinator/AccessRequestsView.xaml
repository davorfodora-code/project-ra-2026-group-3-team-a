<UserControl x:Class="CommunityHub.Ui.Views.DistrictCoordinator.AccessRequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CommunityHub.Ui.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:ActiveFilterToBackgroundConverter x:Key="FilterBg"/>
        <conv:ActiveFilterToForegroundConverter x:Key="FilterFg"/>

        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar: District selector + section tabs -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="Kvart:" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="220" Height="30" FontSize="13"
                              ItemsSource="{Binding Districts}"
                              SelectedItem="{Binding SelectedDistrict, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" Margin="2,0"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Section tabs -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="24,0,0,0">
                    <Grid Margin="0,0,18,0">
                        <Button Content="Zahtevi za pristup"
                                Command="{Binding ShowRequestsSectionCommand}"
                                Background="Transparent" BorderThickness="0"
                                Padding="0,4" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRequestsSection}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Border Height="2" Background="{StaticResource BrushAccent}" VerticalAlignment="Bottom"
                                Visibility="{Binding IsRequestsSection, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                    <Grid>
                        <Button Content="Članstva"
                                Command="{Binding ShowMembershipsSectionCommand}"
                                Background="Transparent" BorderThickness="0"
                                Padding="0,4" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMembershipsSection}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Border Height="2" Background="{StaticResource BrushAccent}" VerticalAlignment="Bottom"
                                Visibility="{Binding IsMembershipsSection, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </StackPanel>
            </DockPanel>

            <!-- REQUESTS SECTION -->
            <Grid Grid.Row="1"
                  Visibility="{Binding IsRequestsSection, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Zahtevi za pristup"
                           FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Style="{StaticResource FilterButtonStyle}" Content="Svi"
                            Command="{Binding RequestList.SetRequestFilterCommand}" CommandParameter="Svi"
                            Background="{Binding RequestList.RequestFilter, Converter={StaticResource FilterBg}, ConverterParameter=Svi}"
                            Foreground="{Binding RequestList.RequestFilter, Converter={StaticResource FilterFg}, ConverterParameter=Svi}"/>
                    <Button Style="{StaticResource FilterButtonStyle}" Content="Na čekanju"
                            Command="{Binding RequestList.SetRequestFilterCommand}" CommandParameter="Pending"
                            Background="{Binding RequestList.RequestFilter, Converter={StaticResource FilterBg}, ConverterParameter=Pending}"
                            Foreground="{Binding RequestList.RequestFilter, Converter={StaticResource FilterFg}, ConverterParameter=Pending}"/>
                    <Button Style="{StaticResource FilterButtonStyle}" Content="Prihvaćeni"
                            Command="{Binding RequestList.SetRequestFilterCommand}" CommandParameter="Approved"
                            Background="{Binding RequestList.RequestFilter, Converter={StaticResource FilterBg}, ConverterParameter=Approved}"
                            Foreground="{Binding RequestList.RequestFilter, Converter={StaticResource FilterFg}, ConverterParameter=Approved}"/>
                    <Button Style="{StaticResource FilterButtonStyle}" Content="Odbijeni"
                            Command="{Binding RequestList.SetRequestFilterCommand}" CommandParameter="Rejected"
                            Background="{Binding RequestList.RequestFilter, Converter={StaticResource FilterBg}, ConverterParameter=Rejected}"
                            Foreground="{Binding RequestList.RequestFilter, Converter={StaticResource FilterFg}, ConverterParameter=Rejected}"/>
                </StackPanel>

                <DataGrid Grid.Row="2" ItemsSource="{Binding RequestList.Requests}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" SelectionMode="Single"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          RowBackground="{StaticResource BrushCard}" AlternatingRowBackground="{StaticResource BrushBackground}"
                          BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                          CanUserResizeRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Građanin"          Binding="{Binding CitizenFullName}"    Width="160"/>
                        <DataGridTextColumn Header="Adresa stanovanja" Binding="{Binding CitizenAddress}"     Width="180"/>
                        <DataGridTextColumn Header="Kvart"             Binding="{Binding DistrictName}"       Width="140"/>
                        <DataGridTextColumn Header="Datum"             Binding="{Binding CreatedAtFormatted}" Width="110"/>
                        <DataGridTextColumn Header="Status"            Binding="{Binding StatusDisplay}"      Width="120"/>
                        <DataGridTemplateColumn Header="Akcija" Width="160" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="Prihvati"
                                                Command="{Binding DataContext.RequestList.ShowApproveOverlayCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}"
                                                Padding="8,3" Margin="0,0,4,0" FontSize="11"
                                                Background="{StaticResource BrushSuccess}" Foreground="{StaticResource BrushTextPrimary}"
                                                BorderThickness="0" Cursor="Hand"/>
                                        <Button Content="Odbij"
                                                Command="{Binding DataContext.RequestList.ShowRejectOverlayCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}"
                                                Padding="8,3" FontSize="11"
                                                Background="{StaticResource BrushDanger}" Foreground="{StaticResource BrushTextPrimary}"
                                                BorderThickness="0" Cursor="Hand"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- MEMBERSHIPS SECTION -->
            <Grid Grid.Row="1"
                  Visibility="{Binding IsMembershipsSection, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Članstva"
                           FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Style="{StaticResource FilterButtonStyle}" Content="Svi"
                            Command="{Binding MembershipList.SetTrustFilterCommand}" CommandParameter="Svi"
                            Background="{Binding MembershipList.TrustFilter, Converter={StaticResource FilterBg}, ConverterParameter=Svi}"
                            Foreground="{Binding MembershipList.TrustFilter, Converter={StaticResource FilterFg}, ConverterParameter=Svi}"/>
                    <Button Style="{StaticResource FilterButtonStyle}" Content="Nov u kvartu"
                            Command="{Binding MembershipList.SetTrustFilterCommand}" CommandParameter="Nov"
                            Background="{Binding MembershipList.TrustFilter, Converter={StaticResource FilterBg}, ConverterParameter=Nov}"
                            Foreground="{Binding MembershipList.TrustFilter, Converter={StaticResource FilterFg}, ConverterParameter=Nov}"/>
                    <Button Style="{StaticResource FilterButtonStyle}" Content="Neaktivan"
                            Command="{Binding MembershipList.SetTrustFilterCommand}" CommandParameter="Neaktivan"
                            Background="{Binding MembershipList.TrustFilter, Converter={StaticResource FilterBg}, ConverterParameter=Neaktivan}"
                            Foreground="{Binding MembershipList.TrustFilter, Converter={StaticResource FilterFg}, ConverterParameter=Neaktivan}"/>
                    <Button Style="{StaticResource FilterButtonStyle}" Content="Aktivan"
                            Command="{Binding MembershipList.SetTrustFilterCommand}" CommandParameter="Aktivan"
                            Background="{Binding MembershipList.TrustFilter, Converter={StaticResource FilterBg}, ConverterParameter=Aktivan}"
                            Foreground="{Binding MembershipList.TrustFilter, Converter={StaticResource FilterFg}, ConverterParameter=Aktivan}"/>
                    <Button Style="{StaticResource FilterButtonStyle}" Content="Istaknut"
                            Command="{Binding MembershipList.SetTrustFilterCommand}" CommandParameter="Istaknuti"
                            Background="{Binding MembershipList.TrustFilter, Converter={StaticResource FilterBg}, ConverterParameter=Istaknuti}"
                            Foreground="{Binding MembershipList.TrustFilter, Converter={StaticResource FilterFg}, ConverterParameter=Istaknuti}"/>
                </StackPanel>

                <DataGrid Grid.Row="2" ItemsSource="{Binding MembershipList.Memberships}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowBackground="{StaticResource BrushCard}" AlternatingRowBackground="{StaticResource BrushBackground}"
                          BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                          CanUserResizeRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Građanin"          Binding="{Binding CitizenFullName}"   Width="200"/>
                        <DataGridTextColumn Header="Adresa stanovanja" Binding="{Binding CitizenAddress}"    Width="*"/>
                        <DataGridTextColumn Header="Datum učlanjenja"  Binding="{Binding JoinDateFormatted}" Width="130"/>
                        <DataGridTextColumn Header="Nivo poverenja"    Binding="{Binding TrustLevel}"        Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- Overlay dialog -->
        <Grid Panel.ZIndex="20" Background="#99000000"
              Visibility="{Binding Overlay.IsVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource BrushCard}" CornerRadius="8" Padding="28,22"
                    MaxWidth="460" VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Overlay.Title}"
                               FontSize="16" FontWeight="Bold" Margin="0,0,0,16"
                               Foreground="{StaticResource BrushTextPrimary}"/>

                    <Grid Margin="0,0,0,16" DataContext="{Binding Overlay.PendingRequest}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Građanin:"
                                   FontWeight="SemiBold" Margin="0,0,12,6" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CitizenFullName}"
                                   Margin="0,0,0,6" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Adresa:"
                                   FontWeight="SemiBold" Margin="0,0,12,6" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CitizenAddress}"
                                   Margin="0,0,0,6" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Kvart:"
                                   FontWeight="SemiBold" Margin="0,0,12,6" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DistrictName}"
                                   Margin="0,0,0,6" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Datum zahteva:"
                                   FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CreatedAtFormatted}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Margin="0,0,0,16"
                                Visibility="{Binding Overlay.IsRejectAction, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Razlog odbijanja:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Polje nije obavezno." FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Overlay.RejectionReason, UpdateSourceTrigger=PropertyChanged}"
                                 Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="13" Padding="6,4"/>
                    </StackPanel>

                    <TextBlock Visibility="{Binding Overlay.IsApproveAction, Converter={StaticResource BoolToVis}}"
                               Text="Prilikom odobravanja, sistem automatski kreira članstvo za datog građanina."
                               FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Otkaži" Width="90" Height="32" Margin="0,0,8,0" FontSize="13"
                                Command="{Binding Overlay.CancelCommand}"/>
                        <Button Width="120" Height="32" FontSize="13"
                                Content="{Binding Overlay.ConfirmText}"
                                Command="{Binding Overlay.ConfirmCommand}"
                                Foreground="{StaticResource BrushTextPrimary}" BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#27AE60"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Overlay.IsRejectAction}" Value="True">
                                            <Setter Property="Background" Value="#E74C3C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
