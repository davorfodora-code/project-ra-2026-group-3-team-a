<UserControl x:Class="CommunityHub.Ui.Views.DistrictCoordinator.CreateForumDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/DistrictCoordinator/DistrictCoordinatorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#CC000000">
        <Border Background="{StaticResource DC.Bg.Card}" CornerRadius="10"
                MaxWidth="520"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                BorderBrush="{StaticResource DC.Border}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.25" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="{StaticResource DC.Bg.Subtle}"
                        BorderBrush="{StaticResource DC.Border}" BorderThickness="0,0,0,1"
                        CornerRadius="10,10,0,0">
                    <Grid Margin="22,14,14,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Novi forum" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource DC.Text.Primary}"/>
                            <TextBlock Text="Forum će biti vidljiv svim koordinatorima kvartova"
                                       FontSize="11" Foreground="{StaticResource DC.Text.Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{Binding CancelCommand}"
                                Width="32" Height="32" Background="Transparent" BorderThickness="0"
                                FontSize="14" Foreground="{StaticResource DC.Text.Caption}"
                                Cursor="Hand" VerticalAlignment="Top"/>
                    </Grid>
                </Border>

                <!-- Content + buttons -->
                <StackPanel Grid.Row="1" Margin="22,20,22,24">

                    <!-- Title -->
                    <TextBlock Text="Naslov" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource DC.Text.Secondary}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DC.Input}"/>
                    <TextBlock Text="{Binding TitleError}"
                               Foreground="{StaticResource DC.Danger}" FontSize="11" Margin="0,2,0,0"
                               Visibility="{Binding HasTitleError, Converter={StaticResource BoolToVis}}"/>

                    <!-- Content -->
                    <TextBlock Text="Sadržaj" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource DC.Text.Secondary}" Margin="0,14,0,6"/>
                    <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DC.Input.Multiline}"
                             Height="120"/>
                    <TextBlock Text="{Binding ContentError}"
                               Foreground="{StaticResource DC.Danger}" FontSize="11" Margin="0,2,0,0"
                               Visibility="{Binding HasContentError, Converter={StaticResource BoolToVis}}"/>

                    <!-- Info notice -->
                    <Border Background="{StaticResource DC.Accent.Light}" CornerRadius="4"
                            BorderBrush="{StaticResource DC.Accent}" BorderThickness="1"
                            Padding="12,8" Margin="0,16,0,0">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="i" FontWeight="Bold"
                                       Foreground="{StaticResource DC.Accent}"
                                       FontSize="14" Margin="0,0,8,0" VerticalAlignment="Top"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource DC.Accent}">
                                Nakon kreiranja foruma vaše ime će biti izloženo i bićete označeni kao autor foruma
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <!-- Buttons -->
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Otkaži"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource DC.Btn.Ghost}"
                                Padding="20,8" FontSize="13"/>
                        <Button Grid.Column="2" Content="Objavi forum"
                                Command="{Binding ConfirmCommand}"
                                Style="{StaticResource DC.Btn.Primary}"
                                Padding="20,8" FontSize="13"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
