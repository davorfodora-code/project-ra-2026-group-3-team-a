<Window x:Class="CommunityHub.Ui.Views.DistrictCoordinator.CreateForumDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novi forum"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock Text="Novi forum" FontSize="17" FontWeight="Bold"
                       Foreground="#2C3E50"/>
            <TextBlock Text="Forum će biti vidljiv svim koordinatorima kvartova"
                       FontSize="11" Foreground="#888" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Close button (X) -->
        <Button Grid.Row="0" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="Transparent" BorderThickness="0"
                FontSize="16" Foreground="#888" Cursor="Hand"
                Command="{Binding CancelCommand}" Padding="4"/>

        <!-- Title label -->
        <TextBlock Grid.Row="1" Text="Naslov" FontSize="13" FontWeight="SemiBold"
                   Foreground="#2C3E50" Margin="0,16,0,6"/>

        <!-- Title input -->
        <TextBox Grid.Row="2"
                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                 Height="36" FontSize="13" Padding="10,6"
                 BorderBrush="#E0E0E0" BorderThickness="1"/>

        <!-- Title error -->
        <TextBlock Grid.Row="3" Text="{Binding TitleError}"
                   Foreground="Red" FontSize="11" Margin="0,2,0,0"
                   Visibility="{Binding HasTitleError, Converter={StaticResource BoolToVis}}"/>

        <!-- Content label -->
        <TextBlock Grid.Row="4" Text="Sadržaj" FontSize="13" FontWeight="SemiBold"
                   Foreground="#2C3E50" Margin="0,12,0,6"/>

        <!-- Content input -->
        <TextBox Grid.Row="5"
                 Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 Height="120" FontSize="13" Padding="10,8"
                 BorderBrush="#E0E0E0" BorderThickness="1"
                 VerticalScrollBarVisibility="Auto"/>

        <!-- Content error -->
        <TextBlock Grid.Row="6" Text="{Binding ContentError}"
                   Foreground="Red" FontSize="11" Margin="0,2,0,0"
                   Visibility="{Binding HasContentError, Converter={StaticResource BoolToVis}}"/>

        <!-- Info notice -->
        <Border Grid.Row="7" Background="#E8F4FD" CornerRadius="4"
                Padding="12,8" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="i" FontWeight="Bold" Foreground="#1565C0"
                           FontSize="14" Margin="0,0,8,0"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#1565C0">
                    Nakon kreiranja foruma vaše ime će biti izloženo i bićete označeni kao autor foruma
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="8" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Otkaži"
                    Command="{Binding CancelCommand}"
                    Width="100" Height="36"
                    Background="Transparent" Foreground="#2C3E50"
                    BorderBrush="#BDC3C7" BorderThickness="1"
                    FontSize="13" Cursor="Hand"/>

            <Button Grid.Column="2" Content="Objavi forum"
                    Command="{Binding ConfirmCommand}"
                    Width="120" Height="36"
                    Background="#2C3E50" Foreground="White"
                    BorderThickness="0" FontSize="13" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
