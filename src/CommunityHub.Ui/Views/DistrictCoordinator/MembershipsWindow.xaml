<Window x:Class="CommunityHub.Ui.Views.DistrictCoordinator.MembershipsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clanstva u kvartovima" Height="500" Width="750"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Clanstva u kvartovima"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Kvart:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="DistrictComboBox" Width="350"
                      DisplayMemberPath="DisplayText"
                      SelectionChanged="DistrictComboBox_SelectionChanged"/>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="MembershipsDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F9F9F9"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Gradjanin" Binding="{Binding CitizenFullName}" Width="200"/>
                <DataGridTextColumn Header="Adresa" Binding="{Binding CitizenAddress}" Width="250"/>
                <DataGridTextColumn Header="Datum uclanjenja" Binding="{Binding JoinDateFormatted}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
