<Window x:Class="CommunityHub.Ui.Views.Tenant.ProposeTopicDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Predloži temu" Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="28,24,28,28">

        <TextBlock Text="Predloži temu" FontSize="24" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Text="Predloži temu za nadolazeću skupštinu"
                   FontSize="16" Foreground="#888888" Margin="0,0,0,20"/>

        <!-- Informacije o skupštini -->
        <Border Background="#F5F5F5" CornerRadius="8" Padding="16,12" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock x:Name="AssemblyDateText" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock x:Name="AssemblyAddressText" FontSize="15" Foreground="#666666" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Unos teme -->
        <TextBlock Text="Tema" FontSize="18" Margin="0,0,0,8"/>
        <TextBox x:Name="TopicInput"
                 FontSize="16" AcceptsReturn="True"
                 Height="90" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Padding="10,8" Margin="0,0,0,6"/>
        <TextBlock x:Name="ErrorText" Text="" Foreground="#C0392B"
                   FontSize="15" TextWrapping="Wrap" Margin="0,0,0,6"
                   Visibility="Collapsed"/>
        <TextBlock Text="Teme se mogu predlagati najkasnije 24h pre skupštine."
                   FontSize="14" Foreground="#AAAAAA" Margin="0,0,0,20"/>

        <!-- Dugmad -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Otkaži" Click="Cancel_Click"
                    Padding="16,8" FontSize="16" Cursor="Hand" Margin="0,0,12,0"/>
            <Button Content="Pošalji temu"
                    Click="Submit_Click"
                    Style="{StaticResource PrimaryBtnStyle}"
                    Padding="16,8" FontSize="16"/>
        </StackPanel>

    </StackPanel>
</Window>
