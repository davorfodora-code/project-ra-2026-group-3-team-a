<Page x:Class="CommunityHub.Ui.Views.Tenant.Pages.BuildingSearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
      Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab header -->
        <Border Grid.Row="0" Background="White" Padding="24,14,24,0"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="TabSearchBtn" Tag="active" Style="{StaticResource TabBtnStyle}"
                        Click="TabSearch_Click" Margin="0,0,28,0" Padding="0,0,0,10">
                    <TextBlock x:Name="TabSearchText" Text="Pretraga zgrada"
                               FontSize="19" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                </Button>
                <Button x:Name="TabRequestsBtn" Style="{StaticResource TabBtnStyle}"
                        Click="TabRequests_Click" Padding="0,0,0,10">
                    <TextBlock x:Name="TabRequestsText" Text="Moji zahtevi"
                               FontSize="18" Foreground="#888888"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ===== TAB: Pretraga zgrada ===== -->
        <Grid Grid.Row="1" x:Name="SearchPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Forma za pretragu -->
            <Border Grid.Row="0" Background="White" Padding="24,14"
                    BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="155"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="155"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Adresa" FontSize="12" Foreground="#888888" Margin="0,0,0,4"/>
                        <TextBox x:Name="AddressTextBox" Padding="8,6" BorderBrush="#DDDDDD"
                                 BorderThickness="1" FontSize="14"
                                 TextChanged="LiveSearch_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Naselje" FontSize="12" Foreground="#888888" Margin="0,0,0,4"/>
                        <TextBox x:Name="NeighborhoodTextBox" Padding="8,6" BorderBrush="#DDDDDD"
                                 TextChanged="LiveSearch_Changed"
                                 BorderThickness="1" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Grad" FontSize="12" Foreground="#888888" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CityComboBox" Padding="6,5" FontSize="14"
                                  SelectionChanged="LiveSearch_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Država" FontSize="12" Foreground="#888888" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CountryComboBox" Padding="6,5" FontSize="14"
                                  SelectionChanged="LiveSearch_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource PrimaryBtnStyle}"
                                Padding="16,7" Margin="0,0,8,0" Click="SearchButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconBlock Icon="MagnifyingGlass" FontSize="13" Foreground="White"
                                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Pretraži" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryBtnStyle}"
                                Padding="16,7" Click="ClearButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconBlock Icon="Xmark" FontSize="13"
                                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Obriši" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Broj rezultata -->
            <TextBlock Grid.Row="1" x:Name="ResultCountText"
                       FontSize="13" Foreground="#888888" Margin="24,8,24,4"/>

            <!-- Kartice zgrada -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="BuildingCards" Margin="20,4,8,20">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4,4,4,4" Width="355" CornerRadius="12"
                                    Background="White" ClipToBounds="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1"
                                                      Opacity="0.08" Color="#000000"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="185"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Slika sa navigacijom -->
                                    <Grid Grid.Row="0" ClipToBounds="True">
                                        <Border Background="#EEEEEE">
                                            <fa:IconBlock Icon="Building" FontSize="56"
                                                          Foreground="#CCCCCC"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                        </Border>
                                        <Border>
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding CurrentImagePath,
                                                    Converter={StaticResource ImagePathConverter}}"
                                                            Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                        <Button Style="{StaticResource ImageNavBtnStyle}"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Margin="6,0" Click="PrevImage_Click"
                                                Visibility="{Binding HasMultiple,
                                                    Converter={StaticResource BoolToVisibility}}">
                                            <fa:IconBlock Icon="ChevronLeft" FontSize="14" Foreground="White"/>
                                        </Button>
                                        <Button Style="{StaticResource ImageNavBtnStyle}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Margin="6,0" Click="NextImage_Click"
                                                Visibility="{Binding HasMultiple,
                                                    Converter={StaticResource BoolToVisibility}}">
                                            <fa:IconBlock Icon="ChevronRight" FontSize="14" Foreground="White"/>
                                        </Button>
                                    </Grid>

                                    <!-- Info -->
                                    <StackPanel Grid.Row="1" Margin="16,12,16,10">
                                        <TextBlock Text="{Binding Building.AddressDisplay}"
                                                   FontSize="19" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding Building.Neighborhood}"
                                                   FontSize="14" Foreground="#888888" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding Building.LocationDisplay}"
                                                   FontSize="14" Foreground="#888888" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <fa:IconBlock Icon="LayerGroup" FontSize="12"
                                                          Foreground="#AAAAAA" Margin="0,0,5,0"
                                                          VerticalAlignment="Center"/>
                                            <TextBlock FontSize="13" Foreground="#AAAAAA">
                                                <Run Text="{Binding Building.NumberOfFloors}"/>
                                                <Run Text=" spratova  ·  "/>
                                                <Run Text="{Binding Building.TotalApartments}"/>
                                                <Run Text=" stanova"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Dugme pristupa -->
                                    <Border Grid.Row="2" BorderBrush="#EEEEEE"
                                            BorderThickness="0,1,0,0" Padding="16,10">
                                        <Button Content="Zatraži pristup"
                                                Style="{StaticResource PrimaryBtnStyle}"
                                                Padding="0,8" Tag="{Binding}"
                                                HorizontalAlignment="Stretch" FontSize="14"
                                                Click="RequestAccess_Click"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ===== TAB: Moji zahtevi ===== -->
        <Grid Grid.Row="1" x:Name="RequestsPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Filteri -->
            <Border Grid.Row="0" Background="White" Padding="24,12"
                    BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="14"/>
                    <ComboBox x:Name="StatusFilterComboBox" Width="190" Padding="8,5" FontSize="14"
                              SelectionChanged="StatusFilter_Changed">
                        <ComboBoxItem Content="Svi statusi" IsSelected="True"/>
                        <ComboBoxItem Content="Pending"/>
                        <ComboBoxItem Content="Accepted"/>
                        <ComboBoxItem Content="Rejected"/>
                    </ComboBox>
                    <TextBlock Text="Datum:" VerticalAlignment="Center" Margin="24,0,8,0" FontSize="14"/>
                    <ComboBox x:Name="SortComboBox" Width="165" Padding="8,5" FontSize="14"
                              SelectionChanged="SortFilter_Changed">
                        <ComboBoxItem Content="Najnoviji prvo" IsSelected="True"/>
                        <ComboBoxItem Content="Najstariji prvo"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Tabela zahteva -->
            <DataGrid Grid.Row="1" x:Name="RequestsDataGrid"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      Margin="24,12,24,24" BorderThickness="1" BorderBrush="#E0E0E0"
                      RowBackground="White" AlternatingRowBackground="#FAFAFA">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Adresa" Binding="{Binding AddressDisplay}" Width="*"/>
                    <DataGridTextColumn Header="Naselje" Binding="{Binding Neighborhood}" Width="*"/>
                    <DataGridTextColumn Header="Lokacija" Binding="{Binding LocationDisplay}" Width="*"/>
                    <DataGridTextColumn Header="Stan" Binding="{Binding ApartmentNumber}" Width="55"/>
                    <DataGridTextColumn Header="Datum" Binding="{Binding CreatedAtFormatted}" Width="130"/>

                    <DataGridTemplateColumn Header="Status" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="10,4"
                                        HorizontalAlignment="Left" Margin="4,3"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F0F0F0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                    <Setter Property="Background" Value="#FFF3CD"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Accepted">
                                                    <Setter Property="Background" Value="#D4EDDA"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                    <Setter Property="Background" Value="#F8D7DA"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Status}"/>
                                                <Setter Property="Foreground" Value="#666666"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                        <Setter Property="Text" Value="Čeka odobrenje"/>
                                                        <Setter Property="Foreground" Value="#856404"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Accepted">
                                                        <Setter Property="Text" Value="Odobreno"/>
                                                        <Setter Property="Foreground" Value="#155724"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                        <Setter Property="Text" Value="Odbijeno"/>
                                                        <Setter Property="Foreground" Value="#721C24"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Otkaži" Click="CancelRequestButton_Click"
                                        Padding="8,4" FontSize="13" Cursor="Hand"
                                        Visibility="{Binding CanCancel,
                                            Converter={StaticResource BoolToVisibility}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

    </Grid>
</Page>
