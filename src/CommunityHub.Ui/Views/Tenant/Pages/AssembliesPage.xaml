<Page x:Class="CommunityHub.Ui.Views.Tenant.Pages.AssembliesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
      Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filter traka -->
        <Border Grid.Row="0" Background="White" Padding="24,14"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Zgrada:" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="BuildingFilter" Width="300" FontSize="18" Padding="8,6"
                          SelectionChanged="BuildingFilter_SelectionChanged"/>
            </StackPanel>
        </Border>

        <!-- Sadržaj -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16,24,24">

                <TextBlock x:Name="NoAssembliesText"
                           Text="Nema skupština za prikazivanje."
                           FontSize="18" Foreground="#AAAAAA"
                           HorizontalAlignment="Center" Margin="0,32,0,0"
                           Visibility="Collapsed"/>

                <ItemsControl x:Name="AssembliesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AdCardStyle}" Margin="0,0,0,14">
                                <StackPanel>

                                    <!-- Datum + status bedž -->
                                    <Grid Margin="0,0,0,2">
                                        <StackPanel HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding DateDisplay}"
                                                       FontSize="22" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding TimeDisplay}"
                                                       FontSize="16" Foreground="#666666"/>
                                        </StackPanel>
                                        <Border x:Name="StatusBadge" HorizontalAlignment="Right"
                                                VerticalAlignment="Top" CornerRadius="14"
                                                Padding="14,5" Background="#3498DB">
                                            <TextBlock Text="{Binding StatusDisplay}"
                                                       FontSize="15" Foreground="White"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <!-- Teme -->
                                    <TextBlock Text="Teme:" FontSize="16" FontWeight="SemiBold"
                                               Margin="0,10,0,4"/>
                                    <ItemsControl ItemsSource="{Binding Topics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="8,2,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="&#x2022;" FontSize="15"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding}"
                                                               FontSize="15" TextWrapping="Wrap"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Traka prisustva -->
                                    <StackPanel Margin="0,12,0,4">
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="{Binding AttendanceDisplay}"
                                                       FontSize="14" Foreground="#888888"
                                                       HorizontalAlignment="Left"/>
                                            <TextBlock Text="{Binding QuorumLabel}"
                                                       FontSize="14" Foreground="#888888"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding AttendancePercent, Mode=OneWay}"
                                                     Maximum="100" Height="9"
                                                     Style="{StaticResource AttendanceBarStyle}"/>
                                    </StackPanel>

                                    <!-- Status prisustva stanara -->
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="Vaš stan:  " FontSize="16"
                                                   Foreground="#555555"/>
                                        <TextBlock Text="{Binding TenantAttendanceDisplay}"
                                                   FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>

                                    <!-- Akcijska dugmad -->
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,4">
                                        <Button x:Name="ConfirmBtn"
                                                Tag="{Binding}"
                                                Content="Prijavi prisustvo"
                                                Visibility="{Binding ShowConfirmButton, Converter={StaticResource BoolToVisibility}}"
                                                Click="ConfirmAttendance_Click"
                                                Style="{StaticResource PrimaryBtnStyle}"
                                                FontSize="16" Padding="14,8" Margin="0,0,10,0"/>
                                        <Button x:Name="CancelBtn"
                                                Tag="{Binding}"
                                                Content="Otkaži prisustvo"
                                                Visibility="{Binding ShowCancelButton, Converter={StaticResource BoolToVisibility}}"
                                                Click="CancelAttendance_Click"
                                                Style="{StaticResource SecondaryBtnStyle}"
                                                FontSize="16" Padding="14,8" Margin="0,0,10,0"/>
                                        <Button x:Name="ProposeBtn"
                                                Tag="{Binding}"
                                                Content="Predloži temu"
                                                Visibility="{Binding ShowProposeButton, Converter={StaticResource BoolToVisibility}}"
                                                Click="ProposeTopic_Click"
                                                Style="{StaticResource SecondaryBtnStyle}"
                                                FontSize="16" Padding="14,8"/>
                                    </StackPanel>

                                    <!-- Rok -->
                                    <TextBlock Text="{Binding DeadlineDisplay}"
                                               FontSize="14" Foreground="#AAAAAA"
                                               HorizontalAlignment="Right" Margin="0,4,0,0"/>

                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Confirmed">
                                    <Setter TargetName="StatusBadge" Property="Background" Value="#27AE60"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                    <Setter TargetName="StatusBadge" Property="Background" Value="#E74C3C"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
