<Page x:Class="CommunityHub.Ui.Views.Tenant.Pages.TenantProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
      Background="#F5F5F5">
    <Grid Margin="28,20,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Banner: avatar + ime + uloga -->
        <Border Grid.Row="0" Style="{StaticResource AdCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="72" Height="72" CornerRadius="36"
                        Background="#2C3E50" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock x:Name="InitialsBlock" Text="??" Foreground="White"
                               FontSize="28" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="FullNameBlock" Text=""
                                   FontSize="24" FontWeight="Bold" Foreground="#2C3E50"
                                   VerticalAlignment="Center"/>
                        <Border Background="#2C3E50" CornerRadius="10" Padding="12,4"
                                Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Stanar" Foreground="White"
                                       FontSize="13" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="UsernameBlock" Text="" FontSize="15"
                               Foreground="#888888" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Dve kartice: podaci i zgrade -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Lični podaci -->
            <Border Grid.Column="0" Style="{StaticResource AdCardStyle}" VerticalAlignment="Stretch">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <fa:IconBlock Icon="User" FontSize="20" Foreground="#2C3E50"
                                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Lični podaci" FontSize="20" FontWeight="SemiBold"
                                   Foreground="#2C3E50" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="145"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ime:"
                                   FontSize="16" Foreground="#666666" Margin="0,0,0,14"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="NameBlock"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Prezime:"
                                   FontSize="16" Foreground="#666666" Margin="0,0,0,14"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SurnameBlock"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Korisničko ime:"
                                   FontSize="16" Foreground="#666666" Margin="0,0,0,14"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="UsernameDetailBlock"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Datum rođenja:"
                                   FontSize="16" Foreground="#666666" Margin="0,0,0,14"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="BirthdayBlock"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Adresa:"
                                   FontSize="16" Foreground="#666666"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="AddressBlock"
                                   FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Stanovanje -->
            <Border Grid.Column="2" Style="{StaticResource AdCardStyle}" VerticalAlignment="Stretch">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <fa:IconBlock Icon="Building" FontSize="20" Foreground="#2C3E50"
                                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Stanovanje" FontSize="20" FontWeight="SemiBold"
                                   Foreground="#2C3E50" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ItemsControl x:Name="BuildingsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8F9FA" CornerRadius="8" Padding="14,12"
                                        Margin="0,0,0,10" BorderBrush="#E8E8E8" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding AddressDisplay}"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="#2C3E50" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding ApartmentInfo}"
                                                       FontSize="14" Foreground="#555555"/>
                                            <TextBlock Text="{Binding JoinedAtDisplay}"
                                                       FontSize="13" Foreground="#AAAAAA"
                                                       Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="NoBuildingsText"
                               Text="Niste stanar nijedne zgrade."
                               FontSize="15" Foreground="#AAAAAA"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer: odjava -->
        <Button Grid.Row="4" Content="Odjavi se"
                Style="{StaticResource PrimaryBtnStyle}"
                Background="#E74C3C" Padding="22,11" FontSize="16"
                HorizontalAlignment="Right" Click="Logout_Click"/>

    </Grid>
</Page>
