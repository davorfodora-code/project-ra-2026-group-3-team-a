<Page x:Class="CommunityHub.Ui.Views.Tenant.Pages.IssuesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
      Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filter bar -->
        <Border Grid.Row="0" Background="White" Padding="24,14"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <ComboBox x:Name="BuildingFilter"
                          Width="280" HorizontalAlignment="Left"
                          FontSize="18" Padding="8,6"
                          SelectionChanged="BuildingFilter_SelectionChanged"/>
                <Button Content="+ Prijavi problem"
                        HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryBtnStyle}"
                        FontSize="18" Padding="16,8"
                        Click="ReportProblem_Click"/>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16,24,24">

                <!-- Bar chart -->
                <Border Background="White" CornerRadius="10" Padding="18,14" Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.07" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Pregled problema" FontSize="20" FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>
                        <Canvas x:Name="StatsChart" Height="130"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Rectangle Width="14" Height="14" RadiusX="2" RadiusY="2"
                                       Fill="#E74C3C" VerticalAlignment="Center"/>
                            <TextBlock Text="Nerešen" FontSize="15" Foreground="#555555"
                                       Margin="6,0,20,0" VerticalAlignment="Center"/>
                            <Rectangle Width="14" Height="14" RadiusX="2" RadiusY="2"
                                       Fill="#F39C12" VerticalAlignment="Center"/>
                            <TextBlock Text="Pot. rešen" FontSize="15" Foreground="#555555"
                                       Margin="6,0,20,0" VerticalAlignment="Center"/>
                            <Rectangle Width="14" Height="14" RadiusX="2" RadiusY="2"
                                       Fill="#27AE60" VerticalAlignment="Center"/>
                            <TextBlock Text="Rešen" FontSize="15" Foreground="#555555"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="NoIssuesText" Text="Nemate prijavljenih problema."
                           FontSize="16" Foreground="#AAAAAA"
                           HorizontalAlignment="Center" Margin="0,20,0,0"
                           Visibility="Collapsed"/>

                <!-- Issue cards -->
                <ItemsControl x:Name="IssuesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AdCardStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <!-- Description + status pill -->
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="18" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" MaxWidth="460"
                                                   HorizontalAlignment="Left"/>
                                        <Border x:Name="StatusPill" HorizontalAlignment="Right"
                                                CornerRadius="12" Padding="10,4" Background="#E74C3C">
                                            <TextBlock Text="{Binding StatusDisplay}"
                                                       FontSize="14" Foreground="White"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <!-- Building + priority + date -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <fa:IconBlock Icon="Building" FontSize="14"
                                                      Foreground="#555555" VerticalAlignment="Center"
                                                      Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding BuildingAddress}"
                                                   FontSize="15" Foreground="#555555"
                                                   VerticalAlignment="Center" Margin="0,0,20,0"/>
                                        <fa:IconBlock x:Name="PriorityIconUrgent"
                                                      Icon="CircleExclamation" FontSize="14"
                                                      Foreground="#E74C3C" VerticalAlignment="Center"
                                                      Margin="0,0,5,0"/>
                                        <fa:IconBlock x:Name="PriorityIconSoon"
                                                      Icon="TriangleExclamation" FontSize="14"
                                                      Foreground="#F39C12" VerticalAlignment="Center"
                                                      Margin="0,0,5,0" Visibility="Collapsed"/>
                                        <fa:IconBlock x:Name="PriorityIconWait"
                                                      Icon="Clock" FontSize="14"
                                                      Foreground="#3498DB" VerticalAlignment="Center"
                                                      Margin="0,0,5,0" Visibility="Collapsed"/>
                                        <TextBlock Text="{Binding PriorityDisplay}"
                                                   FontSize="15" Foreground="#555555"
                                                   VerticalAlignment="Center" Margin="0,0,20,0"/>
                                        <fa:IconBlock Icon="Calendar" FontSize="14"
                                                      Foreground="#555555" VerticalAlignment="Center"
                                                      Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding ReportedAt, StringFormat='{}{0:dd.MM.yyyy.}'}"
                                                   FontSize="15" Foreground="#555555"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <!-- Confirmation section — shown only for PotentiallyResolved -->
                                    <Border x:Name="ConfirmSection" Visibility="Collapsed"
                                            Background="#FFF8E6" CornerRadius="6"
                                            Padding="12,10" Margin="0,8,0,0"
                                            BorderBrush="#F39C12" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock
                                                Text="Upravnik je označio problem kao rešen. Da li je problem zaista rešen?"
                                                FontSize="16" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Tag="{Binding Id}" Content="Da, rešeno"
                                                        Click="ConfirmResolved_Click"
                                                        Padding="12,6" FontSize="15" FontWeight="SemiBold"
                                                        Background="#27AE60" Foreground="White"
                                                        BorderThickness="0" Cursor="Hand"
                                                        Margin="0,0,10,0"/>
                                                <Button Tag="{Binding Id}" Content="Nije rešeno"
                                                        Click="DenyResolved_Click"
                                                        Padding="12,6" FontSize="15"
                                                        Background="Transparent"
                                                        BorderBrush="#AAAAAA" BorderThickness="1"
                                                        Cursor="Hand"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="PotentiallyResolved">
                                    <Setter TargetName="StatusPill" Property="Background" Value="#F39C12"/>
                                    <Setter TargetName="ConfirmSection" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Resolved">
                                    <Setter TargetName="StatusPill" Property="Background" Value="#27AE60"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Priority}" Value="SolveSoon">
                                    <Setter TargetName="PriorityIconUrgent" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="PriorityIconSoon" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Priority}" Value="CanWait">
                                    <Setter TargetName="PriorityIconUrgent" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="PriorityIconWait" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
