<Page x:Class="CommunityHub.Ui.Views.Tenant.Pages.TenantHomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
      Background="#F5F5F5">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28">

            <TextBlock x:Name="WelcomeText" FontSize="26" FontWeight="Bold"
                       Margin="0,0,0,24"/>

            <UniformGrid Columns="2" Rows="2">

                <Button Style="{StaticResource TileButtonStyle}" Height="180"
                        Margin="0,0,8,8">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="AssembliesCount" Text="0"
                                       FontSize="48" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Nadolazeće skupštine" FontSize="16"
                                       Foreground="#666666" TextAlignment="Center"
                                       HorizontalAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="160"/>
                        </StackPanel>
                        <fa:IconBlock Icon="ArrowRight" FontSize="18" Foreground="#CCCCCC"
                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                      Margin="0,0,14,14"/>
                    </Grid>
                </Button>

                <Button Style="{StaticResource TileButtonStyle}" Height="180"
                        Margin="8,0,0,8" Click="NavHelpBoard_Click">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="HelpPostsCount" Text="0"
                                       FontSize="48" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Aktivni oglasi za pomoć" FontSize="16"
                                       Foreground="#666666" TextAlignment="Center"
                                       HorizontalAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="160"/>
                        </StackPanel>
                        <fa:IconBlock Icon="ArrowRight" FontSize="18" Foreground="#CCCCCC"
                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                      Margin="0,0,14,14"/>
                    </Grid>
                </Button>

                <Button Style="{StaticResource TileButtonStyle}" Height="180"
                        Margin="0,8,8,0" Click="NavIssues_Click">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="IssuesCount" Text="0"
                                       FontSize="48" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Nerešeni problemi" FontSize="16"
                                       Foreground="#666666" TextAlignment="Center"
                                       HorizontalAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="160"/>
                        </StackPanel>
                        <fa:IconBlock Icon="ArrowRight" FontSize="18" Foreground="#CCCCCC"
                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                      Margin="0,0,14,14"/>
                    </Grid>
                </Button>

                <Button Style="{StaticResource TileButtonStyle}" Height="180"
                        Margin="8,8,0,0" Click="NavBuildings_Click">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="PendingRequestsCount" Text="0"
                                       FontSize="48" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Zahtev za pristup na čekanju" FontSize="16"
                                       Foreground="#666666" TextAlignment="Center"
                                       HorizontalAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="160"/>
                        </StackPanel>
                        <fa:IconBlock Icon="ArrowRight" FontSize="18" Foreground="#CCCCCC"
                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                      Margin="0,0,14,14"/>
                    </Grid>
                </Button>

            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</Page>
