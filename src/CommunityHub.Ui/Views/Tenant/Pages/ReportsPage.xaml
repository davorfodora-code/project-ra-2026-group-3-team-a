<Page x:Class="CommunityHub.Ui.Views.Tenant.Pages.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
      Background="#F5F5F5">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28">

            <!-- Page header -->
            <TextBlock Text="Generiši izveštaj" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,2"/>
            <TextBlock Text="Zakazani termini pomoći"
                       FontSize="20" Foreground="#555555" Margin="0,0,0,20"/>

            <!-- Filter card -->
            <Border Background="White" CornerRadius="10" Padding="24,20" Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.07" Color="#000000"/>
                </Border.Effect>
                <StackPanel>

                    <!-- Info text -->
                    <Border Background="#F0F4F8" CornerRadius="6" Padding="12,10" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="CircleInfo" FontSize="16" Foreground="#5B7FA6"
                                          Margin="0,0,10,0" VerticalAlignment="Top"/>
                            <TextBlock Text="Izveštaj obuhvata sve rezervacije termina – i one koje ste vi napravili i one koje su drugi napravili na vašim oglasima."
                                       FontSize="14" Foreground="#444444"
                                       TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </Border>

                    <!-- Date row -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Od:" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                        FontSize="14"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Do:" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}"
                                        FontSize="14"/>
                        </StackPanel>
                    </Grid>

                    <!-- Type + Generate row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tip pomoći:" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding TypeOptions}"
                                      SelectedItem="{Binding SelectedType, Mode=TwoWay}"
                                      FontSize="14" Padding="10,6"/>
                        </StackPanel>

                        <Button Grid.Column="2" VerticalAlignment="Bottom"
                                Click="Generate_Click"
                                Style="{StaticResource PrimaryBtnStyle}"
                                Padding="20,10">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconBlock Icon="FilePdf" FontSize="16" Foreground="White"
                                              Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Generiši PDF" FontSize="15"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Error banner -->
                    <Border Background="#FFEBEE" CornerRadius="6" Padding="10,8" Margin="0,14,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828"
                                   FontSize="14" TextWrapping="Wrap"/>
                    </Border>

                </StackPanel>
            </Border>

            <!-- Placeholder area -->
            <Border x:Name="PlaceholderCard" Background="White" CornerRadius="10" Padding="24,44">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.07" Color="#000000"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <fa:IconBlock Icon="FileLines" FontSize="52" Foreground="#CCCCCC"
                                  HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <TextBlock Text="PDF izveštaj će se otvoriti u pretraživaču"
                               FontSize="18" Foreground="#AAAAAA"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Izaberite period i tip pomoći, zatim kliknite &quot;Generiši PDF&quot;"
                               FontSize="14" Foreground="#BBBBBB"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="400" TextAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
