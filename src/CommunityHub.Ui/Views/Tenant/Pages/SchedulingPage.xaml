<Page x:Class="CommunityHub.Ui.Views.Tenant.Pages.SchedulingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
      Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab traka -->
        <Border Grid.Row="0" Background="White" Padding="24,16"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="TabMyBookingsBtn" Tag="active"
                        Style="{StaticResource TabBtnStyle}"
                        Click="TabMyBookings_Click"
                        Margin="0,0,32,0" Padding="0,0,0,12">
                    <TextBlock x:Name="TabMyBookingsText" Text="Moje rezervacije"
                               FontSize="24" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                </Button>
                <Button x:Name="TabBookedOnPostBtn"
                        Style="{StaticResource TabBtnStyle}"
                        Click="TabBookedOnPost_Click" Padding="0,0,0,12">
                    <TextBlock x:Name="TabBookedOnPostText" Text="Rezervisano na mom oglasu"
                               FontSize="22" Foreground="#888888"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ===== TAB: My bookings ===== -->
        <ScrollViewer Grid.Row="1" x:Name="MyBookingsPanel"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16,24,24">

                <!-- Sedmični grafikon -->
                <Border Background="White" CornerRadius="10" Padding="18,14" Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.07" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Moja nadolazeća nedelja" FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="WeekLabelText" FontSize="15" Foreground="#666666"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Canvas x:Name="WeeklyChartCanvas" Height="130" Margin="0,12,0,0"/>
                        <!-- Legenda -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Rectangle Width="14" Height="14" RadiusX="2" RadiusY="2"
                                       Fill="#4A5D6E" VerticalAlignment="Center"/>
                            <TextBlock Text="Nudim pomoć" FontSize="15" Foreground="#555555"
                                       Margin="6,0,20,0" VerticalAlignment="Center"/>
                            <Rectangle Width="14" Height="14" RadiusX="2" RadiusY="2"
                                       Fill="#BDC3C7" VerticalAlignment="Center"/>
                            <TextBlock Text="Tražim pomoć" FontSize="15" Foreground="#555555"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Lista rezervacija -->
                <TextBlock x:Name="NoMyBookingsText"
                           Text="Nemate rezervacija."
                           Foreground="#AAAAAA" FontSize="14"
                           HorizontalAlignment="Center" Margin="0,20,0,0"
                           Visibility="Collapsed"/>

                <ItemsControl x:Name="MyBookingsListPanel">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AdCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Avatar -->
                                    <Border Grid.Column="0" Width="38" Height="38"
                                            CornerRadius="19" Background="#ECF0F1"
                                            VerticalAlignment="Top" Margin="0,2,14,0">
                                        <TextBlock Text="{Binding OwnerName, Converter={StaticResource NameToInitials}}"
                                                   FontSize="13" FontWeight="SemiBold" Foreground="#555555"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Sadržaj -->
                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding OwnerName}"
                                                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding OwnerTypeDisplay}"
                                                   FontSize="15" Foreground="#888888" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding OwnerDescription}"
                                                   FontSize="15" Foreground="#444444"
                                                   TextWrapping="Wrap" Margin="0,0,0,8"/>

                                        <!-- Datum i kategorija -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <fa:IconBlock Icon="CalendarDays" FontSize="14" Foreground="#AAAAAA"
                                                          Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding OwnerDateRangeDisplay}"
                                                       FontSize="15" Foreground="#666666"
                                                       VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            <fa:IconBlock Icon="Tag" FontSize="14" Foreground="#AAAAAA"
                                                          Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding OwnerCategory}"
                                                       FontSize="15" Foreground="#666666"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Tvoj oglas -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="Za vaš oglas: "
                                                       FontSize="15" Foreground="#666666"/>
                                            <TextBlock Text="{Binding RequesterAdLabel}"
                                                       FontSize="15" Foreground="#666666"
                                                       FontStyle="Italic"/>
                                        </StackPanel>

                                        <!-- Termini -->
                                        <ItemsControl ItemsSource="{Binding Slots}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#CCCCCC" BorderThickness="1"
                                                            CornerRadius="4" Padding="10,6"
                                                            Margin="0,0,0,5" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding DisplayText}"
                                                                   FontSize="15" Foreground="#333333"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== TAB: Booked on my post ===== -->
        <ScrollViewer Grid.Row="1" x:Name="BookedOnPostPanel"
                      Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16,24,24">

                <TextBlock x:Name="NoBookedText"
                           Text="Niko još nije rezervisao na vašem oglasu."
                           Foreground="#AAAAAA" FontSize="16"
                           HorizontalAlignment="Center" Margin="0,20,0,0"
                           Visibility="Collapsed"/>

                <ItemsControl x:Name="BookedOnPostListPanel">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="10"
                                    Padding="18,14" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1"
                                                      Opacity="0.07" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel>

                                    <!-- Zaglavlje mog oglasa -->
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MyAdHeader}"
                                                       FontSize="20" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <fa:IconBlock Icon="CalendarDays" FontSize="14"
                                                              Foreground="#AAAAAA" Margin="0,0,5,0"
                                                              VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding MyDateRangeDisplay}"
                                                           FontSize="15" Foreground="#666666"
                                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                <fa:IconBlock Icon="Tag" FontSize="14"
                                                              Foreground="#AAAAAA" Margin="0,0,5,0"
                                                              VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding MyCategory}"
                                                           FontSize="15" Foreground="#666666"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Bedž statusa -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                CornerRadius="4" Padding="10,4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#D4EDDA"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="#EEEEEE"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="14">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#155724"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Foreground" Value="#666666"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>

                                    <!-- Separator -->
                                    <Border BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
                                            Margin="0,0,0,12"/>

                                    <!-- Lista rezervatora -->
                                    <ItemsControl ItemsSource="{Binding Bookers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Avatar -->
                                                    <Border Grid.Column="0" Width="38" Height="38"
                                                            CornerRadius="19" Background="#ECF0F1"
                                                            VerticalAlignment="Top" Margin="0,2,12,0">
                                                        <TextBlock Text="{Binding BookerName, Converter={StaticResource NameToInitials}}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="#555555"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Sadržaj -->
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding BookerName}"
                                                                   FontSize="20" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding BookerTypeDisplay}"
                                                                   FontSize="15" Foreground="#888888"
                                                                   Margin="0,2,0,4"/>
                                                        <TextBlock Text="{Binding BookerAdDescription}"
                                                                   FontSize="15" Foreground="#444444"
                                                                   FontStyle="Italic"
                                                                   TextWrapping="Wrap" Margin="0,0,0,8"/>

                                                        <!-- Termini -->
                                                        <ItemsControl ItemsSource="{Binding Slots}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BorderBrush="#CCCCCC"
                                                                            BorderThickness="1"
                                                                            CornerRadius="4"
                                                                            Padding="10,6"
                                                                            Margin="0,0,0,4"
                                                                            HorizontalAlignment="Left">
                                                                        <TextBlock Text="{Binding DisplayText}"
                                                                                   FontSize="13"
                                                                                   Foreground="#333333"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
