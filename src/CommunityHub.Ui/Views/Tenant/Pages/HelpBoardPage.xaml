<Page x:Class="CommunityHub.Ui.Views.Tenant.Pages.HelpBoardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
      Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: tabovi + zgrada + kreiraj -->
        <Border Grid.Row="0" Background="White" Padding="24,14,24,0"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel>
                <!-- Red 1: tabovi -->
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TabBoardBtn" Tag="active" Style="{StaticResource TabBtnStyle}"
                            Click="TabBoard_Click" Margin="0,0,32,0" Padding="0,0,0,12">
                        <TextBlock x:Name="TabBoardText" Text="Oglasi na tabli"
                                   FontSize="24" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                    </Button>
                    <Button x:Name="TabMyPostsBtn" Style="{StaticResource TabBtnStyle}"
                            Click="TabMyPosts_Click" Padding="0,0,0,12">
                        <TextBlock x:Name="TabMyPostsText" Text="Moji oglasi"
                                   FontSize="22" Foreground="#888888"/>
                    </Button>
                </StackPanel>
                <!-- Red 2: zgrada + kreiraj -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,12">
                    <TextBlock Text="Zgrada:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="16"/>
                    <ComboBox x:Name="BuildingCombo"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="BuildingCombo_SelectionChanged"
                              MinWidth="240" Padding="8,6" FontSize="15"
                              VerticalAlignment="Center"/>
                    <Button Style="{StaticResource PrimaryBtnStyle}"
                            Padding="16,8" Margin="16,0,0,0" Click="CreateAdButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="Plus" FontSize="14" Foreground="White"
                                          Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Kreiraj oglas" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== TAB: Oglasi na tabli ===== -->
        <ScrollViewer Grid.Row="1" x:Name="BoardPanel" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16,24,24">

                <Border Background="White" CornerRadius="10" Padding="18,14" Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.07" Color="#000000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Oglasi po kategoriji" FontSize="16" FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>
                            <Canvas x:Name="PieChartCanvas" Width="160" Height="160"/>
                        </StackPanel>
                        <ItemsControl Grid.Column="1" x:Name="CategoryLegend"
                                      Margin="20,36,0,0" VerticalAlignment="Top">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="14" Height="14" CornerRadius="2"
                                                Background="{Binding Color}" Margin="0,2,10,0"
                                                VerticalAlignment="Top"/>
                                        <TextBlock Text="{Binding Category}" FontSize="15"
                                                   Foreground="#555555" Width="130"/>
                                        <TextBlock Text="{Binding Count}" FontSize="15"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <TextBlock Text="Aktivni oglasi" FontSize="22" FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <TextBlock x:Name="NoBoardAdsText"
                           Text="Nema aktivnih oglasa za ovu zgradu."
                           Foreground="#AAAAAA" FontSize="16"
                           HorizontalAlignment="Center" Margin="0,20,0,0"
                           Visibility="Collapsed"/>

                <ItemsControl x:Name="BoardAdsPanel">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AdCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="38" Height="38"
                                            CornerRadius="19" Background="#ECF0F1"
                                            VerticalAlignment="Top" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding TenantName, Converter={StaticResource NameToInitials}}"
                                                   FontSize="13" FontWeight="SemiBold" Foreground="#555555"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <TextBlock Text="{Binding TenantName}"
                                                       FontSize="20" FontWeight="SemiBold"/>
                                            <TextBlock Text=" [VI]" FontSize="15" Foreground="#888888"
                                                       Visibility="{Binding IsOwn, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding TypeDisplay}"
                                                   FontSize="15" Foreground="#888888" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <fa:IconBlock Icon="CalendarDays" FontSize="14" Foreground="#AAAAAA"
                                                          Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DateRangeDisplay}" FontSize="15"
                                                       Foreground="#666666" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            <fa:IconBlock Icon="Tag" FontSize="14" Foreground="#AAAAAA"
                                                          Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Category}" FontSize="15"
                                                       Foreground="#666666" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Button Content="Arhiviraj" Tag="{Binding Id}"
                                                Click="ArchiveButton_Click" Padding="14,8"
                                                FontSize="14" Cursor="Hand"
                                                Visibility="{Binding IsOwn, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== TAB: Moji oglasi ===== -->
        <ScrollViewer Grid.Row="1" x:Name="MyPostsPanel" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16,24,24">

                <TextBlock Text="Moji aktivni oglasi" FontSize="22" FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <TextBlock x:Name="NoMyAdsText" Text="Nemate aktivnih oglasa."
                           Foreground="#AAAAAA" FontSize="16"
                           HorizontalAlignment="Center" Margin="0,20,0,0"
                           Visibility="Collapsed"/>

                <ItemsControl x:Name="MyAdsPanel">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AdCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding TypeDisplay}"
                                                   FontSize="20" FontWeight="SemiBold"/>
                                        <Button Content="Arhiviraj" Tag="{Binding Id}"
                                                Click="ArchiveButton_Click"
                                                HorizontalAlignment="Right"
                                                Padding="14,7" FontSize="15" Cursor="Hand"/>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding Description}"
                                               FontSize="15" Foreground="#444444"
                                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <fa:IconBlock Icon="CalendarDays" FontSize="14" Foreground="#AAAAAA"
                                                      Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DateRangeDisplay}" FontSize="15"
                                                   Foreground="#666666" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        <fa:IconBlock Icon="Tag" FontSize="14" Foreground="#AAAAAA"
                                                      Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Category}" FontSize="15"
                                                   Foreground="#666666" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        <Border Background="#D4EDDA" CornerRadius="8" Padding="8,4">
                                            <StackPanel Orientation="Horizontal">
                                                <fa:IconBlock Icon="CircleCheck" FontSize="13" Foreground="#155724"
                                                              Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Aktivan" FontSize="14"
                                                           Foreground="#155724" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
