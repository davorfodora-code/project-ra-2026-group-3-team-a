<Page x:Class="CommunityHub.Ui.Views.Tenant.Pages.CommonRoomsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
      Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: tabovi + zgrada -->
        <Border Grid.Row="0" Background="White" Padding="24,16"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="TabRoomsBtn" Tag="active" Style="{StaticResource TabBtnStyle}"
                            Click="TabRooms_Click" Margin="0,0,32,0" Padding="0,0,0,12">
                        <TextBlock x:Name="TabRoomsText" Text="Prostorije"
                                   FontSize="24" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                    </Button>
                    <Button x:Name="TabRequestsBtn" Style="{StaticResource TabBtnStyle}"
                            Click="TabRequests_Click" Padding="0,0,0,12">
                        <TextBlock x:Name="TabRequestsText" Text="Moji zahtevi"
                                   FontSize="22" Foreground="#888888"/>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Zgrada:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="16"/>
                    <ComboBox x:Name="BuildingCombo"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="BuildingCombo_SelectionChanged"
                              MinWidth="240" Padding="8,6" FontSize="15"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== TAB: Prostorije ===== -->
        <ScrollViewer Grid.Row="1" x:Name="RoomsPanel" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16,24,24">

                <TextBlock x:Name="NoRoomsText"
                           Text="Ova zgrada nema zajedničkih prostorija."
                           Foreground="#AAAAAA" FontSize="16"
                           HorizontalAlignment="Center" Margin="0,20,0,0"
                           Visibility="Collapsed"/>

                <ItemsControl x:Name="RoomsListPanel">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="10"
                                    Padding="18,16" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1"
                                                      Opacity="0.07" Color="#000000"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Info -->
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="15" Foreground="#555555"
                                                   TextWrapping="Wrap" Margin="0,0,0,12"/>
                                        <StackPanel Orientation="Horizontal">
                                            <fa:IconBlock Icon="House" FontSize="14" Foreground="#AAAAAA"
                                                          Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding FloorDisplay}"
                                                       FontSize="15" Foreground="#666666"
                                                       VerticalAlignment="Center" Margin="0,0,18,0"/>
                                            <fa:IconBlock Icon="Clock" FontSize="14" Foreground="#AAAAAA"
                                                          Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding RentalTypeDisplay}"
                                                       FontSize="15" Foreground="#666666"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Dugme Iznajmi -->
                                    <Button Grid.Column="1"
                                            Content="Iznajmi"
                                            Tag="{Binding RoomId}"
                                            Style="{StaticResource PrimaryBtnStyle}"
                                            Padding="18,10" FontSize="15"
                                            VerticalAlignment="Center"
                                            Click="RentButton_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== TAB: Moji zahtevi ===== -->
        <ScrollViewer Grid.Row="1" x:Name="RequestsPanel"
                      Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16,24,24">

                <TextBlock x:Name="NoRequestsText"
                           Text="Nemate zahteva za iznajmljivanje."
                           Foreground="#AAAAAA" FontSize="16"
                           HorizontalAlignment="Center" Margin="0,20,0,0"
                           Visibility="Collapsed"/>

                <ItemsControl x:Name="RequestsListPanel">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="10"
                                    Padding="18,16" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1"
                                                      Opacity="0.07" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel>

                                    <!-- Zaglavlje: ime + status badge -->
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="{Binding RoomName}"
                                                   FontSize="20" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                CornerRadius="12" Padding="12,5">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FFF3CD"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="ProposedCounter">
                                                            <Setter Property="Background" Value="#D1ECF1"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                            <Setter Property="Background" Value="#D4EDDA"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                            <Setter Property="Background" Value="#F8D7DA"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                            <Setter Property="Background" Value="#E9ECEF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="14">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#856404"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="ProposedCounter">
                                                                <Setter Property="Foreground" Value="#0C5460"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                                <Setter Property="Foreground" Value="#155724"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                                <Setter Property="Foreground" Value="#721C24"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                                <Setter Property="Foreground" Value="#6C757D"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>

                                    <!-- Tip iznajmljivanja -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <fa:IconBlock Icon="Clock" FontSize="14" Foreground="#AAAAAA"
                                                      Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding RentalTypeDisplay}"
                                                   FontSize="15" Foreground="#666666"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Zahtevani opseg (za sve osim ProposedCounter) -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <fa:IconBlock Icon="CalendarDays" FontSize="14" Foreground="#AAAAAA"
                                                      Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding RequestedDateRangeDisplay}"
                                                   FontSize="15" Foreground="#444444"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Predloženi termini (samo za ProposedCounter) -->
                                    <StackPanel Visibility="{Binding IsProposedCounter,
                                                    Converter={StaticResource BoolToVisibility}}"
                                                Margin="0,6,0,8">
                                        <TextBlock Text="Upravnik je predložio nove termine:"
                                                   FontSize="15" Foreground="#555555" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding RequestedDateRangeDisplay}"
                                                       FontSize="15" Foreground="#888888">
                                                <TextBlock.TextDecorations>
                                                    <TextDecoration Location="Strikethrough"/>
                                                </TextBlock.TextDecorations>
                                            </TextBlock>
                                            <TextBlock Text=" → " FontSize="15" Foreground="#555555"/>
                                            <TextBlock Text="{Binding ProposedDateRangeDisplay}"
                                                       FontSize="15" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Odobreni datum (samo za Approved single-day) -->
                                    <Border Visibility="{Binding ApprovedDate,
                                                Converter={StaticResource NullToCollapsed}}"
                                            Background="#EAF7ED" CornerRadius="6" Padding="12,6"
                                            HorizontalAlignment="Left" Margin="0,6,0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:IconBlock Icon="CircleCheck" FontSize="14" Foreground="#155724"
                                                          Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock FontSize="15" Foreground="#155724" VerticalAlignment="Center"
                                                       Text="{Binding ApprovedDateDisplay,
                                                           StringFormat='Odobreni datum: {0}'}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Akciona dugmad -->
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                Visibility="{Binding CanCancel,
                                                    Converter={StaticResource BoolToVisibility}}">
                                        <!-- Prihvati promen termina (samo ProposedCounter) -->
                                        <Button Content="Prihvati novi termin"
                                                Tag="{Binding RequestId}"
                                                Style="{StaticResource PrimaryBtnStyle}"
                                                Padding="14,8" FontSize="15"
                                                Margin="0,0,10,0"
                                                Visibility="{Binding IsProposedCounter,
                                                    Converter={StaticResource BoolToVisibility}}"
                                                Click="AcceptDate_Click"/>
                                        <!-- Otkaži zahtev -->
                                        <Button Content="Otkaži zahtev"
                                                Tag="{Binding RequestId}"
                                                Style="{StaticResource SecondaryBtnStyle}"
                                                Padding="14,8" FontSize="15"
                                                Click="CancelRequest_Click"/>
                                    </StackPanel>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
