<Window x:Class="CommunityHub.Ui.Views.Tenant.BuildingSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pretraga zgrada" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Naslov i nazad dugme -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="← Nazad" Click="BackButton_Click"
                    Padding="10,5" Margin="0,0,15,0" VerticalAlignment="Center"/>
            <TextBlock Text="Pretraga zgrada" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Filteri za pretragu -->
        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Adresa:" Margin="0,0,0,5"/>
                    <TextBox x:Name="AddressTextBox" Padding="5" TextChanged="FilterTextBox_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Naselje:" Margin="0,0,0,5"/>
                    <TextBox x:Name="NeighborhoodTextBox" Padding="5" TextChanged="FilterTextBox_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Grad:" Margin="0,0,0,5"/>
                    <TextBox x:Name="CityTextBox" Padding="5" TextChanged="FilterTextBox_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <TextBlock Text="Država:" Margin="0,0,0,5"/>
                    <TextBox x:Name="CountryTextBox" Padding="5" TextChanged="FilterTextBox_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="8" VerticalAlignment="Bottom">
                    <Button Content="Pretraži" Click="SearchButton_Click"
                            Padding="20,7" FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Rezultati pretrage -->
        <DataGrid Grid.Row="2" x:Name="BuildingsDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  BorderBrush="#CCCCCC"
                  SelectionChanged="BuildingsDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Adresa" Binding="{Binding AddressDisplay}" Width="*"/>
                <DataGridTextColumn Header="Naselje" Binding="{Binding Neighborhood}" Width="*"/>
                <DataGridTextColumn Header="Lokacija" Binding="{Binding LocationDisplay}" Width="*"/>
                <DataGridTextColumn Header="Broj spratova" Binding="{Binding NumberOfFloors}" Width="Auto"/>
                <DataGridTextColumn Header="Broj stanova" Binding="{Binding TotalApartments}" Width="Auto"/>
                <DataGridTextColumn Header="Broj slika" Binding="{Binding ImageCount}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Dugme za podnošenje zahteva -->
        <Button Grid.Row="2" x:Name="AccessRequestButton"
                Content="Podnesi zahtev za pristup"
                Click="AccessRequestButton_Click"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,5,5"
                Padding="15,8"
                FontSize="13"
                IsEnabled="False"/>

        <!-- Slike selektovane zgrade -->
        <Border Grid.Row="3" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5"
                Padding="10" Margin="0,10,0,0"
                x:Name="ImagesBorder" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Slike zgrade:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ListBox x:Name="ImagesListBox" Height="100"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding}" Height="90" Margin="5,0"
                                   Stretch="Uniform"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="NoImagesText" Text="Nema slika za ovu zgradu."
                           Visibility="Collapsed" Foreground="Gray" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
