<Window x:Class="CommunityHub.Ui.Views.Tenant.TenantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="CommunityHub" Height="768" Width="1024"
        WindowStartupLocation="CenterScreen"
        MinHeight="600" MinWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Leva navigacijska traka -->
        <Border Grid.Column="0" Background="#2C3E50">
            <StackPanel Margin="0,8,0,0">

                    <!-- Home -->
                    <Grid>
                        <Border x:Name="NavHomeHighlight" Background="#243342">
                            <Border Width="4" HorizontalAlignment="Left" Background="White"/>
                        </Border>
                        <Button Style="{StaticResource SideNavStyle}" Click="NavHome_Click">
                            <StackPanel Orientation="Horizontal" Margin="20,16">
                                <fa:IconBlock x:Name="NavHomeIcon" Icon="House" FontSize="26"
                                              Foreground="White" VerticalAlignment="Center"
                                              Width="36" TextAlignment="Center"/>
                                <TextBlock x:Name="NavHomeText" Text="Početna" Foreground="White"
                                           FontSize="22" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Zgrade -->
                    <Grid>
                        <Border x:Name="NavZgradeHighlight" Background="#243342"
                                Visibility="Collapsed">
                            <Border Width="4" HorizontalAlignment="Left" Background="White"/>
                        </Border>
                        <Button Style="{StaticResource SideNavStyle}" Click="NavZgrade_Click">
                            <StackPanel Orientation="Horizontal" Margin="20,16">
                                <fa:IconBlock x:Name="NavZgradeIcon" Icon="Building" FontSize="26"
                                              Foreground="#B0BEC5" VerticalAlignment="Center"
                                              Width="36" TextAlignment="Center"/>
                                <TextBlock x:Name="NavZgradeText" Text="Zgrade" Foreground="#B0BEC5"
                                           FontSize="22" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Oglasna tabla -->
                    <Grid>
                        <Border x:Name="NavOglasnaHighlight" Background="#243342"
                                Visibility="Collapsed">
                            <Border Width="4" HorizontalAlignment="Left" Background="White"/>
                        </Border>
                        <Button Style="{StaticResource SideNavStyle}" Click="NavOglasna_Click">
                            <StackPanel Orientation="Horizontal" Margin="20,16">
                                <fa:IconBlock x:Name="NavOglasnaIcon" Icon="CircleInfo" FontSize="26"
                                              Foreground="#B0BEC5" VerticalAlignment="Center"
                                              Width="36" TextAlignment="Center"/>
                                <TextBlock x:Name="NavOglasnaText" Text="Oglasna tabla"
                                           Foreground="#B0BEC5" FontSize="22"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Zakazivanje -->
                    <Grid>
                        <Border x:Name="NavZakazivanjeHighlight" Background="#243342"
                                Visibility="Collapsed">
                            <Border Width="4" HorizontalAlignment="Left" Background="White"/>
                        </Border>
                        <Button Style="{StaticResource SideNavStyle}" Click="NavZakazivanje_Click">
                            <StackPanel Orientation="Horizontal" Margin="20,16">
                                <fa:IconBlock x:Name="NavZakazivanjeIcon" Icon="CalendarCheck" FontSize="26"
                                              Foreground="#B0BEC5" VerticalAlignment="Center"
                                              Width="36" TextAlignment="Center"/>
                                <TextBlock x:Name="NavZakazivanjeText" Text="Zakazivanje"
                                           Foreground="#B0BEC5" FontSize="22"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <!-- Zajedničke prostorije -->
                    <Grid>
                        <Border x:Name="NavZajednickeHighlight" Background="#243342"
                                Visibility="Collapsed">
                            <Border Width="4" HorizontalAlignment="Left" Background="White"/>
                        </Border>
                        <Button Style="{StaticResource SideNavStyle}" Click="NavZajednicke_Click">
                            <StackPanel Orientation="Horizontal" Margin="20,16">
                                <fa:IconBlock x:Name="NavZajednickeIcon" Icon="DoorOpen" FontSize="26"
                                              Foreground="#B0BEC5" VerticalAlignment="Center"
                                              Width="36" TextAlignment="Center"/>
                                <TextBlock x:Name="NavZajednickeText" Text="Zajedničke sobe"
                                           Foreground="#B0BEC5" FontSize="22"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <!-- Problemi -->
                    <Grid>
                        <Border x:Name="NavProblemiHighlight" Background="#243342"
                                Visibility="Collapsed">
                            <Border Width="4" HorizontalAlignment="Left" Background="White"/>
                        </Border>
                        <Button Style="{StaticResource SideNavStyle}" Click="NavProblemi_Click">
                            <StackPanel Orientation="Horizontal" Margin="20,16">
                                <fa:IconBlock x:Name="NavProblemiIcon" Icon="CircleExclamation"
                                              FontSize="26" Foreground="#B0BEC5"
                                              VerticalAlignment="Center" Width="36" TextAlignment="Center"/>
                                <TextBlock x:Name="NavProblemiText" Text="Problemi"
                                           Foreground="#B0BEC5" FontSize="22"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="20,16" Opacity="0.35">
                        <fa:IconBlock Icon="PeopleGroup" FontSize="26" Foreground="#B0BEC5"
                                      VerticalAlignment="Center" Width="36" TextAlignment="Center"/>
                        <TextBlock Text="Skupštine" Foreground="#B0BEC5" FontSize="22"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="20,16" Opacity="0.35">
                        <fa:IconBlock Icon="FileLines" FontSize="26" Foreground="#B0BEC5"
                                      VerticalAlignment="Center" Width="36" TextAlignment="Center"/>
                        <TextBlock Text="Izveštaji" Foreground="#B0BEC5" FontSize="22"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
            </StackPanel>
        </Border>

        <!-- Desna strana: top bar + Frame -->
        <Grid Grid.Column="1" Background="#F5F5F5">
            <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White"
                    BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <TextBlock x:Name="TopBarTitle" Text="Početna" FontSize="28" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Grid Width="40" Height="40">
                            <Button x:Name="BellButton" Style="{StaticResource CircleButtonStyle}"
                                    Width="36" Height="36" ToolTip="Obaveštenja"
                                    Click="Bell_Click">
                                <fa:IconBlock Icon="Bell" FontSize="16" Foreground="#555555"/>
                            </Button>
                            <Border x:Name="NotificationBadge" Background="#E74C3C" CornerRadius="9"
                                    Width="18" Height="18"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,0,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="NotificationBadgeText" Text="0"
                                           FontSize="11" FontWeight="SemiBold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <Border Width="36" Height="36" CornerRadius="18"
                                Background="#2C3E50" Margin="10,0,0,0"
                                Cursor="Hand" ToolTip="Profil"
                                MouseLeftButtonUp="Avatar_Click">
                            <TextBlock x:Name="UserInitialsBlock" Text="??"
                                       Foreground="White" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>

            <!-- Notification panel (floating overlay) -->
            <Border x:Name="NotificationsPanel"
                    Grid.Row="1" Panel.ZIndex="100"
                    Width="420" MaxHeight="520"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,0,16,0"
                    Background="White" CornerRadius="10"
                    BorderBrush="#E0E0E0" BorderThickness="1"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.15" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="20,14,20,14"
                            BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="Obaveštenja" FontSize="22" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Background="Transparent"
                                    BorderThickness="0" Cursor="Hand"
                                    Click="CloseNotifications_Click">
                                <fa:IconBlock Icon="Xmark" FontSize="18" Foreground="#888888"/>
                            </Button>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl x:Name="NotificationsList" Margin="0,4,0,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="12,5" Padding="14,12" Background="#FAFAFA"
                                                CornerRadius="8" BorderBrush="#E8E8E8" BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <fa:IconBlock Icon="CalendarCheck" FontSize="22"
                                                                  Foreground="#2C3E50" Margin="0,0,10,0"
                                                                  VerticalAlignment="Top"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding TitleDisplay}"
                                                                   FontSize="14" TextWrapping="Wrap"
                                                                   MaxWidth="310"/>
                                                        <TextBlock Text="{Binding TimeAgoDisplay}"
                                                                   FontSize="12" Foreground="#AAAAAA"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Tag="{Binding}" Content="{Binding ActionText}"
                                                        FontSize="13" Cursor="Hand"
                                                        HorizontalAlignment="Left"
                                                        Padding="10,5"
                                                        BorderBrush="#2C3E50" Background="Transparent"
                                                        Foreground="#2C3E50" BorderThickness="1"
                                                        Click="NotificationAction_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoNotificationsText"
                                       Text="Nema novih obaveštenja."
                                       FontSize="16" Foreground="#AAAAAA"
                                       Margin="20,16" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
