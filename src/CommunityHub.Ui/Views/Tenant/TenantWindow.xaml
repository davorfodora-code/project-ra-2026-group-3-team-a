<Window x:Class="CommunityHub.Ui.Views.Tenant.TenantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="CommunityHub" Height="768" Width="1024"
        WindowStartupLocation="CenterScreen"
        MinHeight="600" MinWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Leva navigacijska traka -->
        <Border Grid.Column="0" Background="#2C3E50">
            <StackPanel Margin="0,8,0,0">

                    <!-- Home -->
                    <Grid>
                        <Border x:Name="NavHomeHighlight" Background="#243342">
                            <Border Width="4" HorizontalAlignment="Left" Background="White"/>
                        </Border>
                        <Button Style="{StaticResource SideNavStyle}" Click="NavHome_Click">
                            <StackPanel Orientation="Horizontal" Margin="20,16">
                                <fa:IconBlock x:Name="NavHomeIcon" Icon="House" FontSize="22"
                                              Foreground="White" VerticalAlignment="Center"
                                              Width="32" TextAlignment="Center"/>
                                <TextBlock x:Name="NavHomeText" Text="Home" Foreground="White"
                                           FontSize="18" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Zgrade -->
                    <Grid>
                        <Border x:Name="NavZgradeHighlight" Background="#243342"
                                Visibility="Collapsed">
                            <Border Width="4" HorizontalAlignment="Left" Background="White"/>
                        </Border>
                        <Button Style="{StaticResource SideNavStyle}" Click="NavZgrade_Click">
                            <StackPanel Orientation="Horizontal" Margin="20,16">
                                <fa:IconBlock x:Name="NavZgradeIcon" Icon="Building" FontSize="22"
                                              Foreground="#B0BEC5" VerticalAlignment="Center"
                                              Width="32" TextAlignment="Center"/>
                                <TextBlock x:Name="NavZgradeText" Text="Zgrade" Foreground="#B0BEC5"
                                           FontSize="18" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Oglasna tabla -->
                    <Grid>
                        <Border x:Name="NavOglasnaHighlight" Background="#243342"
                                Visibility="Collapsed">
                            <Border Width="4" HorizontalAlignment="Left" Background="White"/>
                        </Border>
                        <Button Style="{StaticResource SideNavStyle}" Click="NavOglasna_Click">
                            <StackPanel Orientation="Horizontal" Margin="20,16">
                                <fa:IconBlock x:Name="NavOglasnaIcon" Icon="CircleInfo" FontSize="22"
                                              Foreground="#B0BEC5" VerticalAlignment="Center"
                                              Width="32" TextAlignment="Center"/>
                                <TextBlock x:Name="NavOglasnaText" Text="Oglasna tabla"
                                           Foreground="#B0BEC5" FontSize="18"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Zakazivanje -->
                    <Grid>
                        <Border x:Name="NavZakazivanjeHighlight" Background="#243342"
                                Visibility="Collapsed">
                            <Border Width="4" HorizontalAlignment="Left" Background="White"/>
                        </Border>
                        <Button Style="{StaticResource SideNavStyle}" Click="NavZakazivanje_Click">
                            <StackPanel Orientation="Horizontal" Margin="20,16">
                                <fa:IconBlock x:Name="NavZakazivanjeIcon" Icon="CalendarCheck" FontSize="22"
                                              Foreground="#B0BEC5" VerticalAlignment="Center"
                                              Width="32" TextAlignment="Center"/>
                                <TextBlock x:Name="NavZakazivanjeText" Text="Zakazivanje"
                                           Foreground="#B0BEC5" FontSize="18"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <!-- Zajedničke prostorije -->
                    <Grid>
                        <Border x:Name="NavZajednickeHighlight" Background="#243342"
                                Visibility="Collapsed">
                            <Border Width="4" HorizontalAlignment="Left" Background="White"/>
                        </Border>
                        <Button Style="{StaticResource SideNavStyle}" Click="NavZajednicke_Click">
                            <StackPanel Orientation="Horizontal" Margin="20,16">
                                <fa:IconBlock x:Name="NavZajednickeIcon" Icon="DoorOpen" FontSize="22"
                                              Foreground="#B0BEC5" VerticalAlignment="Center"
                                              Width="32" TextAlignment="Center"/>
                                <TextBlock x:Name="NavZajednickeText" Text="Zajedničke sobe"
                                           Foreground="#B0BEC5" FontSize="18"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="20,16" Opacity="0.35">
                        <fa:IconBlock Icon="CircleExclamation" FontSize="22" Foreground="#B0BEC5"
                                      VerticalAlignment="Center" Width="32" TextAlignment="Center"/>
                        <TextBlock Text="Problemi" Foreground="#B0BEC5" FontSize="18"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="20,16" Opacity="0.35">
                        <fa:IconBlock Icon="PeopleGroup" FontSize="22" Foreground="#B0BEC5"
                                      VerticalAlignment="Center" Width="32" TextAlignment="Center"/>
                        <TextBlock Text="Skupštine" Foreground="#B0BEC5" FontSize="18"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="20,16" Opacity="0.35">
                        <fa:IconBlock Icon="FileLines" FontSize="22" Foreground="#B0BEC5"
                                      VerticalAlignment="Center" Width="32" TextAlignment="Center"/>
                        <TextBlock Text="Izveštaji" Foreground="#B0BEC5" FontSize="18"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
            </StackPanel>
        </Border>

        <!-- Desna strana: top bar + Frame -->
        <Grid Grid.Column="1" Background="#F5F5F5">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White"
                    BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <TextBlock x:Name="TopBarTitle" Text="Home" FontSize="24" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource CircleButtonStyle}"
                                Width="36" Height="36" ToolTip="Obaveštenja">
                            <fa:IconBlock Icon="Bell" FontSize="16" Foreground="#555555"/>
                        </Button>
                        <Border Width="36" Height="36" CornerRadius="18"
                                Background="#2C3E50" Margin="10,0,0,0"
                                Cursor="Hand" ToolTip="Profil"
                                MouseLeftButtonUp="Avatar_Click">
                            <TextBlock x:Name="UserInitialsBlock" Text="??"
                                       Foreground="White" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
