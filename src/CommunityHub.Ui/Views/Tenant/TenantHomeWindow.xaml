<Window x:Class="CommunityHub.Ui.Views.Tenant.TenantHomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="CommunityHub" Height="768" Width="1024"
        WindowStartupLocation="CenterScreen"
        MinHeight="600" MinWidth="800">

    <Window.Resources>
        <Style x:Key="SideNavStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#243342"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Leva navigacijska traka -->
        <Border Grid.Column="0" Background="#2C3E50">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#1A252F" Padding="20,0">
                    <TextBlock Text="Community Hub" Foreground="White"
                               FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Row="1" Margin="0,8,0,0">

                    <!-- Home (aktivan) -->
                    <Border Background="#243342">
                        <Grid>
                            <Border Width="4" HorizontalAlignment="Left" Background="White"/>
                            <StackPanel Orientation="Horizontal" Margin="20,16">
                                <fa:IconBlock Icon="House" FontSize="22" Foreground="White"
                                              VerticalAlignment="Center" Width="20"/>
                                <TextBlock Text="Home" Foreground="White" FontSize="18"
                                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Zgrade -->
                    <Button Style="{StaticResource SideNavStyle}" Click="NavBuildings_Click">
                        <StackPanel Orientation="Horizontal" Margin="20,16">
                            <fa:IconBlock Icon="Building" FontSize="22" Foreground="#B0BEC5"
                                          VerticalAlignment="Center" Width="20"/>
                            <TextBlock Text="Zgrade" Foreground="#B0BEC5" FontSize="18"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Oglasna tabla -->
                    <Button Style="{StaticResource SideNavStyle}" Click="NavHelpBoard_Click">
                        <StackPanel Orientation="Horizontal" Margin="20,16">
                            <fa:IconBlock Icon="CircleInfo" FontSize="22" Foreground="#B0BEC5"
                                          VerticalAlignment="Center" Width="20"/>
                            <TextBlock Text="Oglasna tabla" Foreground="#B0BEC5" FontSize="18"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Border BorderBrush="#3D5166" BorderThickness="0,1,0,0" Margin="16,8"/>

                    <StackPanel Orientation="Horizontal" Margin="20,16" Opacity="0.35">
                        <fa:IconBlock Icon="CalendarCheck" FontSize="22" Foreground="#B0BEC5"
                                      VerticalAlignment="Center" Width="20"/>
                        <TextBlock Text="Zakazivanje" Foreground="#B0BEC5" FontSize="18"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="20,16" Opacity="0.35">
                        <fa:IconBlock Icon="DoorOpen" FontSize="22" Foreground="#B0BEC5"
                                      VerticalAlignment="Center" Width="20"/>
                        <TextBlock Text="Zajedničke sobe" Foreground="#B0BEC5" FontSize="18"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="20,16" Opacity="0.35">
                        <fa:IconBlock Icon="CircleExclamation" FontSize="22" Foreground="#B0BEC5"
                                      VerticalAlignment="Center" Width="20"/>
                        <TextBlock Text="Problemi" Foreground="#B0BEC5" FontSize="18"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="20,16" Opacity="0.35">
                        <fa:IconBlock Icon="PeopleGroup" FontSize="22" Foreground="#B0BEC5"
                                      VerticalAlignment="Center" Width="20"/>
                        <TextBlock Text="Skupštine" Foreground="#B0BEC5" FontSize="18"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="20,16" Opacity="0.35">
                        <fa:IconBlock Icon="FileLines" FontSize="22" Foreground="#B0BEC5"
                                      VerticalAlignment="Center" Width="20"/>
                        <TextBlock Text="Izveštaji" Foreground="#B0BEC5" FontSize="18"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </Border>

        <!-- Desni sadržaj -->
        <Grid Grid.Column="1" Background="#F5F5F5">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Gornji bar -->
            <Border Grid.Row="0" Background="White"
                    BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <TextBlock Text="Home" FontSize="24" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource CircleButtonStyle}"
                                Width="36" Height="36" ToolTip="Obaveštenja">
                            <fa:IconBlock Icon="Bell" FontSize="16" Foreground="#555555"/>
                        </Button>
                        <Border Width="36" Height="36" CornerRadius="18"
                                Background="#2C3E50" Margin="10,0,0,0"
                                Cursor="Hand" ToolTip="Profil"
                                MouseLeftButtonUp="Avatar_Click">
                            <TextBlock x:Name="UserInitialsBlock" Text="??"
                                       Foreground="White" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sadržaj -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24,28,28">

                    <TextBlock x:Name="WelcomeText" FontSize="26" FontWeight="Bold"
                               Margin="0,0,0,24"/>

                    <UniformGrid Columns="2" Rows="2">

                        <Button Style="{StaticResource TileButtonStyle}" Height="180"
                                Margin="0,0,8,8">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="AssembliesCount" Text="0"
                                           FontSize="48" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Nadolazeće skupštine" FontSize="14"
                                           Foreground="#666666" TextAlignment="Center"
                                           HorizontalAlignment="Center" TextWrapping="Wrap"
                                           MaxWidth="140"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource TileButtonStyle}" Height="180"
                                Margin="8,0,0,8" Click="NavHelpBoard_Click">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="HelpPostsCount" Text="0"
                                           FontSize="48" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Aktivni oglasi za pomoć" FontSize="14"
                                           Foreground="#666666" TextAlignment="Center"
                                           HorizontalAlignment="Center" TextWrapping="Wrap"
                                           MaxWidth="140"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource TileButtonStyle}" Height="180"
                                Margin="0,8,8,0">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="IssuesCount" Text="0"
                                           FontSize="48" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Nerešeni problemi" FontSize="14"
                                           Foreground="#666666" TextAlignment="Center"
                                           HorizontalAlignment="Center" TextWrapping="Wrap"
                                           MaxWidth="140"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource TileButtonStyle}" Height="180"
                                Margin="8,8,0,0" Click="NavBuildings_Click">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="PendingRequestsCount" Text="0"
                                           FontSize="48" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Zahtev za pristup na čekanju" FontSize="14"
                                           Foreground="#666666" TextAlignment="Center"
                                           HorizontalAlignment="Center" TextWrapping="Wrap"
                                           MaxWidth="140"/>
                            </StackPanel>
                        </Button>

                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
