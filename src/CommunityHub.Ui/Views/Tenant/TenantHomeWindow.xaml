<Window x:Class="CommunityHub.Ui.Views.Tenant.TenantHomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stanar - Početna" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Profil"
                        Click="ProfileButton_Click"
                        Padding="15,8"
                        Margin="0,0,10,0"
                        FontSize="14"/>
                <Button Content="Odjavi se"
                        Click="LogoutButton_Click"
                        Padding="15,8"
                        FontSize="14"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button Content="Pretraga zgrada"
                    Click="BuildingSearchButton_Click"
                    Padding="20,10"
                    Margin="0,0,0,15"
                    FontSize="16"/>
            <Button Content="Moji zahtevi za pristup"
                    Click="MyRequestsButton_Click"
                    Padding="20,10"
                    FontSize="16"/>
        </StackPanel>
    </Grid>
</Window>
