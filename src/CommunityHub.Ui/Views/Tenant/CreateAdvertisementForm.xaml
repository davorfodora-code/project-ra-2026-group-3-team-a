<Window x:Class="CommunityHub.Ui.Views.Tenant.CreateAdvertisementForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="Kreiraj oglas" SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="TypeToggleStyle" TargetType="RadioButton">
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#2C3E50"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="#2C3E50"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#ECF0F1"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="#3D5166"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Naslov -->
        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock Text="Kreiraj oglas" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="BuildingSubtitle" Text=""
                       FontSize="13" Foreground="#888888" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Tip oglasa (toggle) -->
        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="Tip oglasa" FontSize="13" Foreground="#888888" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="SeekingRadio" Content="Tražim pomoć"
                             Style="{StaticResource TypeToggleStyle}"
                             GroupName="AdType" Margin="0,0,8,0"/>
                <RadioButton x:Name="OfferingRadio" Content="Nudim pomoć"
                             Style="{StaticResource TypeToggleStyle}"
                             GroupName="AdType" IsChecked="True"/>
            </StackPanel>
        </StackPanel>

        <!-- Opis -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="Opis" FontSize="13" Foreground="#888888" Margin="0,0,0,6"/>
            <TextBox x:Name="DescriptionBox" Height="80" TextWrapping="Wrap"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     Padding="10,8" BorderBrush="#DDDDDD" BorderThickness="1" FontSize="14"/>
            <TextBlock Text="{Binding DescriptionError}" Foreground="#C0392B" FontSize="13"
                       TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding HasDescriptionError, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>

        <!-- Kategorija -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Kategorija" FontSize="13" Foreground="#888888" Margin="0,0,0,6"/>
                <ComboBox x:Name="CategoryCombo" Padding="8,6" FontSize="14" SelectedIndex="0">
                    <ComboBoxItem>Selidba</ComboBoxItem>
                    <ComboBoxItem>Popravke uređaja</ComboBoxItem>
                    <ComboBoxItem>Pozajmljivanje</ComboBoxItem>
                    <ComboBoxItem>Čišćenje</ComboBoxItem>
                    <ComboBoxItem>Ostalo</ComboBoxItem>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Datum od" FontSize="13" Foreground="#888888" Margin="0,0,0,6"/>
                <DatePicker x:Name="StartDatePicker" Padding="6,5" FontSize="14"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Datum do" FontSize="13" Foreground="#888888" Margin="0,0,0,6"/>
                <DatePicker x:Name="EndDatePicker" Padding="6,5" FontSize="14"/>
            </StackPanel>
        </Grid>

        <!-- Greška -->
        <TextBlock Grid.Row="5" x:Name="ErrorText"
                   Text="{Binding ErrorMessage}"
                   Foreground="#C0392B" FontSize="13"
                   TextWrapping="Wrap" Margin="0,8,0,0"/>

        <!-- Dugmad -->
        <StackPanel Grid.Row="7" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Click="CancelButton_Click" Padding="18,8" Margin="0,0,10,0"
                    FontSize="14" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock Icon="Xmark" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Otkaži" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Click="CreateButton_Click" Padding="18,8" FontSize="14"
                    FontWeight="SemiBold" Cursor="Hand"
                    Background="#2C3E50" Foreground="White" BorderThickness="0">
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock Icon="Plus" FontSize="13" Foreground="White"
                                  Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Kreiraj oglas" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

    </Grid>
</Window>
