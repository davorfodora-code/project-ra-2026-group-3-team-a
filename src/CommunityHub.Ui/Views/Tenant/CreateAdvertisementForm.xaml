<Window x:Class="CommunityHub.Ui.Views.Tenant.CreateAdvertisementForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kreiraj oglas" Height="440" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tip oglasa:"
                   VerticalAlignment="Center" Margin="0,8"/>
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,8">
            <RadioButton x:Name="OfferingRadio" Content="Nudim pomoć"
                         IsChecked="True" Margin="0,0,20,0"/>
            <RadioButton x:Name="SeekingRadio" Content="Tražim pomoć"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Kategorija:"
                   VerticalAlignment="Center" Margin="0,8"/>
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CategoryCombo"
                  SelectedIndex="0" Margin="0,8">
            <ComboBoxItem>Selidba</ComboBoxItem>
            <ComboBoxItem>Popravke uređaja</ComboBoxItem>
            <ComboBoxItem>Pozajmljivanje</ComboBoxItem>
            <ComboBoxItem>Čišćenje</ComboBoxItem>
            <ComboBoxItem>Ostalo</ComboBoxItem>
        </ComboBox>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Datum od:"
                   VerticalAlignment="Center" Margin="0,8"/>
        <DatePicker Grid.Row="2" Grid.Column="1" x:Name="StartDatePicker" Margin="0,8"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Datum do:"
                   VerticalAlignment="Center" Margin="0,8"/>
        <DatePicker Grid.Row="3" Grid.Column="1" x:Name="EndDatePicker" Margin="0,8"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Opis:"
                   VerticalAlignment="Top" Margin="0,12,0,0"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="DescriptionBox"
                 Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" Margin="0,8"/>

        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="ErrorText"
                   Foreground="Red" TextWrapping="Wrap" Margin="0,2"/>

        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Kreiraj" Click="CreateButton_Click"
                    Padding="15,8" Margin="0,0,10,0"/>
            <Button Content="Otkaži" Click="CancelButton_Click"
                    Padding="15,8"/>
        </StackPanel>
    </Grid>
</Window>
