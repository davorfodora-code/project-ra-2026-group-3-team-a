<Window x:Class="CommunityHub.Ui.Views.Tenant.BuildingAccessRequestForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="Zahtev za pristup zgradi" Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">

    <Border Background="White" CornerRadius="0">
        <StackPanel Margin="28,24,28,24">

            <!-- Naslov -->
            <TextBlock Text="Zahtev za pristup zgradi"
                       FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <!-- Info o zgradi (read-only, bez izgleda input polja) -->
            <Border Background="#F5F5F5" CornerRadius="8" Padding="14,10" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock x:Name="BuildingAddressText" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="BuildingLocationText" FontSize="13" Foreground="#666666"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Izbor broja stana -->
            <TextBlock Text="Izaberite broj stana:" FontSize="13" Margin="0,0,0,6"/>
            <ComboBox x:Name="ApartmentComboBox"
                      Padding="10,8" BorderBrush="#DDDDDD" BorderThickness="1"
                      FontSize="14" Width="160" HorizontalAlignment="Left"
                      SelectionChanged="ApartmentComboBox_SelectionChanged"/>

            <!-- Upozorenje (zauzet stan) -->
            <Border x:Name="WarningBorder" Visibility="Collapsed"
                    Background="#FFF8E1" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock Icon="TriangleExclamation" FontSize="15"
                                  Foreground="#F57C00" VerticalAlignment="Top" Margin="0,1,10,0"/>
                    <TextBlock x:Name="WarningTextBlock" TextWrapping="Wrap"
                               Foreground="#7B4F00" FontSize="12" MaxWidth="330"/>
                </StackPanel>
            </Border>

            <!-- Greška -->
            <TextBlock x:Name="ErrorTextBlock" Foreground="#C0392B" FontSize="12"
                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0"/>

            <!-- Dugmad -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Content="Otkaži"
                        Click="CancelButton_Click"
                        Padding="18,8" Margin="0,0,10,0"
                        FontSize="13" Cursor="Hand"/>
                <Button x:Name="ConfirmButton" Content="Podnesi"
                        Click="ConfirmButton_Click"
                        Padding="18,8" FontSize="13" FontWeight="SemiBold"
                        Background="#2C3E50" Foreground="White"
                        BorderThickness="0" Cursor="Hand"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
