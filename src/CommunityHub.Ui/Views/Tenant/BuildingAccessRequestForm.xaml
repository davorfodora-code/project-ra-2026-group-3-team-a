<Window x:Class="CommunityHub.Ui.Views.Tenant.BuildingAccessRequestForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zahtev za pristup zgradi" Height="280" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Podnošenje zahteva za pristup zgradi"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="1" Text="Broj stana:" Margin="0,0,0,5"/>
        <TextBox Grid.Row="2" x:Name="ApartmentNumberTextBox"
                 Padding="5" Margin="0,0,0,10"
                 TextChanged="ApartmentNumberTextBox_TextChanged"/>

        <!-- Upozorenje da je stan zauzet -->
        <TextBlock Grid.Row="3" x:Name="WarningTextBlock"
                   Text="Upozorenje: za ovaj stan je već učlanjen stanar!"
                   Foreground="OrangeRed" FontWeight="SemiBold"
                   TextWrapping="Wrap" Visibility="Collapsed"
                   Margin="0,0,0,10"/>

        <!-- Greška -->
        <TextBlock Grid.Row="4" x:Name="ErrorTextBlock"
                   Foreground="Red" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Potvrdi zahtev" Click="ConfirmButton_Click"
                    Padding="15,8" Margin="0,0,10,0" FontWeight="SemiBold"/>
            <Button Content="Odustani" Click="CancelButton_Click" Padding="15,8"/>
        </StackPanel>
    </Grid>
</Window>
