<Window x:Class="CommunityHub.Ui.Views.Tenant.RentRequestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="Iznajmljivanje prostorije"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <StackPanel Margin="28,24,28,24">

        <!-- Naslov -->
        <TextBlock Text="Zatraži iznajmljivanje prostorije"
                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="Izaberite željene datume"
                   FontSize="14" Foreground="#888888" Margin="0,0,0,16"/>

        <!-- Kartica prostorije -->
        <Border Background="White" CornerRadius="10" Padding="16,14" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.07" Color="#000000"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="RoomNameText" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock x:Name="RoomDescText" FontSize="14" Foreground="#555555"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock Icon="House" FontSize="13" Foreground="#AAAAAA"
                                  Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RoomFloorText" FontSize="13" Foreground="#666666"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <fa:IconBlock Icon="Clock" FontSize="13" Foreground="#AAAAAA"
                                  Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RoomTypeText" FontSize="13" Foreground="#666666"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Date pickers -->
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Od" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <DatePicker x:Name="StartDatePicker" FontSize="14"
                            SelectedDateChanged="DatePicker_Changed"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Do" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <DatePicker x:Name="EndDatePicker" FontSize="14"
                            SelectedDateChanged="DatePicker_Changed"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="ValidationText"
                   Text="Datumi ne mogu biti u prošlosti."
                   FontSize="13" Foreground="#C0392B" Margin="0,4,0,0"
                   Visibility="Collapsed"/>

        <!-- Dugmad -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Otkaži" Style="{StaticResource SecondaryBtnStyle}"
                    Padding="18,9" FontSize="14" Margin="0,0,12,0"
                    Click="Cancel_Click"/>
            <Button x:Name="SubmitBtn" Content="Pošalji zahtev"
                    Style="{StaticResource PrimaryBtnStyle}"
                    Padding="18,9" FontSize="14"
                    Click="Submit_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
