<Window x:Class="CommunityHub.Ui.Views.Tenant.HelpBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="CommunityHub – Oglasna tabla" Height="768" Width="1024"
        WindowStartupLocation="CenterScreen"
        MinHeight="600" MinWidth="800">

    <Window.Resources>
        <Style x:Key="SideNavStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#243342"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel>
                            <ContentPresenter/>
                            <Border x:Name="Underline" Height="2" Background="#2C3E50" Opacity="0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="Underline" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3D5166"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stil za karticu oglasa -->
        <Style x:Key="AdCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.07" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#2C3E50">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#1A252F" Padding="20,0">
                    <TextBlock Text="Community Hub" Foreground="White"
                               FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <Button Style="{StaticResource SideNavStyle}" Click="NavHome_Click">
                        <StackPanel Orientation="Horizontal" Margin="20,12">
                            <fa:IconBlock Icon="House" FontSize="18" Foreground="#B0BEC5" VerticalAlignment="Center" Width="20"/>
                            <TextBlock Text="Home" Foreground="#B0BEC5" FontSize="15" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SideNavStyle}" Click="NavBuildings_Click">
                        <StackPanel Orientation="Horizontal" Margin="20,12">
                            <fa:IconBlock Icon="Building" FontSize="18" Foreground="#B0BEC5" VerticalAlignment="Center" Width="20"/>
                            <TextBlock Text="Zgrade" Foreground="#B0BEC5" FontSize="15" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <!-- Oglasna tabla (aktivan) -->
                    <Border Background="#243342">
                        <Grid>
                            <Border Width="4" HorizontalAlignment="Left" Background="White"/>
                            <StackPanel Orientation="Horizontal" Margin="20,12">
                                <fa:IconBlock Icon="CircleInfo" FontSize="18" Foreground="White" VerticalAlignment="Center" Width="20"/>
                                <TextBlock Text="Oglasna tabla" Foreground="White" FontSize="15" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border BorderBrush="#3D5166" BorderThickness="0,1,0,0" Margin="16,8"/>
                    <StackPanel Orientation="Horizontal" Margin="20,12" Opacity="0.35">
                        <fa:IconBlock Icon="CalendarCheck" FontSize="18" Foreground="#B0BEC5" VerticalAlignment="Center" Width="20"/>
                        <TextBlock Text="Zakazivanje" Foreground="#B0BEC5" FontSize="15" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="20,12" Opacity="0.35">
                        <fa:IconBlock Icon="DoorOpen" FontSize="18" Foreground="#B0BEC5" VerticalAlignment="Center" Width="20"/>
                        <TextBlock Text="Zajedničke sobe" Foreground="#B0BEC5" FontSize="15" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="20,12" Opacity="0.35">
                        <fa:IconBlock Icon="CircleExclamation" FontSize="18" Foreground="#B0BEC5" VerticalAlignment="Center" Width="20"/>
                        <TextBlock Text="Problemi" Foreground="#B0BEC5" FontSize="15" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="20,12" Opacity="0.35">
                        <fa:IconBlock Icon="PeopleGroup" FontSize="18" Foreground="#B0BEC5" VerticalAlignment="Center" Width="20"/>
                        <TextBlock Text="Skupštine" Foreground="#B0BEC5" FontSize="15" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="20,12" Opacity="0.35">
                        <fa:IconBlock Icon="FileLines" FontSize="18" Foreground="#B0BEC5" VerticalAlignment="Center" Width="20"/>
                        <TextBlock Text="Izveštaji" Foreground="#B0BEC5" FontSize="15" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Desni sadržaj -->
        <Grid Grid.Column="1" Background="#F5F5F5">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Gornji bar -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <TextBlock Text="Oglasna tabla" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource CircleButtonStyle}" Width="36" Height="36" ToolTip="Obaveštenja">
                            <fa:IconBlock Icon="Bell" FontSize="16" Foreground="#555555"/>
                        </Button>
                        <Border Width="36" Height="36" CornerRadius="18" Background="#2C3E50"
                                Margin="10,0,0,0" Cursor="Hand" ToolTip="Profil"
                                MouseLeftButtonUp="Avatar_Click">
                            <TextBlock x:Name="UserInitialsBlock" Text="??"
                                       Foreground="White" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Toolbar: zgrada + kreiraj -->
            <Border Grid.Row="1" Background="White" Padding="24,12"
                    BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Tab header -->
                        <Button x:Name="TabBoardBtn" Tag="active" Style="{StaticResource TabBtnStyle}"
                                Click="TabBoard_Click" Margin="0,0,28,0" Padding="0,0,0,4">
                            <TextBlock x:Name="TabBoardText" Text="Oglasi na tabli"
                                       FontSize="16" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                        </Button>
                        <Button x:Name="TabMyPostsBtn" Style="{StaticResource TabBtnStyle}"
                                Click="TabMyPosts_Click" Padding="0,0,0,4">
                            <TextBlock x:Name="TabMyPostsText" Text="Moji oglasi"
                                       FontSize="15" Foreground="#888888"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Zgrada:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="14"/>
                        <ComboBox x:Name="BuildingCombo"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="BuildingCombo_SelectionChanged"
                                  MinWidth="220" Padding="8,5" FontSize="14"
                                  VerticalAlignment="Center"/>
                        <Button Style="{StaticResource PrimaryBtnStyle}"
                                Padding="14,7" Margin="16,0,0,0" Click="CreateAdButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconBlock Icon="Plus" FontSize="14" Foreground="White"
                                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Kreiraj oglas" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== TAB: Oglasi na tabli ===== -->
            <ScrollViewer Grid.Row="2" x:Name="BoardPanel" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,16,24,24">

                    <!-- Oglasi po kategoriji -->
                    <Border Background="White" CornerRadius="10" Padding="18,14" Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.07" Color="#000000"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Oglasi po kategoriji" FontSize="14" FontWeight="SemiBold"
                                           Margin="0,0,0,10"/>
                                <Canvas x:Name="PieChartCanvas" Width="120" Height="120"/>
                            </StackPanel>
                            <ItemsControl Grid.Column="1" x:Name="CategoryLegend"
                                          Margin="20,28,0,0" VerticalAlignment="Top">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Width="12" Height="12" CornerRadius="2"
                                                    Background="{Binding Color}" Margin="0,1,8,0"
                                                    VerticalAlignment="Top"/>
                                            <TextBlock Text="{Binding Category}" FontSize="13"
                                                       Foreground="#555555" Width="110"/>
                                            <TextBlock Text="{Binding Count}" FontSize="13"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- Aktivni oglasi -->
                    <TextBlock Text="Aktivni oglasi" FontSize="16" FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <TextBlock x:Name="NoBoardAdsText"
                               Text="Nema aktivnih oglasa za ovu zgradu."
                               Foreground="#AAAAAA" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,20,0,0"
                               Visibility="Collapsed"/>

                    <ItemsControl x:Name="BoardAdsPanel">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AdCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar inicijali -->
                                        <Border Grid.Column="0" Width="36" Height="36"
                                                CornerRadius="18" Background="#ECF0F1"
                                                VerticalAlignment="Top" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding TenantName, Converter={StaticResource NameToInitials}}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#555555"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Sadržaj -->
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBlock Text="{Binding TenantName}"
                                                           FontSize="16" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="YouBadge" Text=" [VI]"
                                                           FontSize="14" Foreground="#888888"
                                                           Visibility="{Binding IsOwn,
                                                               Converter={StaticResource BoolToVisibility}}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding TypeDisplay}"
                                                       FontSize="13" Foreground="#888888" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal">
                                                <fa:IconBlock Icon="CalendarDays" FontSize="13"
                                                              Foreground="#AAAAAA" Margin="0,0,5,0"
                                                              VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DateRangeDisplay}"
                                                           FontSize="13" Foreground="#666666"
                                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                <fa:IconBlock Icon="Tag" FontSize="13"
                                                              Foreground="#AAAAAA" Margin="0,0,5,0"
                                                              VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Category}"
                                                           FontSize="13" Foreground="#666666"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Akcija -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button Content="Arhiviraj"
                                                    Tag="{Binding Id}"
                                                    Click="ArchiveButton_Click"
                                                    Padding="12,6" FontSize="13" Cursor="Hand"
                                                    Visibility="{Binding IsOwn,
                                                        Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>

            <!-- ===== TAB: Moji oglasi ===== -->
            <ScrollViewer Grid.Row="2" x:Name="MyPostsPanel" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,16,24,24">

                    <TextBlock Text="Moji aktivni oglasi" FontSize="16" FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <TextBlock x:Name="NoMyAdsText"
                               Text="Nemate aktivnih oglasa."
                               Foreground="#AAAAAA" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,20,0,0"
                               Visibility="Collapsed"/>

                    <ItemsControl x:Name="MyAdsPanel">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AdCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header: tip + dugme -->
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding TypeDisplay}"
                                                       FontSize="16" FontWeight="SemiBold"/>
                                            <Button Content="Arhiviraj"
                                                    Tag="{Binding Id}"
                                                    Click="ArchiveButton_Click"
                                                    HorizontalAlignment="Right"
                                                    Padding="12,5" FontSize="13" Cursor="Hand"/>
                                        </Grid>

                                        <!-- Opis -->
                                        <TextBlock Grid.Row="1" Text="{Binding Description}"
                                                   FontSize="14" Foreground="#444444"
                                                   TextWrapping="Wrap" Margin="0,0,0,8"/>

                                        <!-- Meta: datum, kategorija, status -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                            <fa:IconBlock Icon="CalendarDays" FontSize="13"
                                                          Foreground="#AAAAAA" Margin="0,0,5,0"
                                                          VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DateRangeDisplay}"
                                                       FontSize="13" Foreground="#666666"
                                                       VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            <fa:IconBlock Icon="Tag" FontSize="13"
                                                          Foreground="#AAAAAA" Margin="0,0,5,0"
                                                          VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Category}"
                                                       FontSize="13" Foreground="#666666"
                                                       VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            <Border Background="#D4EDDA" CornerRadius="8" Padding="8,3">
                                                <StackPanel Orientation="Horizontal">
                                                    <fa:IconBlock Icon="CircleCheck" FontSize="12"
                                                                  Foreground="#155724" Margin="0,0,4,0"
                                                                  VerticalAlignment="Center"/>
                                                    <TextBlock Text="Aktivan" FontSize="12"
                                                               Foreground="#155724" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</Window>
