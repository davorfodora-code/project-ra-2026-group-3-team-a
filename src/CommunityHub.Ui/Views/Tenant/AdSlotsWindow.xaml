<Window x:Class="CommunityHub.Ui.Views.Tenant.AdSlotsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="Slobodni termini" Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="24,20,24,24">

        <TextBlock Text="Slobodni termini" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock x:Name="ContextText" FontSize="14" Foreground="#666666" Margin="0,0,0,16"
                   TextWrapping="Wrap"/>

        <!-- Kartica oglasa -->
        <Border Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,16"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="OwnerNameText" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="TypeText" FontSize="14" Foreground="#888888" Margin="0,2,0,4"/>
                <TextBlock x:Name="DescriptionText" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock Icon="CalendarDays" FontSize="14" Foreground="#555555"
                                  Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DateRangeText" FontSize="14" Foreground="#555555" Margin="0,0,16,0"/>
                    <fa:IconBlock Icon="Tag" FontSize="14" Foreground="#555555"
                                  Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CategoryText" FontSize="14" Foreground="#555555"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="Izaberite termine:" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <TextBlock x:Name="NoSlotsText" Text="Nema slobodnih termina za presek datuma oba oglasa."
                   FontSize="15" Foreground="#AAAAAA" Visibility="Collapsed" Margin="0,0,0,10"
                   TextWrapping="Wrap"/>
        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SlotsPanel">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding DisplayText}" Tag="{Binding Id}"
                                  Checked="Slot_Checked" Unchecked="Slot_Unchecked"
                                  FontSize="16" Margin="0,5"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="BookButton" Content="Rezerviši odabrane"
                    Click="Book_Click" IsEnabled="False"
                    Padding="16,8" Margin="0,0,10,0" FontSize="14" FontWeight="SemiBold"
                    Background="#2C3E50" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Zatvori" Click="Close_Click" Padding="16,8" FontSize="14" Cursor="Hand"/>
        </StackPanel>

    </StackPanel>
</Window>
