<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ═══════════════════════════════════════════════════════════════
         TextBox
    ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="DC.Input" TargetType="TextBox">
        <Setter Property="Height"                   Value="36"/>
        <Setter Property="FontSize"                 Value="13"/>
        <Setter Property="FontFamily"               Value="Segoe UI"/>
        <Setter Property="Padding"                  Value="10,0"/>
        <Setter Property="BorderBrush"              Value="{StaticResource DC.Border.Strong}"/>
        <Setter Property="BorderThickness"          Value="1"/>
        <Setter Property="Background"               Value="{StaticResource DC.Bg.Card}"/>
        <Setter Property="Foreground"               Value="{StaticResource DC.Text.Primary}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle"         Value="{x:Null}"/>
        <Setter Property="CaretBrush"               Value="{StaticResource DC.Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DC.Border.Strong}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DC.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DC.Input.Multiline" TargetType="TextBox"
           BasedOn="{StaticResource DC.Input}">
        <Setter Property="Height"                       Value="Auto"/>
        <Setter Property="TextWrapping"                 Value="Wrap"/>
        <Setter Property="AcceptsReturn"                Value="True"/>
        <Setter Property="VerticalScrollBarVisibility"  Value="Auto"/>
        <Setter Property="VerticalContentAlignment"     Value="Top"/>
        <Setter Property="Padding"                      Value="10,8"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         ComboBox  (standard height 36)
         NOTE: ItemContainerStyle is intentionally NOT set here.
         Dropdown items are styled via an implicit Style scoped inside
         the Popup Border.Resources so WPF's DisplayMemberPath mechanism
         (which reads cc.ContentTemplate from containers) is not broken.
    ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="DC.ComboBox" TargetType="ComboBox">
        <Setter Property="Height"                   Value="36"/>
        <Setter Property="FontSize"                 Value="13"/>
        <Setter Property="FontFamily"               Value="Segoe UI"/>
        <Setter Property="Padding"                  Value="10,0,32,0"/>
        <Setter Property="BorderBrush"              Value="{StaticResource DC.Border}"/>
        <Setter Property="BorderThickness"          Value="1"/>
        <Setter Property="Background"               Value="{StaticResource DC.Bg.Card}"/>
        <Setter Property="Foreground"               Value="{StaticResource DC.Text.Primary}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle"         Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">

                        <!-- Visual border -->
                        <Border x:Name="MainBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"/>

                        <!-- Transparent toggle button covers whole area -->
                        <ToggleButton Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Selected item text — WPF sets SelectionBoxItemTemplate from
                             the container's ContentTemplate (populated via DisplayMemberPath) -->
                        <ContentPresenter x:Name="ContentSite"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          IsHitTestVisible="False"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="Left"/>

                        <!-- Chevron arrow -->
                        <Path x:Name="Arrow"
                              Data="M 0 0 L 5 5 L 10 0"
                              Stroke="{StaticResource DC.Text.Caption}"
                              StrokeThickness="1.5"
                              StrokeLineJoin="Round"
                              Width="10" Height="6"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              IsHitTestVisible="False"/>

                        <!-- Dropdown popup -->
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="Fade">
                            <Border Background="{StaticResource DC.Bg.Card}"
                                    BorderBrush="{StaticResource DC.Accent}"
                                    BorderThickness="1"
                                    CornerRadius="0,0,6,6"
                                    Padding="4"
                                    MinWidth="{Binding ActualWidth,
                                                       RelativeSource={RelativeSource TemplatedParent}}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="3"
                                                      Opacity="0.1" Direction="270"/>
                                </Border.Effect>
                                <!-- Implicit ComboBoxItem style scoped here so it does NOT
                                     interfere with WPF's DisplayMemberPath / container lookup -->
                                <Border.Resources>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="FontFamily"               Value="Segoe UI"/>
                                        <Setter Property="FontSize"                 Value="13"/>
                                        <Setter Property="Foreground"               Value="{StaticResource DC.Text.Primary}"/>
                                        <Setter Property="Background"               Value="Transparent"/>
                                        <Setter Property="Padding"                  Value="10,7"/>
                                        <Setter Property="FocusVisualStyle"         Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ComboBoxItem">
                                                    <Border x:Name="ItemBorder"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="4"
                                                            Padding="{TemplateBinding Padding}"
                                                            Margin="0,1">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background"
                                                                    Value="{StaticResource DC.Accent.Light}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background"
                                                                    Value="{StaticResource DC.Accent.Light}"/>
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource DC.Accent}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Border.Resources>
                                <ScrollViewer MaxHeight="220"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush"
                                    Value="{StaticResource DC.Border.Strong}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush"
                                    Value="{StaticResource DC.Accent}"/>
                            <Setter TargetName="MainBorder" Property="CornerRadius"
                                    Value="6,6,0,0"/>
                            <Setter TargetName="Arrow" Property="Data"
                                    Value="M 0 5 L 5 0 L 10 5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         ComboBox.Sm  (compact height 28 — for sort dropdowns)
    ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="DC.ComboBox.Sm" TargetType="ComboBox"
           BasedOn="{StaticResource DC.ComboBox}">
        <Setter Property="Height"   Value="28"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding"  Value="8,0,28,0"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         DatePicker
    ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="DC.DatePicker" TargetType="DatePicker">
        <Setter Property="Height"                   Value="36"/>
        <Setter Property="FontSize"                 Value="13"/>
        <Setter Property="FontFamily"               Value="Segoe UI"/>
        <Setter Property="Foreground"               Value="{StaticResource DC.Text.Primary}"/>
        <Setter Property="Background"               Value="{StaticResource DC.Bg.Card}"/>
        <Setter Property="BorderBrush"              Value="{StaticResource DC.Border.Strong}"/>
        <Setter Property="BorderThickness"          Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle"         Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Height="{TemplateBinding Height}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>

                            <DatePickerTextBox x:Name="PART_TextBox"
                                               Grid.Column="0"
                                               Foreground="{TemplateBinding Foreground}"
                                               Background="Transparent"
                                               BorderThickness="0"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               Padding="8,0"
                                               VerticalAlignment="Center"
                                               VerticalContentAlignment="Center"
                                               FocusVisualStyle="{x:Null}"/>

                            <Button x:Name="PART_Button"
                                    Grid.Column="1"
                                    Focusable="False"
                                    Width="26" Height="26"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BtnBg"
                                                Background="Transparent"
                                                CornerRadius="4"
                                                Width="26" Height="26">
                                            <Path Data="M 1 3 L 1 9 M 7 3 L 7 9 M 0 5 L 8 5 M 0 7 L 8 7 M 3 1 L 3 3 M 5 1 L 5 3"
                                                  Stroke="{StaticResource DC.Text.Caption}"
                                                  StrokeThickness="1.3"
                                                  Width="10" Height="10"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBg" Property="Background"
                                                        Value="{StaticResource DC.Bg.Subtle}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   StaysOpen="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Root" Property="BorderBrush"
                                    Value="{StaticResource DC.Border.Strong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="PART_Root" Property="BorderBrush"
                                    Value="{StaticResource DC.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Root" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
