<Application x:Class="CommunityHub.Ui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CommunityHub.Ui.Converters"
             StartupUri="/Views/LogInForm.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DistrictCoordinatorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:ImagePathToSourceConverter x:Key="ImagePathConverter"/>
            <conv:NameToInitialsConverter x:Key="NameToInitials"/>
            <conv:NullToVisibilityConverter x:Key="NullToCollapsed"/>
            <conv:ActiveFilterToBackgroundConverter x:Key="ActiveFilterBg"/>
            <conv:ActiveFilterToForegroundConverter x:Key="ActiveFilterFg"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
